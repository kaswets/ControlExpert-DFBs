	<DDTSource DDTName="SensorConfig" version="0.01" dateTime="dt#2015-09-25-16:15:06">
		<comment>Hardware configuration of a sensor</comment>
		<attribute name="TypeSignatureCheckSumString" value="EED8"></attribute>
		<attribute name="TypeDataDicSubfieldsCount" value="5"></attribute>
		<structure>
			<variables name="ShowActualInput" typeName="BOOL">
				<comment>When set to "true" the sensor value is NOT limited to the outputhigh and outputloawvalues</comment>
			</variables>
			<variables name="OverflowPercentage" typeName="REAL">
				<comment>When the actual sensorvalue is over this value the sensor will generate a overflow warning</comment>
			</variables>
			<variables name="UnderflowPercentage" typeName="REAL">
				<comment>When the actual sensorvalue is under this value the sensor will generate a underflow warning</comment>
			</variables>
			<variables name="WirebreakPercentage" typeName="REAL">
				<comment>When the actual sensorvalue is under this value the sensor will generate a wirebreak alarm</comment>
			</variables>
		</structure>
	</DDTSource>
