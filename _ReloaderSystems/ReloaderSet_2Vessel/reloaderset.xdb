					<typeLine>
						<contact typeContact="openContact" contactVariableName="FollowingError"></contact>
						<HLink nbCells="2"></HLink>
						<contact typeContact="openContact" contactVariableName="General.PlcInRun"></contact>
						<HLink nbCells="6"></HLink>
						<coil typeCoil="setCoil" coilVariableName="Outputs.Alarm"></coil>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="1"></emptyLine>
					</typeLine>
					<typeLine>
						<HLink nbCells="7"></HLink>
						<operateBlock width="4">
							<statement>InOut.Status:=0;</statement>
						</operateBlock>
					</typeLine>
					<typeLine>
						<HLink nbCells="2"></HLink>
						<contact typeContact="openContact" contactVariableName="(InOut.Position.value/10) &gt; 0"></contact>
						<HLink nbCells="4"></HLink>
						<operateBlock width="4">
							<statement>InOut.Status:=1;</statement>
						</operateBlock>
					</typeLine>
					<typeLine>
						<HLink nbCells="2"></HLink>
						<contact typeContact="openContact" contactVariableName="Outputs.Alarm"></contact>
						<HLink nbCells="4"></HLink>
						<operateBlock width="4">
							<statement>InOut.Status:=3;</statement>
						</operateBlock>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="1"></emptyLine>
					</typeLine>
					<typeLine>
						<HLink nbCells="1"></HLink>
						<contact typeContact="openContact" contactVariableName="InOut.SP_High&lt;9500"></contact>
						<shortCircuit>
							<VLink></VLink>
							<HLink nbCells="1"></HLink>
						</shortCircuit>
						<HLink nbCells="4"></HLink>
						<operateBlock width="4">
							<statement>InOut.Status:=4;</statement>
						</operateBlock>
					</typeLine>
					<typeLine>
						<HLink nbCells="1"></HLink>
						<contact typeContact="openContact" contactVariableName="InOut.SP_Low&gt;500"></contact>
						<HLink nbCells="1"></HLink>
						<emptyCell nbCells="8"></emptyCell>
					</typeLine>
					<typeLine>
						<HLink nbCells="7"></HLink>
						<operateBlock width="4">
							<statement>InOut.Feedback:=Inputs.rawFeedback;</statement>
						</operateBlock>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="1"></emptyLine>
					</typeLine>
					<textBox width="11" height="1">Open the valve when the setpoint is greater than the feedback and not within the deadband window
    <objPosition posX="0" posY="94"></objPosition>
					</textBox>
					<textBox width="11" height="1">Status
    <objPosition posX="0" posY="127"></objPosition>
					</textBox>
					<textBox width="11" height="1">Reset alarm
    <objPosition posX="0" posY="0"></objPosition>
					</textBox>
					<textBox width="11" height="1">Ouputs
    <objPosition posX="0" posY="111"></objPosition>
					</textBox>
					<textBox width="11" height="1">Determine setpoint based on manual control, FullyOpen or Compressor pressure
    <objPosition posX="0" posY="70"></objPosition>
					</textBox>
					<textBox width="11" height="1">Convert Int values to Real values
    <objPosition posX="0" posY="3"></objPosition>
					</textBox>
					<textBox width="11" height="1">Convert Int values to Real values
    <objPosition posX="0" posY="45"></objPosition>
					</textBox>
					<textBox width="11" height="1">Scale feedback to a position between 0 and 100% based on calibration values
    <objPosition posX="0" posY="8"></objPosition>
					</textBox>
					<textBox width="11" height="1">Write a value of 5000 into the stored variable highest value when the calibration is initiated. value of 5000 is the middle of the range 0..10000 and therefore should be under the highest point
    <objPosition posX="0" posY="29"></objPosition>
					</textBox>
					<textBox width="11" height="1">Convert the compressor pressure to 0..100% based on Start and stop pressure. Start pressure equals 0% and stop pressure equals 100%
    <objPosition posX="0" posY="59"></objPosition>
					</textBox>
					<textBox width="11" height="1">Air pulse is used to send a pulse to the valve open or close signal to open the valve in a controlled manner
    <objPosition posX="0" posY="18"></objPosition>
					</textBox>
					<textBox width="11" height="1">Add a deadband to prevent from switching between open and close when the exact feedback signal can not be reached
    <objPosition posX="0" posY="88"></objPosition>
					</textBox>
					<textBox width="11" height="1">Alarm
Following alarm will be set when the difference between position and setpoint is greater than 5 for 30seconds
    <objPosition posX="0" posY="119"></objPosition>
					</textBox>
					<textBox width="11" height="1">Write a value of 5000 into the stored variable lowest value when the calibration is initiated. value of 5000 is the middle of the range 0..10000 and therefore should be above the lowest point
    <objPosition posX="0" posY="32"></objPosition>
					</textBox>
					<textBox width="11" height="1">Convert the Feedback signal 0..10000 based on Lowest and Highest calibration value. Lowest value equals 0% and Highest value equals 100%
    <objPosition posX="0" posY="78"></objPosition>
					</textBox>
					<textBox width="11" height="1">Calculate when the feedback falls within the deadband window
    <objPosition posX="0" posY="91"></objPosition>
					</textBox>
					<textBox width="11" height="1">Close the valve when the setpoint is smaller than the feedback and not within the deadband window
    <objPosition posX="0" posY="103"></objPosition>
					</textBox>
					<textBox width="11" height="1">Calculate range in FB signal from the calibration values. This range is used to calculate the actual position in percentage.
Calculate range in millibars from settings. This range is used to calculate setpoint position for the purge valve
    <objPosition posX="0" posY="40"></objPosition>
					</textBox>
				</networkLD>
			</LDSource>
		</FBProgram>
		<FBProgram name="AutoCalibrate">
			<STSource>
tmpCalibrate:=General.AutoCalibrate;



if fe(tmpCalibrate) then 
	InOut.Open:=False;
	InOut.Close:=False;
	InOut.Change:=False;
	Outputs.AutoCalibrationBusy:=False;
end_if;


if re(tmpCalibrate) then (* if they push auto Calibrate *)

	Outputs.AutoCalibrationBusy:=True;

	OneSideOkay:=False;
	SecondSideOkay:=False;

	InOut.Change:=true; (* activate Change button*)

	if InOut.Feedback&lt;5000 then (* choose a side *)
		InOut.Open:=true;
	else
		InOut.Close:=true;
	end_if;
End_if;

if General.AutoCalibrate then
	if re(NotMovingAnyMore) then (* found 1 side*)

	if OneSideOkay then
		SecondSideOkay:=true;
	end_if;

	OneSideOkay:=true;

		if InOut.Open then (* choose other side *)
		  	InOut.Open:=false;
		  	InOut.Close:=true;
		else
		  	InOut.Open:=True;
		  	InOut.Close:=False;
		end_If;
	end_if;

	(* Ready???*)
	if OneSideOkay and SecondSideOkay then (* deactived all *)
		InOut.Open:=False;
		InOut.Close:=False;
		InOut.Change:=False;
		Outputs.AutoCalibrationBusy:=False;
	end_if;
end_if;
TON_NotMoving (IN := (InOut.Open and oldHigh=InOut.SP_High and InOut.Feedback&gt;8000 )or (InOut.Close and oldLow=InOut.SP_Low and InOut.Feedback&lt;2000),
               PT := t#2000ms,
               Q =&gt; NotMovingAnyMore);


oldHigh:=InOut.SP_High;
oldLow:=InOut.SP_Low;
</STSource>
		</FBProgram>
	</FBSource>
</FBExchangeFile>
