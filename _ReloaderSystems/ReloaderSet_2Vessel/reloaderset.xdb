		<FBProgram name="Transitions">
			<LDSource nbColumns="20">
				<networkLD>
					<typeLine>
						<emptyLine nbRows="1"></emptyLine>
					</typeLine>
					<typeLine>
						<HLink nbCells="1"></HLink>
						<contact typeContact="PContact" contactVariableName="Set.Stop"></contact>
						<shortCircuit>
							<VLink></VLink>
							<HLink nbCells="13"></HLink>
						</shortCircuit>
						<HLink nbCells="2"></HLink>
						<coil typeCoil="resetCoil" coilVariableName="A_BusyWithDischarge"></coil>
