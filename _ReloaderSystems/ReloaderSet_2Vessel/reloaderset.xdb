						<emptyLine nbRows="3"></emptyLine>
					</typeLine>
					<textBox width="11" height="1">Copied from klepfout_NC_2es
    <objPosition posX="0" posY="56"></objPosition>
					</textBox>
					<textBox width="11" height="1">Status valve is closed
    <objPosition posX="0" posY="84"></objPosition>
					</textBox>
					<textBox width="11" height="1">Manual bit -&gt; show touch switch on hmi screen
    <objPosition posX="0" posY="95"></objPosition>
					</textBox>
					<textBox width="1" height="1">Geel<objPosition posX="18" posY="72"></objPosition>
					</textBox>
					<textBox width="1" height="1">Grijs<objPosition posX="16" posY="84"></objPosition>
					</textBox>
					<textBox width="11" height="1">Alarm
    <objPosition posX="0" posY="92"></objPosition>
					</textBox>
					<textBox width="11" height="1">Status valve is open
    <objPosition posX="0" posY="88"></objPosition>
					</textBox>
					<textBox width="1" height="1">Rood<objPosition posX="16" posY="92"></objPosition>
					</textBox>
					<textBox width="11" height="1">Status valve is in alarm
    <objPosition posX="0" posY="9"></objPosition>
					</textBox>
					<textBox width="11" height="1">Status valve is moving
    <objPosition posX="0" posY="70"></objPosition>
					</textBox>
					<textBox width="11" height="1">Valve output
    <objPosition posX="0" posY="32"></objPosition>
					</textBox>
					<textBox width="6" height="2">InOut.HmiControl.4  = touch button manual open/closed in het hmi scherm.

in het scherm word het bitje geset, hier , nadat dat gezien is, word het bitje weer gereset<objPosition posX="0" posY="0"></objPosition>
					</textBox>
					<textBox width="11" height="1">Set buzzer on active alarm
    <objPosition posX="0" posY="67"></objPosition>
					</textBox>
					<textBox width="11" height="1">Reset manual control when not in manual mode
    <objPosition posX="0" posY="49"></objPosition>
					</textBox>
					<textBox width="11" height="1">Check if valve was open in auto when switching to manual<objPosition posX="0" posY="17"></objPosition>
					</textBox>
					<textBox width="11" height="1">Swap feedback when normally open is activated
    <objPosition posX="0" posY="13"></objPosition>
					</textBox>
					<textBox width="1" height="1">Groen<objPosition posX="16" posY="88"></objPosition>
					</textBox>
				</networkLD>
			</LDSource>
		</FBProgram>
		<FBProgram name="angle">
			<STSource>(* Als input Angle is aangesloten, word de waardie daar staat op de goede plek in het statuswoord gezet *)

if IS_PAR_CON (INP := Angle) then
		ShiftAngle_0 (angle := ANGLE,
		              Status := InOut.HMIControl);
end_if;
</STSource>
		</FBProgram>
	</FBSource>
	<DDTSource DDTName="DValve_Param" version="0.09" dateTime="dt#2024-05-03-08:47:56">
		<comment>Parameters which can be used to change a valve's behaviour while still using the same FB</comment>
		<attribute name="TypeSignatureCheckSumString" value="D9E7"></attribute>
		<attribute name="TypeDataDicSubfieldsCount" value="8"></attribute>
		<structure>
			<variables name="NormallyOpen" typeName="BOOL">
				<comment>0=Normally Closed, 1=Normally Open</comment>
			</variables>
			<variables name="Delayed_ReturnOutput" typeName="TIME">
				<comment>Delay the signal when the output is removed (only output)</comment>
			</variables>
			<variables name="Delayed_Return" typeName="TIME">
				<comment>Delay the signal when the output is removed (output and status)</comment>
			</variables>
			<variables name="Clino_Enable" typeName="BOOL">
				<comment>Enable the clino function for valves</comment>
			</variables>
			<variables name="Clino_Signal" typeName="BOOL">
				<comment>Close the valve when Clino signal comes</comment>
			</variables>
			<variables name="MonitorTime" typeName="TIME">
				<comment>Time the valve is moving from open to closed/closed to open</comment>
			</variables>
			<variables name="2Outputs" typeName="BOOL"></variables>
		</structure>
	</DDTSource>
	<FBSource nameOfFBType="RotateValve" version="0.07" dateTime="dt#2021-08-18-14:19:29">
