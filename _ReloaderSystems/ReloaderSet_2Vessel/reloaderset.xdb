						<HLink nbCells="3"></HLink>
						<emptyCell nbCells="4"></emptyCell>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="2"></emptyLine>
					</typeLine>
					<typeLine>
						<contact typeContact="closedContact" contactVariableName="general.SimulationOn"></contact>
						<HLink nbCells="6"></HLink>
						<operateBlock width="4">
							<statement>MonitorTime:=t#60s;</statement>
						</operateBlock>
					</typeLine>
					<typeLine>
						<contact typeContact="openContact" contactVariableName="general.SimulationOn"></contact>
						<HLink nbCells="6"></HLink>
						<operateBlock width="4">
							<statement>MonitorTime:=t#40s;</statement>
						</operateBlock>
					</typeLine>
					<typeLine>
						<emptyCell nbCells="7"></emptyCell>
						<FFBBlock instanceName="TON_Alarm" typeName="TON" additionnalPinNumber="0" enEnO="false" width="10" height="4">
							<objPosition posX="7" posY="122"></objPosition>
							<descriptionFFB execAfter="">
								<inputVariable invertedPin="false" formalParameter="EN"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="IN"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="PT" effectiveParameter="MonitorTime"></inputVariable>
								<outputVariable invertedPin="false" formalParameter="ENO"></outputVariable>
								<outputVariable invertedPin="false" formalParameter="Q"></outputVariable>
								<outputVariable invertedPin="false" formalParameter="ET"></outputVariable>
							</descriptionFFB>
