	<FBSource nameOfFBType="Int_To_Time2" version="1.00" dateTime="dt#2019-08-27-08:23:47">
		<comment>Converts an integer to timeformat with the adation that you can select the format of the Time</comment>
		<attribute name="TypePassword" value=""></attribute>
		<attribute name="TypeProtectionLevel" value="2#0000_0000"></attribute>
		<attribute name="TypeCodeCheckSumString" value="3BB3"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="EA43"></attribute>
		<attribute name="TypeDataDicSubfieldsCount" value="4"></attribute>
		<inputParameters>
			<variables name="In" typeName="INT">
				<comment>Integer value</comment>
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
			<variables name="Select" typeName="INT">
				<comment>Select time format (0=ms, 1=sec, 2=min, 3=hours, 4=days)</comment>
				<attribute name="PositionPin" value="2"></attribute>
			</variables>
		</inputParameters>
		<outputParameters>
			<variables name="Out" typeName="TIME">
				<comment>Converted time</comment>
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
		</outputParameters>
		<privateLocalVariables>
			<variables name="TempIn" typeName="REAL">
				<comment>Temperary variable for calculating</comment>
			</variables>
		</privateLocalVariables>
		<FBProgram name="Main">
			<comment>Convert integer to time</comment>
			<LDSource nbColumns="11">
				<networkLD>
					<typeLine>
						<emptyLine nbRows="1"></emptyLine>
					</typeLine>
					<typeLine>
						<HLink nbCells="7"></HLink>
						<operateBlock width="4">
							<statement>TempIn:=INT_TO_REAL(In);</statement>
						</operateBlock>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="1"></emptyLine>
					</typeLine>
					<typeLine>
						<compareBlock width="2">
							<expression>Select&gt;0</expression>
						</compareBlock>
						<HLink nbCells="5"></HLink>
						<operateBlock width="4">
							<statement>TempIn:=TempIn*1000.0;</statement>
						</operateBlock>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="1"></emptyLine>
					</typeLine>
					<typeLine>
						<compareBlock width="2">
							<expression>Select&gt;1</expression>
						</compareBlock>
						<HLink nbCells="5"></HLink>
						<operateBlock width="4">
							<statement>TempIn:=TempIn*60.0;</statement>
						</operateBlock>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="1"></emptyLine>
					</typeLine>
					<typeLine>
						<compareBlock width="2">
							<expression>Select&gt;2</expression>
						</compareBlock>
						<HLink nbCells="5"></HLink>
						<operateBlock width="4">
							<statement>TempIn:=TempIn*60.0;</statement>
						</operateBlock>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="1"></emptyLine>
					</typeLine>
					<typeLine>
						<compareBlock width="2">
							<expression>Select&gt;3</expression>
						</compareBlock>
						<HLink nbCells="5"></HLink>
						<operateBlock width="4">
							<statement>TempIn:=TempIn*24.0;</statement>
						</operateBlock>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="1"></emptyLine>
					</typeLine>
					<typeLine>
						<emptyCell nbCells="7"></emptyCell>
						<FFBBlock instanceName=".2" typeName="REAL_TO_TIME" additionnalPinNumber="0" enEnO="true" width="14" height="3">
							<objPosition posX="7" posY="11"></objPosition>
							<descriptionFFB execAfter="">
								<inputVariable invertedPin="false" formalParameter="EN"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="IN" effectiveParameter="TempIn"></inputVariable>
								<outputVariable invertedPin="false" formalParameter="ENO"></outputVariable>
								<outputVariable invertedPin="false" formalParameter="OUT" effectiveParameter="Out"></outputVariable>
							</descriptionFFB>
						</FFBBlock>
						<emptyCell nbCells="2"></emptyCell>
					</typeLine>
					<typeLine>
						<HLink nbCells="7"></HLink>
						<emptyCell nbCells="4"></emptyCell>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="87"></emptyLine>
					</typeLine>
					<textBox width="11" height="1">From hours to days
    <objPosition posX="0" posY="8"></objPosition>
					</textBox>
					<textBox width="11" height="1">Convert inputs to real for calculating
    <objPosition posX="0" posY="0"></objPosition>
					</textBox>
					<textBox width="11" height="1">From minutes to hours
    <objPosition posX="0" posY="6"></objPosition>
					</textBox>
					<textBox width="11" height="1">From seconds to minutes
    <objPosition posX="0" posY="4"></objPosition>
					</textBox>
					<textBox width="11" height="1">Convert realvalue time to timevalue
    <objPosition posX="0" posY="10"></objPosition>
					</textBox>
					<textBox width="11" height="1">From milliseconds to seconds
    <objPosition posX="0" posY="2"></objPosition>
					</textBox>
				</networkLD>
			</LDSource>
		</FBProgram>
	</FBSource>
	<FBSource nameOfFBType="Analog" version="1.48" dateTime="dt#2025-10-20-09:20:31">
		<comment>Analog input scaling (scale inputinteger to outputinteger by selecting the range of the input and the range of the output)</comment>
		<attribute name="TypePassword" value=""></attribute>
		<attribute name="TypeProtectionLevel" value="2#0000_0000"></attribute>
		<attribute name="TypeCodeCheckSumString" value="E8D6"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="8C90"></attribute>
		<attribute name="TypeDataDicSubfieldsCount" value="20"></attribute>
		<inputParameters>
			<variables name="Raw" typeName="INT">
				<comment>Raw value of the analog input</comment>
				<attribute name="PositionPin" value="2"></attribute>
			</variables>
			<variables name="InputHigh" typeName="REAL">
				<comment>High value of the input</comment>
				<attribute name="PositionPin" value="3"></attribute>
			</variables>
			<variables name="InputLow" typeName="REAL">
				<comment>Low value of the input</comment>
				<attribute name="PositionPin" value="4"></attribute>
			</variables>
			<variables name="OutputHigh" typeName="REAL">
				<comment>High value of the output</comment>
				<attribute name="PositionPin" value="5"></attribute>
			</variables>
			<variables name="OutputLow" typeName="REAL">
				<comment>Low value of the output</comment>
				<attribute name="PositionPin" value="6"></attribute>
			</variables>
			<variables name="Config" typeName="SensorConfig">
				<comment>Sensor configuration</comment>
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
		</inputParameters>
		<outputParameters>
			<variables name="ActualValue" typeName="INT">
				<comment>Actual value of the analog input</comment>
				<attribute name="PositionPin" value="2"></attribute>
			</variables>
			<variables name="Alarms" typeName="Analog_Alarms">
				<comment>Alarms and warning</comment>
				<attribute name="PositionPin" value="3"></attribute>
			</variables>
			<variables name="ConfigFail" typeName="BOOL">
				<comment>Configuration Error (the values of the inputHigh/low or output high/low is incorrect) value of high must be higher then low and not zero, value of low must be lower then high</comment>
				<attribute name="PositionPin" value="4"></attribute>
			</variables>
			<variables name="MilliAmps" typeName="INT">
				<comment>Value of the input in milliamps</comment>
				<attribute name="PositionPin" value="5"></attribute>
			</variables>
			<variables name="OutInfo" typeName="AnalogChanel">
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
		</outputParameters>
		<privateLocalVariables>
			<variables name="r_RAW" typeName="REAL">
				<comment>Converted value of the RAW input to real</comment>
			</variables>
			<variables name="WirebreakPercentage" typeName="REAL">
				<comment>5% of the Inputrange is </comment>
			</variables>
			<variables name="TON_Wirebreak" typeName="TON"></variables>
			<variables name="TON_Underflow" typeName="TON"></variables>
			<variables name="TON_Overflow" typeName="TON"></variables>
			<variables name="RealActualValue" typeName="REAL"></variables>
			<variables name="OverflowPercentage" typeName="REAL"></variables>
			<variables name="UnderflowPercentage" typeName="REAL"></variables>
			<variables name="tmpInputHigh" typeName="REAL"></variables>
			<variables name="tmpInputLow" typeName="REAL"></variables>
			<variables name="tmpOverflowPercentage" typeName="REAL"></variables>
			<variables name="tmpWirebreakPercentage" typeName="REAL"></variables>
			<variables name="tmpUnderflowPercentage" typeName="REAL"></variables>
			<variables name="ConfigConected" typeName="BOOL"></variables>
			<variables name="OneProcent" typeName="REAL"></variables>
			<variables name="WirebreakValue" typeName="REAL"></variables>
			<variables name="UnderFlowValue" typeName="REAL"></variables>
			<variables name="OverFlowValue" typeName="REAL"></variables>
			<variables name="tmpWireBreak" typeName="REAL"></variables>
			<variables name="tmpUnderFlow" typeName="REAL"></variables>
			<variables name="tmpOverFlow" typeName="REAL"></variables>
			<variables name="rMiliAmps" typeName="REAL"></variables>
		</privateLocalVariables>
		<FBProgram name="Main">
			<comment>Analog scaling</comment>
			<STSource>(* normal always use as input limits 0.0 to 10000.0 if they are not connected*)

if  not IS_PAR_CON (INP := InputHigh) then
	tmpInputHigh:=10000.0;
else
	tmpInputHigh:=InputHigh;
end_if;

if   Not IS_PAR_CON (INP := InputLow) then
	tmpInputLow:=0.0;
else
	tmpInputLow:=InputLow;
end_if;

(*Convert input to REAL for calculating*)

r_RAW		:=INT_TO_REAL(RAW);

(* Create configuration error when config is wrong *)
If tmpInputHigh &lt;= tmpInputLow OR OutputHigh &lt;= OutputLow THEN
	ConfigFail:=TRUE;
	ActualValue:=0;
ELSE
	ConfigFail:=FALSE;
	RealActualValue:=(((OutputHigh - OutputLow) / (tmpInputHigh - tmpInputLow)) * (r_Raw-tmpInputLow)) + OutputLow;
	
	if RealActualValue&gt;-32768.0 and  RealActualValue&lt;32767.0 then
		(*Copy Actual value to output*)
		ActualValue:=REAL_TO_INT(RealActualValue);
	else
		if RealActualValue&lt;-32768.0 then
			ActualValue:=-32768;
		end_if;
		if RealActualValue&gt;32767.0 then
			ActualValue:=32767;
		end_if;		
	end_if;

	(*Limit value to High and low output*)
	IF NOT Config.ShowActualInput THEN
		IF RealActualValue &gt; OutputHigh THEN
			ActualValue:=REAL_TO_INT(OutputHigh);
		END_IF;
		IF RealActualValue &lt; OutputLow THEN
			ActualValue:=REAL_TO_INT(OutputLow);
		END_IF;	
	END_IF;


	(* outputvalue in milliamps*)
	rMiliAmps:=(((20.0 - 4.0) / (tmpInputHigh - InputLow)) * (r_Raw-InputLow)) + 4.0; 
	
	if rMiliAmps&gt;-300.0 and rMiliAmps&lt; 300.0 then
		MilliAmps:=REAL_TO_INT(rMiliAmps*100.0);
	end_if;


	if  not IS_PAR_CON (INP := Config.OverflowPercentage) then
		tmpOverflowPercentage:=2.0;
	else
		tmpOverflowPercentage:=Config.OverflowPercentage;
	end_if;

	if  not IS_PAR_CON (INP := Config.UnderflowPercentage) then
		tmpUnderflowPercentage:=1.0;
	else
		tmpUnderflowPercentage:=Config.UnderflowPercentage;
	end_if;

	if  not IS_PAR_CON (INP := Config.WirebreakPercentage) then
		tmpWirebreakPercentage:=4.0;
	else
		tmpWirebreakPercentage:=Config.WirebreakPercentage;
	end_if;

	(* get 5% of the range for setting wirebreak alarm *)
	OverflowPercentage:=((tmpInputHigh - tmpInputLow)*(tmpOverflowPercentage/100.0));
	UnderflowPercentage:=((tmpInputHigh - tmpInputLow)*(tmpUnderflowPercentage/100.0));
	WirebreakPercentage:=((tmpInputHigh - tmpInputLow)*(tmpWirebreakPercentage/100.0));
END_IF;
</STSource>
		</FBProgram>
