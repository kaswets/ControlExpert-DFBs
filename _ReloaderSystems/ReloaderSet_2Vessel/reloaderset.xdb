			</variables>
		</structure>
	</DDTSource>
	<FBSource nameOfFBType="SetToMinSecBCDPuls" version="0.05" dateTime="dt#2019-12-05-11:18:19">
		<attribute name="TypeCodeCheckSumString" value="4C93"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="9827"></attribute>
		<attribute name="TypeDataDicSubfieldsCount" value="9"></attribute>
		<inputParameters>
			<variables name="SecPuls" typeName="EBOOL">
				<attribute name="PositionPin" value="4"></attribute>
			</variables>
			<variables name="Reset" typeName="EBOOL">
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
		</inputParameters>
		<outputParameters>
			<variables name="TimeMM_SS" typeName="INT">
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
			<variables name="Minuten" typeName="INT">
				<attribute name="PositionPin" value="2"></attribute>
			</variables>
			<variables name="Seconde" typeName="INT">
				<attribute name="PositionPin" value="3"></attribute>
			</variables>
			<variables name="StructTime" typeName="ValveTime">
				<attribute name="PositionPin" value="4"></attribute>
			</variables>
		</outputParameters>
		<privateLocalVariables>
			<variables name="BCD_Sec" typeName="INT"></variables>
			<variables name="BCD_min" typeName="INT"></variables>
			<variables name="TimeInSec" typeName="INT"></variables>
		</privateLocalVariables>
		<FBProgram name="ProgramTime">
			<STSource>(* seconde omzetten naar seconde en minuten *)

if re(reset) then
  TimeInSec := 0;
end_if;

if re(SecPuls) then
  TimeInSec:=TimeInSec+1;
End_if;

Minuten := TimeInSec/60;
Seconde := mod(TimeInSec,60);

(* Omzetten naar BCD *)

BCD_Sec := INT_TO_BCD ( Seconde);

BCD_min := shl(Int_To_BCD(Minuten), 8 );

TimeMM_SS :=BCD_min OR BCD_Sec;


(* ook in de struct time zetten *)
StructTime.seconde := Seconde;
StructTime.Minuten := Minuten;
</STSource>
		</FBProgram>
	</FBSource>
