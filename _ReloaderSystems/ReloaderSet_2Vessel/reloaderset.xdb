	<FBSource nameOfFBType="BitCheck" version="0.11" dateTime="dt#2026-05-11-14:17:40">
		<comment>Function Count how many bits there are 1 in a word</comment>
		<attribute name="TypeCodeCheckSumString" value="DC0D"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="C978"></attribute>
		<attribute name="TypeDataDicSubfieldsCount" value="21"></attribute>
		<inputParameters>
			<variables name="WrdIn" typeName="WORD">
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
		</inputParameters>
		<outputParameters>
			<variables name="ValueOut" typeName="WORD">
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
			<variables name="Bit0" typeName="BOOL">
				<attribute name="PositionPin" value="2"></attribute>
			</variables>
			<variables name="Bit1" typeName="BOOL">
				<attribute name="PositionPin" value="3"></attribute>
			</variables>
			<variables name="Bit2" typeName="BOOL">
				<attribute name="PositionPin" value="4"></attribute>
			</variables>
			<variables name="Bit3" typeName="BOOL">
				<attribute name="PositionPin" value="5"></attribute>
			</variables>
			<variables name="Bit4" typeName="BOOL">
				<attribute name="PositionPin" value="6"></attribute>
			</variables>
			<variables name="Bit5" typeName="BOOL">
				<attribute name="PositionPin" value="7"></attribute>
			</variables>
			<variables name="Bit6" typeName="BOOL">
				<attribute name="PositionPin" value="8"></attribute>
			</variables>
			<variables name="Bit7" typeName="BOOL">
				<attribute name="PositionPin" value="9"></attribute>
			</variables>
			<variables name="Bit8" typeName="BOOL">
				<attribute name="PositionPin" value="10"></attribute>
			</variables>
			<variables name="Bit9" typeName="BOOL">
				<attribute name="PositionPin" value="11"></attribute>
			</variables>
			<variables name="Bit10" typeName="BOOL">
				<attribute name="PositionPin" value="12"></attribute>
			</variables>
			<variables name="Bit11" typeName="BOOL">
				<attribute name="PositionPin" value="13"></attribute>
			</variables>
			<variables name="Bit12" typeName="BOOL">
				<attribute name="PositionPin" value="14"></attribute>
			</variables>
			<variables name="Bit13" typeName="BOOL">
				<attribute name="PositionPin" value="15"></attribute>
			</variables>
			<variables name="Bit14" typeName="BOOL">
				<attribute name="PositionPin" value="16"></attribute>
			</variables>
			<variables name="Bit15" typeName="BOOL">
				<attribute name="PositionPin" value="17"></attribute>
			</variables>
			<variables name="Even" typeName="BOOL">
				<attribute name="PositionPin" value="18"></attribute>
			</variables>
			<variables name="NumberOffBits" typeName="INT">
				<attribute name="PositionPin" value="19"></attribute>
			</variables>
		</outputParameters>
		<privateLocalVariables>
			<variables name="Count" typeName="INT"></variables>
			<variables name="Temp" typeName="WORD"></variables>
			<variables name="oldCount" typeName="INT"></variables>
			<variables name="gelijk" typeName="BOOL"></variables>
			<variables name="fault" typeName="INT"></variables>
		</privateLocalVariables>
		<FBProgram name="info">
			<STSource>(*

Kijken hoeveel bitjes er hoog zijn in een WRD *)
</STSource>
		</FBProgram>
		<FBProgram name="ProgramBitCheck">
			<STSource>
(* copy bits from Word to bools *)

Bit0:=Wrdin.0;
Bit1:=Wrdin.1;
Bit2:=Wrdin.2;
Bit3:=Wrdin.3;
Bit4:=Wrdin.4;
Bit5:=Wrdin.5;
Bit6:=Wrdin.6;
Bit7:=Wrdin.7;
Bit8:=Wrdin.8;
Bit9:=Wrdin.9;
Bit10:=Wrdin.10;
Bit11:=Wrdin.11;
Bit12:=Wrdin.12;
Bit13:=Wrdin.13;
Bit14:=Wrdin.14;
Bit15:=Wrdin.15;

ValueOut:=Wrdin;
NumberOffBits:=0;
temp:=WrdIn;
Count:=0;

while Count&lt;16 do
	if (temp AND 2#0000000000000001)=1 then
		NumberOffBits:=NumberOffBits+1;
	end_if;

	temp := SHR (IN := temp,N := 1);

	Count:=Count+1;

		if (oldCount=Count) then 
			jmp end; (* gezien dat hij in deze stap blijft hangen? *)
			fault:=fault+1;
		end_if;

	oldCount:=Count;

end_while;


end:

</STSource>
		</FBProgram>
	</FBSource>
	<FBSource nameOfFBType="Filterpulse" version="1.08" dateTime="dt#2022-09-20-16:00:12">
		<comment>The filter pulse is used to blow air in a cloth at the bottom of a tank or clean the filters in a Tank. It has configurable valves without feedback and when the input PulseOn is 1 the cycling is started with valve 1 set to 1 for the time set in pulselenght this time is in ms. When this time is over the time set in pulsegap in seconds determines the gap before valve 2 is set to 1 for the time in pulselength and so on.</comment>
		<attribute name="TypePassword" value=""></attribute>
		<attribute name="TypeProtectionLevel" value="2#0000_0000"></attribute>
		<attribute name="TypeCodeCheckSumString" value="E751"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="D6F8"></attribute>
		<attribute name="TypeDataDicSubfieldsCount" value="11"></attribute>
		<inputParameters>
			<variables name="Num_valves" typeName="INT">
				<comment>Number of valves (1 to 15)</comment>
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
			<variables name="parameters" typeName="FilterPulse_Parameters">
				<comment>Filterpulse parameters</comment>
				<attribute name="PositionPin" value="2"></attribute>
			</variables>
			<variables name="PulseOn" typeName="BOOL">
				<comment>Start Filterpulse</comment>
				<attribute name="PositionPin" value="3"></attribute>
			</variables>
			<variables name="ShowHMItime" typeName="TIME">
				<attribute name="PositionPin" value="4"></attribute>
			</variables>
		</inputParameters>
		<outputParameters>
			<variables name="Valves" typeName="FilterPulse_Out">
				<comment>Valves 1 to 15</comment>
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
			<variables name="Pulse" typeName="BOOL">
				<comment>Filterpulse running</comment>
				<attribute name="PositionPin" value="2"></attribute>
			</variables>
			<variables name="hmiShowFP" typeName="WORD">
				<attribute name="PositionPin" value="3"></attribute>
			</variables>
		</outputParameters>
		<privateLocalVariables>
			<variables name="TON_GapLength" typeName="TON">
				<comment>TON timer Gap length between pulses</comment>
			</variables>
			<variables name="TOF_PulseLength" typeName="TOF">
				<comment>TOF timer Pulselength</comment>
			</variables>
			<variables name="TempIntToTime" typeName="TIME">
				<comment>Pulselength in milliseconds (t#..ms)</comment>
			</variables>
			<variables name="TempIntToTime2" typeName="TIME">
				<comment>Pulsegap in seconds (t#..s)</comment>
			</variables>
			<variables name="value" typeName="INT">
				<comment>Current value of the counter</comment>
			</variables>
			<variables name="TON_Running" typeName="TON">
				<comment>Filterpulse running delay</comment>
			</variables>
			<variables name="Int_To_Time_Length" typeName="Int_To_Time2"></variables>
			<variables name="Int_To_Time2_Gap" typeName="Int_To_Time2"></variables>
			<variables name="Pulselenght_Limit" typeName="LimitParameter"></variables>
			<variables name="PulseLength" typeName="Para_HMI"></variables>
			<variables name="Pulsegap_Limit" typeName="LimitParameter"></variables>
			<variables name="PulseGap" typeName="Para_HMI"></variables>
			<variables name="TimeShowHMI" typeName="TON"></variables>
		</privateLocalVariables>
		<FBProgram name="Main">
			<comment>The filterpulse contains 3 valves that blows out air on at a time depending on the pulsegap and pulselength</comment>
			<LDSource nbColumns="11">
				<networkLD>
					<typeLine>
						<emptyLine nbRows="4"></emptyLine>
					</typeLine>
					<typeLine>
						<HLink nbCells="7"></HLink>
						<operateBlock width="4">
							<statement>PulseLength.Actual:=Parameters.SP_PulseLength;</statement>
						</operateBlock>
					</typeLine>
					<typeLine>
						<emptyCell nbCells="4"></emptyCell>
						<FFBBlock instanceName="Pulselenght_Limit" typeName="LimitParameter" additionnalPinNumber="0" enEnO="true" width="16" height="5">
							<objPosition posX="4" posY="5"></objPosition>
							<descriptionFFB execAfter="">
								<inputVariable invertedPin="false" formalParameter="EN"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="Hi_Lim" effectiveParameter="150"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="Lo_Lim" effectiveParameter="1"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="Parameter" effectiveParameter="PulseLength"></inputVariable>
								<outputVariable invertedPin="false" formalParameter="ENO"></outputVariable>
								<outputVariable invertedPin="false" formalParameter="Parameter" effectiveParameter="PulseLength"></outputVariable>
							</descriptionFFB>
						</FFBBlock>
						<emptyCell nbCells="5"></emptyCell>
					</typeLine>
					<typeLine>
						<HLink nbCells="4"></HLink>
						<emptyCell nbCells="7"></emptyCell>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="5"></emptyLine>
					</typeLine>
					<typeLine>
						<HLink nbCells="7"></HLink>
						<operateBlock width="4">
							<statement>PulseGap.Actual:=Parameters.SP_PulseGap;</statement>
						</operateBlock>
					</typeLine>
					<typeLine>
						<emptyCell nbCells="4"></emptyCell>
						<FFBBlock instanceName="Pulsegap_Limit" typeName="LimitParameter" additionnalPinNumber="0" enEnO="true" width="16" height="5">
							<objPosition posX="4" posY="13"></objPosition>
							<descriptionFFB execAfter="">
								<inputVariable invertedPin="false" formalParameter="EN"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="Hi_Lim" effectiveParameter="10"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="Lo_Lim" effectiveParameter="1"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="Parameter" effectiveParameter="PulseGap"></inputVariable>
								<outputVariable invertedPin="false" formalParameter="ENO"></outputVariable>
								<outputVariable invertedPin="false" formalParameter="Parameter" effectiveParameter="PulseGap"></outputVariable>
							</descriptionFFB>
						</FFBBlock>
