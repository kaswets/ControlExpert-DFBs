	<FBSource nameOfFBType="LimitParameter" version="1.00" dateTime="dt#2019-08-27-08:23:47">
		<comment>Limit the parameters from the HMI to acceptable ranges</comment>
		<attribute name="TypePassword" value=""></attribute>
		<attribute name="TypeProtectionLevel" value="2#0000_0000"></attribute>
		<attribute name="TypeCodeCheckSumString" value="0AE8"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="9D15"></attribute>
		<attribute name="TypeDataDicSubfieldsCount" value="7"></attribute>
		<inputParameters>
			<variables name="Hi_Lim" typeName="INT">
				<comment>Maximum value of the parameter</comment>
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
			<variables name="Lo_Lim" typeName="INT">
				<comment>Minimum value of the parameter</comment>
				<attribute name="PositionPin" value="2"></attribute>
			</variables>
		</inputParameters>
		<inOutParameters>
			<variables name="Parameter" typeName="Para_HMI">
				<comment>Parameter to be limited</comment>
				<attribute name="PositionPin" value="3"></attribute>
			</variables>
		</inOutParameters>
		<FBProgram name="Main">
			<comment>Limit parameter</comment>
			<STSource>(*Limit parametervalue depending on high and low limit*)


IF Parameter.Actual &lt; Lo_Lim THEN	(* limit low *)
	Parameter.Actual:=Lo_Lim;	(* overwrite value with low limit *)
ELSIF Parameter.Actual &gt; Hi_Lim THEN	(* limit high *)
	Parameter.Actual:=Hi_Lim;	(* overwrite value with high limit *)
ELSE
	Parameter.Actual:=Parameter.Actual;		
END_IF;
					(* send limits with actual value for setting in HMI *)
Parameter.High		:=	Hi_Lim;
Parameter.Low		:=	Lo_Lim;
</STSource>
		</FBProgram>
	</FBSource>
