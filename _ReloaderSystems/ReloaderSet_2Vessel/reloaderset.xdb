		<FBProgram name="PurgeValve">
			<LDSource nbColumns="11">
				<networkLD>
					<typeLine>
						<emptyLine nbRows="1"></emptyLine>
					</typeLine>
					<typeLine>
						<HLink nbCells="1"></HLink>
						<contact typeContact="openContact" contactVariableName="General.Alarm_Reset"></contact>
						<HLink nbCells="8"></HLink>
						<coil typeCoil="resetCoil" coilVariableName="Outputs.Alarm"></coil>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="2"></emptyLine>
					</typeLine>
					<typeLine>
						<emptyCell nbCells="2"></emptyCell>
						<FFBBlock instanceName=".5" typeName="INT_TO_REAL" additionnalPinNumber="0" enEnO="true" width="12" height="3">
							<objPosition posX="2" posY="4"></objPosition>
							<descriptionFFB execAfter="">
								<inputVariable invertedPin="false" formalParameter="EN"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="IN" effectiveParameter="InOut.SP_Low"></inputVariable>
								<outputVariable invertedPin="false" formalParameter="ENO"></outputVariable>
								<outputVariable invertedPin="false" formalParameter="OUT" effectiveParameter="R_LowestValue"></outputVariable>
							</descriptionFFB>
						</FFBBlock>
						<emptyCell nbCells="2"></emptyCell>
						<FFBBlock instanceName=".6" typeName="INT_TO_REAL" additionnalPinNumber="0" enEnO="true" width="12" height="3">
							<objPosition posX="6" posY="4"></objPosition>
							<descriptionFFB execAfter="">
								<inputVariable invertedPin="false" formalParameter="EN"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="IN" effectiveParameter="InOut.SP_High"></inputVariable>
								<outputVariable invertedPin="false" formalParameter="ENO"></outputVariable>
								<outputVariable invertedPin="false" formalParameter="OUT" effectiveParameter="R_HighestValue"></outputVariable>
							</descriptionFFB>
						</FFBBlock>
						<emptyCell nbCells="3"></emptyCell>
					</typeLine>
					<typeLine>
						<HLink nbCells="2"></HLink>
						<emptyCell nbCells="2"></emptyCell>
						<HLink nbCells="2"></HLink>
						<emptyCell nbCells="5"></emptyCell>
					</typeLine>
					<typeLine>
