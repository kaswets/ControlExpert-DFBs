					<typeLine>
						<emptyLine nbRows="5"></emptyLine>
					</typeLine>
					<typeLine>
						<emptyCell nbCells="4"></emptyCell>
						<FFBBlock instanceName="Int_To_Time_Length" typeName="Int_To_Time2" additionnalPinNumber="0" enEnO="true" width="12" height="4">
							<objPosition posX="4" posY="20"></objPosition>
							<descriptionFFB execAfter="">
								<inputVariable invertedPin="false" formalParameter="EN"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="In" effectiveParameter="PulseLength.Actual"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="Select" effectiveParameter="0"></inputVariable>
								<outputVariable invertedPin="false" formalParameter="ENO"></outputVariable>
								<outputVariable invertedPin="false" formalParameter="Out" effectiveParameter="TempIntToTime"></outputVariable>
							</descriptionFFB>
						</FFBBlock>
						<emptyCell nbCells="5"></emptyCell>
					</typeLine>
					<typeLine>
						<HLink nbCells="4"></HLink>
						<emptyCell nbCells="7"></emptyCell>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="3"></emptyLine>
					</typeLine>
					<typeLine>
						<emptyCell nbCells="4"></emptyCell>
						<FFBBlock instanceName="Int_To_Time2_Gap" typeName="Int_To_Time2" additionnalPinNumber="0" enEnO="true" width="12" height="4">
							<objPosition posX="4" posY="25"></objPosition>
							<descriptionFFB execAfter="">
								<inputVariable invertedPin="false" formalParameter="EN"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="In" effectiveParameter="PulseGap.Actual"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="Select" effectiveParameter="1"></inputVariable>
								<outputVariable invertedPin="false" formalParameter="ENO"></outputVariable>
								<outputVariable invertedPin="false" formalParameter="Out" effectiveParameter="TempIntToTime2"></outputVariable>
							</descriptionFFB>
						</FFBBlock>
						<emptyCell nbCells="5"></emptyCell>
					</typeLine>
					<typeLine>
						<HLink nbCells="4"></HLink>
						<emptyCell nbCells="7"></emptyCell>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="4"></emptyLine>
