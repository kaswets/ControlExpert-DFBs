	<DDTSource DDTName="DValve_Param" version="0.08" dateTime="dt#2019-08-28-13:35:22">
		<comment>Parameters which can be used to change a valve's behaviour while still using the same FB</comment>
		<attribute name="TypeSignatureCheckSumString" value="4882"></attribute>
		<attribute name="TypeDataDicSubfieldsCount" value="7"></attribute>
		<structure>
			<variables name="NormallyOpen" typeName="BOOL">
				<comment>0=Normally Closed, 1=Normally Open</comment>
			</variables>
			<variables name="Delayed_ReturnOutput" typeName="TIME">
				<comment>Delay the signal when the output is removed (only output)</comment>
			</variables>
			<variables name="Delayed_Return" typeName="TIME">
				<comment>Delay the signal when the output is removed (output and status)</comment>
			</variables>
			<variables name="Clino_Enable" typeName="BOOL">
				<comment>Enable the clino function for valves</comment>
			</variables>
			<variables name="Clino_Signal" typeName="BOOL">
				<comment>Close the valve when Clino signal comes</comment>
			</variables>
			<variables name="MonitorTime" typeName="TIME">
				<comment>Time the valve is moving from open to closed/closed to open</comment>
			</variables>
		</structure>
	</DDTSource>
	<FBSource nameOfFBType="RotateValve" version="0.07" dateTime="dt#2021-08-18-14:19:29">
		<attribute name="TypeCodeCheckSumString" value="2A09"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="2E22"></attribute>
		<attribute name="TypeDataDicSubfieldsCount" value="3"></attribute>
		<inputParameters>
			<variables name="angle" typeName="WORD">
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
		</inputParameters>
		<inOutParameters>
			<variables name="Status" typeName="WORD">
				<attribute name="PositionPin" value="2"></attribute>
			</variables>
		</inOutParameters>
		<privateLocalVariables>
			<variables name="Wrd_angle" typeName="WORD"></variables>
		</privateLocalVariables>
		<FBProgram name="Prg">
			<STSource>Wrd_angle:= SHL_WORD (IN := angle, N := 5); 

Status:=Status or Wrd_angle;



</STSource>
		</FBProgram>
	</FBSource>
	<FBSource nameOfFBType="MeasureTime2in" version="0.11" dateTime="dt#2025-04-04-08:00:36">
		<attribute name="TypeCodeCheckSumString" value="006F"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="1288"></attribute>
		<attribute name="TypeDataDicSubfieldsCount" value="6"></attribute>
		<inputParameters>
			<variables name="startPuls" typeName="EBOOL">
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
			<variables name="StopPuls" typeName="EBOOL">
				<attribute name="PositionPin" value="2"></attribute>
			</variables>
		</inputParameters>
		<outputParameters>
			<variables name="TimeLength" typeName="DINT">
				<comment>/ 1000 = mSec</comment>
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
			<variables name="length_mS" typeName="INT">
				<comment>mSec</comment>
				<attribute name="PositionPin" value="2"></attribute>
			</variables>
			<variables name="Length_sec" typeName="INT">
				<attribute name="PositionPin" value="3"></attribute>
			</variables>
		</outputParameters>
		<privateLocalVariables>
			<variables name="startTime" typeName="DINT"></variables>
			<variables name="StopTime" typeName="DINT"></variables>
		</privateLocalVariables>
		<FBProgram name="prg">
			<STSource>




if re(StartPuls) or %s13 then
	startTime:=FREERUN ();
end_if;

if re(StopPuls) or %s13  then
	StopTime:=FREERUN ();

	if stoptime&gt;starttime and Stoptime&gt;0 and Starttime&gt;0 then
		TimeLength:=abs(stoptime-starttime);
		length_mS:=dint_to_int(TimeLength/1000);
		Length_sec:=length_mS/1000;
	end_if;
end_if;
</STSource>
		</FBProgram>
	</FBSource>
	<FBSource nameOfFBType="GaugeSwets" version="1.31" dateTime="dt#2021-07-06-11:53:58">
		<attribute name="TypeCodeCheckSumString" value="487D"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="0E8C"></attribute>
		<attribute name="TypeDataDicSubfieldsCount" value="26"></attribute>
		<inputParameters>
			<variables name="Pressure" typeName="AnalogChanel">
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
			<variables name="spHigh" typeName="INT">
				<attribute name="PositionPin" value="2"></attribute>
			</variables>
			<variables name="spMid" typeName="INT">
				<attribute name="PositionPin" value="3"></attribute>
			</variables>
			<variables name="spLow" typeName="INT">
				<attribute name="PositionPin" value="4"></attribute>
			</variables>
			<variables name="maxPress" typeName="INT">
				<attribute name="PositionPin" value="5"></attribute>
			</variables>
			<variables name="VacRelease" typeName="INT">
				<attribute name="PositionPin" value="6"></attribute>
			</variables>
			<variables name="MaxVac" typeName="INT">
				<attribute name="PositionPin" value="7"></attribute>
			</variables>
			<variables name="FullScale" typeName="STRING">
				<comment>1=-1to6, 2=-1to5</comment>
				<attribute name="PositionPin" value="8"></attribute>
			</variables>
		</inputParameters>
		<outputParameters>
			<variables name="HmiData" typeName="Gauge">
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
		</outputParameters>
		<privateLocalVariables>
			<variables name="TmpPress" typeName="REAL"></variables>
			<variables name="MaxPressMeter" typeName="REAL"></variables>
			<variables name="tmpVacRelease" typeName="REAL"></variables>
			<variables name="MaxVacMeter" typeName="REAL"></variables>
			<variables name="tmpVacPumps" typeName="REAL"></variables>
			<variables name="VacDegressScale" typeName="REAL"></variables>
		</privateLocalVariables>
		<FBProgram name="info">
			<STSource>(*

Omdat ik het scherm meters wilde met meer kleurtjes in de schaal, heb ik een soort van eigen meter gemaakt

het is een gewone standaard vijeo meter,
maar daaronder liggen een aantal CirclGraph objecten voor de kleurtjes

en in dit functie block zit het verhaaltje om het allemaal kloppend temaken in het scherm


Inputs:

pressure 	= de druk die de wijzer aan moet wijzen, In milibars					(int)
MaxPress 	= de druk die de compressor max kunnen leveren (na die druk word de schaal rood)	(int)
spHig    	= Setpoint High  (groen/orange)								(int)
spMid		= Setpoint Mid	(groenblauw/licht groen)						(int)
Splow		= setpoint Low 	(donker blauw/groenblauw)						(int)

VacRelease	= Max Vacuum (lichtblauw/Orange) relase valve gaat open
MaxVac		= MaxVacuum (oranje/rood) vacuumpompen vallen uit

FullScale	= "3000" -&gt; -1 to 3 bar
		= "4000" -&gt; -1 to 4 bar
		= "5000" -&gt; -1 to 5 bar
		= "6000" -&gt; -1 to 6 bar
		= "8000" -&gt; -1 to 8 bar



Meter is gebruikt in

190019 Test Opstelling Bergharen

*)
</STSource>
		</FBProgram>
		<FBProgram name="GaugePrg">
			<STSource>

HmiData.ActualPressure:=Pressure;



if FullScale='6000' then
	MaxPressMeter:=6000.0;
	HmiData.TypeGauge:=6000;
	HmiData.MaxPressScale:=5000;
	VacDegressScale:=1.05;
elsif	FullScale='5000' then
	MaxPressMeter:=5000.0;
	HmiData.TypeGauge:=5000;
	HmiData.MaxPressScale:=5000;
	VacDegressScale:=1.25;
elsif	FullScale='4000' then
	MaxPressMeter:=4000.0;
	HmiData.TypeGauge:=4000;
	HmiData.MaxPressScale:=5000;
	VacDegressScale:=1.55;
elsif	FullScale='3000' then
	MaxPressMeter:=3000.0;
	HmiData.TypeGauge:=3000;
	HmiData.MaxPressScale:=5000;
	VacDegressScale:=2.1;
elsif	FullScale='8000' then
	MaxPressMeter:=8000.0;
	HmiData.TypeGauge:=8000;
	HmiData.MaxPressScale:=5720;
	VacDegressScale:=0.75;
end_if;

MaxVacMeter:=-1000.0;

TmpPress:=int_to_real(HmiData.MaxPressScale)/MaxPressMeter;


HmiData.MaxPress:=real_to_int(TmpPress*maxPressMeter);

HmiData.MaxPress:= real_to_int(TmpPress*int_to_real(maxPress));
HmiData.spHigh:= real_to_int(TmpPress*int_to_real(spHigh));
HmiData.spMid:= real_to_int(TmpPress*int_to_real(spMid));
HmiData.spLow:= real_to_int(TmpPress*int_to_real(spLow));



HmiData.MaxVacScale:=real_to_int(((maxPressMeter/2.0)+MaxVacMeter )*VacDegressScale);


tmpVacRelease:=int_to_real(VacRelease);
HmiData.MaxVacRelease:=real_to_int(((maxPressMeter/2.0)+tmpVacRelease )*VacDegressScale);

tmpVacPumps:=int_to_real(MaxVac);
HmiData.MaxVacPump:=real_to_int(((maxPressMeter/2.0)+tmpVacPumps )*VacDegressScale);


</STSource>
		</FBProgram>
	</FBSource>
