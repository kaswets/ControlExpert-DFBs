						<HLink nbCells="1"></HLink>
						<contact typeContact="openContact" contactVariableName="A_Filling"></contact>
						<HLink nbCells="8"></HLink>
						<coil typeCoil="coil" coilVariableName="Dummy"></coil>
						<HLink nbCells="1"></HLink>
					</typeLine>
					<typeLine>
						<HLink nbCells="3"></HLink>
						<contact typeContact="openContact" contactVariableName="A_busyWithDischarge"></contact>
						<HLink nbCells="14"></HLink>
						<coil typeCoil="coil" coilVariableName="Dummy"></coil>
						<HLink nbCells="1"></HLink>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="2"></emptyLine>
					</typeLine>
					<typeLine>
						<HLink nbCells="1"></HLink>
						<contact typeContact="openContact" contactVariableName="B_Init"></contact>
						<HLink nbCells="1"></HLink>
						<contact typeContact="openContact" contactVariableName="B_Pressurising"></contact>
						<HLink nbCells="1"></HLink>
						<contact typeContact="openContact" contactVariableName="B_Discharging"></contact>
						<HLink nbCells="1"></HLink>
						<contact typeContact="openContact" contactVariableName="B_Emptying"></contact>
						<HLink nbCells="1"></HLink>
						<contact typeContact="openContact" contactVariableName="B_Filling"></contact>
						<HLink nbCells="8"></HLink>
						<coil typeCoil="coil" coilVariableName="Dummy"></coil>
						<HLink nbCells="1"></HLink>
					</typeLine>
					<typeLine>
						<HLink nbCells="3"></HLink>
						<contact typeContact="openContact" contactVariableName="B_BusyWithDischarge"></contact>
						<HLink nbCells="14"></HLink>
						<coil typeCoil="coil" coilVariableName="Dummy"></coil>
						<HLink nbCells="1"></HLink>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="92"></emptyLine>
					</typeLine>
				</networkLD>
			</LDSource>
		</FBProgram>
		<FBProgram name="test_loekverhaaltje">
			<STSource>(* Dit is een verhaaltje gepikt uit een ENBO verhaal geschreven door LOEK (Kovako)		*)
(* Deze routine berekende tijdens het discharge continu de gemiddelde druk in de ketel		*)
(* aan de hand van die gemiddelde druk word een procentuele druk uitgerekend ?			*)
(* in het scherm is een setpoint : "Average Empty"  welke een waarde heeft van 50% tot 95%      *)
(* Zodra de uitgerekende XBTAverageProcent waarde onder het bovenstaande genoemde setpoint 	*)
(* Komt, word er een beetje hoog gemaakt, welke het zelfde doet als het Setpoint mid ?          *)
(* 												*)
(* verder zat er wel een minimale discharge tijd in dat systeem, deze is via een 		*)
(* setpoint : "Minimum Convey Time" in het scherm te wijzigen  tussen de 0 en 120 sec		*)
(*												*)
(* Ik heb het hier even Ingebouwd, om in het echt te zien wat het nu eigelijk doet?		*)

if %s13 then
	spAverageEmpty:=70;
end_if;

if re(A_discharging) or fe(A_discharging) or re(B_discharging) or fe(B_discharging) then
	AverageCnt:=0;
	TotalPressure:=0;
	Set.loekTest.AveragePressure:=0;
	Set.loekTest.AverageProcent:=0;
	Set.loekTest.A_Mid:=False;
	Set.loekTest.B_Mid:=False;
end_if;

TON_A_discharging (IN := (A_discharging or B_discharging)and not Telpuls,PT := T#1000ms,Q =&gt; TelPuls);

if re(TelPuls) then 									(* om de seconde druk meten en gemiddelde uitrekenen*)
	AverageCnt:=AverageCnt+1;

	if A_discharging then								(* discharge with reloader tank A *)
		ReloaderTankPress:=int_to_UDint(ReloaderA_In.Pressure.Value);
		TotalPressure:=TotalPressure + ReloaderTankPress;
	end_if;
	if B_discharging then								(* discharge with reloader tank B *)
		ReloaderTankPress:=int_to_UDint(ReloaderB_In.Pressure.Value);			
		TotalPressure:=TotalPressure + ReloaderTankPress;
	end_if;

	AveragePressure:=TotalPressure/AverageCnt;				(* Calculate average pressure *)

end_if;


(* deze 2 waarden liet loek op het scherm zien	*)
(* bij de discharge leiding			*)

if (A_discharging or B_discharging) and AveragePressure&gt;0 and re(TelPuls) then 			
	Set.loekTest.AveragePressure:=uDint_To_Int(AveragePressure);
	Set.loekTest.AverageProcent:=udint_to_int(((ReloaderTankPress*10)/(AveragePressure/10)));

end_if;

if A_discharging then
	if  Set.loekTest.AverageProcent&lt; spAverageEmpty and re(TelPuls) then
  		Set.loekTest.A_Mid:=true;
	end_if;
end_if;

if B_discharging then
	if  Set.loekTest.AverageProcent&lt; spAverageEmpty and re(TelPuls) then
  		Set.loekTest.B_Mid:=true;
	end_if;
end_if;
</STSource>
		</FBProgram>
	</FBSource>
