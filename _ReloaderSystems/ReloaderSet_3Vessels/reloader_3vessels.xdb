	<DDTSource DDTName="Avalve_Cmd" version="0.11" dateTime="dt#2024-08-29-12:21:29">
		<comment>struct used for nozzle and purge  Analog valves</comment>
		<attribute name="TypeSignatureCheckSumString" value="501F"></attribute>
		<attribute name="TypeDataDicSubfieldsCount" value="8"></attribute>
		<structure>
			<variables name="Man_Setpoint" typeName="INT">
				<comment>Manual setpoint 0..100%</comment>
			</variables>
