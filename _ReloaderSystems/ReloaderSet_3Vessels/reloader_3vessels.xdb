	<FBSource nameOfFBType="Int_To_Time2" version="1.00" dateTime="dt#2019-08-27-08:23:47">
		<comment>Converts an integer to timeformat with the adation that you can select the format of the Time</comment>
		<attribute name="TypePassword" value=""></attribute>
		<attribute name="TypeProtectionLevel" value="2#0000_0000"></attribute>
		<attribute name="TypeCodeCheckSumString" value="3BB3"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="EA43"></attribute>
		<attribute name="TypeDataDicSubfieldsCount" value="4"></attribute>
		<inputParameters>
			<variables name="In" typeName="INT">
				<comment>Integer value</comment>
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
			<variables name="Select" typeName="INT">
				<comment>Select time format (0=ms, 1=sec, 2=min, 3=hours, 4=days)</comment>
				<attribute name="PositionPin" value="2"></attribute>
			</variables>
		</inputParameters>
		<outputParameters>
			<variables name="Out" typeName="TIME">
				<comment>Converted time</comment>
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
		</outputParameters>
		<privateLocalVariables>
			<variables name="TempIn" typeName="REAL">
				<comment>Temperary variable for calculating</comment>
			</variables>
		</privateLocalVariables>
		<FBProgram name="Main">
			<comment>Convert integer to time</comment>
			<LDSource nbColumns="11">
				<networkLD>
					<typeLine>
						<emptyLine nbRows="1"></emptyLine>
					</typeLine>
					<typeLine>
						<HLink nbCells="7"></HLink>
						<operateBlock width="4">
							<statement>TempIn:=INT_TO_REAL(In);</statement>
						</operateBlock>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="1"></emptyLine>
					</typeLine>
					<typeLine>
						<compareBlock width="2">
							<expression>Select&gt;0</expression>
						</compareBlock>
						<HLink nbCells="5"></HLink>
						<operateBlock width="4">
							<statement>TempIn:=TempIn*1000.0;</statement>
						</operateBlock>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="1"></emptyLine>
					</typeLine>
					<typeLine>
						<compareBlock width="2">
							<expression>Select&gt;1</expression>
						</compareBlock>
						<HLink nbCells="5"></HLink>
						<operateBlock width="4">
							<statement>TempIn:=TempIn*60.0;</statement>
						</operateBlock>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="1"></emptyLine>
					</typeLine>
					<typeLine>
						<compareBlock width="2">
							<expression>Select&gt;2</expression>
						</compareBlock>
						<HLink nbCells="5"></HLink>
						<operateBlock width="4">
							<statement>TempIn:=TempIn*60.0;</statement>
						</operateBlock>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="1"></emptyLine>
					</typeLine>
					<typeLine>
						<compareBlock width="2">
							<expression>Select&gt;3</expression>
						</compareBlock>
						<HLink nbCells="5"></HLink>
						<operateBlock width="4">
							<statement>TempIn:=TempIn*24.0;</statement>
						</operateBlock>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="1"></emptyLine>
					</typeLine>
					<typeLine>
						<emptyCell nbCells="7"></emptyCell>
						<FFBBlock instanceName=".2" typeName="REAL_TO_TIME" additionnalPinNumber="0" enEnO="true" width="14" height="3">
							<objPosition posX="7" posY="11"></objPosition>
							<descriptionFFB execAfter="">
								<inputVariable invertedPin="false" formalParameter="EN"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="IN" effectiveParameter="TempIn"></inputVariable>
								<outputVariable invertedPin="false" formalParameter="ENO"></outputVariable>
								<outputVariable invertedPin="false" formalParameter="OUT" effectiveParameter="Out"></outputVariable>
							</descriptionFFB>
						</FFBBlock>
						<emptyCell nbCells="2"></emptyCell>
					</typeLine>
					<typeLine>
						<HLink nbCells="7"></HLink>
						<emptyCell nbCells="4"></emptyCell>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="87"></emptyLine>
					</typeLine>
					<textBox width="11" height="1">From seconds to minutes
    <objPosition posX="0" posY="4"></objPosition>
					</textBox>
					<textBox width="11" height="1">From hours to days
    <objPosition posX="0" posY="8"></objPosition>
					</textBox>
					<textBox width="11" height="1">From minutes to hours
    <objPosition posX="0" posY="6"></objPosition>
					</textBox>
					<textBox width="11" height="1">Convert realvalue time to timevalue
    <objPosition posX="0" posY="10"></objPosition>
					</textBox>
					<textBox width="11" height="1">Convert inputs to real for calculating
    <objPosition posX="0" posY="0"></objPosition>
					</textBox>
					<textBox width="11" height="1">From milliseconds to seconds
    <objPosition posX="0" posY="2"></objPosition>
					</textBox>
				</networkLD>
			</LDSource>
		</FBProgram>
	</FBSource>
	<FBSource nameOfFBType="Reloader" version="2.34" dateTime="dt#2025-07-18-09:27:33">
