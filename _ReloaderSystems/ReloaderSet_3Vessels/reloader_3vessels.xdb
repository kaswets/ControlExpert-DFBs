					</typeLine>
					<typeLine>
						<HLink nbCells="1"></HLink>
						<contact typeContact="PContact" contactVariableName="ReloaderA_InOut.PressureTestOn"></contact>
						<shortCircuit>
							<VLink></VLink>
							<HLink nbCells="12"></HLink>
						</shortCircuit>
						<HLink nbCells="3"></HLink>
						<coil typeCoil="resetCoil" coilVariableName="Set.Start"></coil>
						<HLink nbCells="2"></HLink>
					</typeLine>
					<typeLine>
						<HLink nbCells="1"></HLink>
						<contact typeContact="PContact" contactVariableName="ReloaderB_InOut.PressureTestOn"></contact>
						<HLink nbCells="15"></HLink>
						<coil typeCoil="resetCoil" coilVariableName="Set.End"></coil>
						<HLink nbCells="2"></HLink>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="2"></emptyLine>
					</typeLine>
					<typeLine>
						<HLink nbCells="1"></HLink>
						<contact typeContact="openContact" contactVariableName="Set.Start"></contact>
						<shortCircuit>
							<VLink></VLink>
							<HLink nbCells="1"></HLink>
						</shortCircuit>
						<HLink nbCells="2"></HLink>
						<contact typeContact="openContact" contactVariableName="ReloaderA_InOut.PressureTestOn"></contact>
						<shortCircuit>
							<VLink></VLink>
							<HLink nbCells="2"></HLink>
						</shortCircuit>
						<shortCircuit>
							<VLink></VLink>
							<HLink nbCells="8"></HLink>
						</shortCircuit>
						<HLink nbCells="1"></HLink>
						<coil typeCoil="resetCoil" coilVariableName="ReloaderA_InOut.PressureTestOn"></coil>
						<HLink nbCells="2"></HLink>
					</typeLine>
					<typeLine>
						<HLink nbCells="1"></HLink>
						<contact typeContact="openContact" contactVariableName="Set.End"></contact>
						<HLink nbCells="3"></HLink>
						<contact typeContact="openContact" contactVariableName="ReloaderB_InOut.PressureTestOn"></contact>
						<HLink nbCells="2"></HLink>
