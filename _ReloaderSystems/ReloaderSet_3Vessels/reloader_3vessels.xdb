						<HLink nbCells="1"></HLink>
						<contact typeContact="openContact" contactVariableName="General.Alarm_Reset"></contact>
						<HLink nbCells="16"></HLink>
						<coil typeCoil="resetCoil" coilVariableName="Out.Alarm"></coil>
						<HLink nbCells="1"></HLink>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="3"></emptyLine>
					</typeLine>
					<typeLine>
						<emptyCell nbCells="12"></emptyCell>
						<FFBBlock instanceName=".5" typeName="INT_TO_REAL" additionnalPinNumber="0" enEnO="true" width="12" height="3">
							<objPosition posX="12" posY="11"></objPosition>
							<descriptionFFB execAfter="">
								<inputVariable invertedPin="false" formalParameter="EN"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="IN" effectiveParameter="abs(Settings.StartPressure.SetPoint)"></inputVariable>
								<outputVariable invertedPin="false" formalParameter="ENO"></outputVariable>
								<outputVariable invertedPin="false" formalParameter="OUT" effectiveParameter="R_PurgeStart"></outputVariable>
							</descriptionFFB>
