		<FBProgram name="extraReset">
			<LDSource nbColumns="20">
				<networkLD>
					<typeLine>
						<emptyLine nbRows="3"></emptyLine>
					</typeLine>
					<typeLine>
						<HLink nbCells="1"></HLink>
						<contact typeContact="PContact" contactVariableName="Set.Start"></contact>
						<shortCircuit>
							<VLink></VLink>
							<HLink nbCells="12"></HLink>
						</shortCircuit>
						<HLink nbCells="3"></HLink>
						<coil typeCoil="resetCoil" coilVariableName="ReloaderA_InOut.PressureTestOn"></coil>
						<HLink nbCells="2"></HLink>
					</typeLine>
					<typeLine>
						<HLink nbCells="1"></HLink>
