		<FBProgram name="Info">
			<STSource>(* In dit FunctieBlok zit alle verschillende soorten analoge kleppen die we gebruiken			*)
(* Dus alleen de kleppen die een analoge output gebruiken bij VABH					*)
(* Dmv parameters kan aan de buitkant van dit functie blok worden bepaald hoe het werkt. 		*)

(* SelectPressOrVac	: of hij reageert op Druk (purge) of op vacuum (nozzle)				*)
(* select1Or2Setpoints	: Of hij werkt met 1 (release valve , blower pressur constant houden) 		*)
(*					   2 (Purge/extra air  pf een nozzle) setpoints			*)

(* Als het function blok werkt met 1 setpoint, moeten de waarde Kp, Ki en Kd mee gegeven worden voor de	*)
(* PID regeling.											*(

(* Ik ga proberen al de door ons gebruikte geregelde kleppen in dit functie blok te bouwen, zodat 	*)
(* ik voortaan alijd alle kanten op kan									*)


</STSource>
		</FBProgram>
		<FBProgram name="selection">
			<STSource>

purgeMode	:=false;
Nozzlemode	:=false;
VacReleaseMode	:=False;
BlowerSafetyMode:=false;
Direct		:=false;
FaulrConfig	:=false;

if select1Or2Setpoints=2 and SelectPressOrVac=0 then
	purgeMode	:=true;
elsif select1Or2Setpoints=1 and SelectPressOrVac=0 then
	BlowerSafetyMode:=true;
elsif select1Or2Setpoints=2 and SelectPressOrVac=1 then
	Nozzlemode	:=true;
elsif select1Or2Setpoints=1 and SelectPressOrVac=1 then
	VacReleaseMode	:=true;
elsif select1Or2Setpoints=0 and SelectPressOrVac=0 then
	Direct		:=true;


else
	FaulrConfig:=true;
end_if;


</STSource>
		</FBProgram>
