					</textBox>
					<textBox width="2" height="1">Valve V20
    <objPosition posX="18" posY="83"></objPosition>
					</textBox>
					<textBox width="4" height="1">Work as purge valve, with 2 setpoints<objPosition posX="11" posY="146"></objPosition>
					</textBox>
					<textBox width="2" height="1">Collect valve status
    <objPosition posX="18" posY="42"></objPosition>
					</textBox>
					<textBox width="11" height="2">Reloader A
    <objPosition posX="0" posY="18"></objPosition>
					</textBox>
					<textBox width="11" height="1">Vacuum valve
    <objPosition posX="0" posY="98"></objPosition>
					</textBox>
					<textBox width="11" height="1">Reloader A
    <objPosition posX="0" posY="64"></objPosition>
					</textBox>
					<textBox width="2" height="1">Vent<objPosition posX="18" posY="102"></objPosition>
					</textBox>
					<textBox width="11" height="1">Check if Blower is running before opening fill valve to prevent from creating a vacuum in the hold.
    <objPosition posX="0" posY="29"></objPosition>
					</textBox>
					<textBox width="11" height="1">Fill valve Request
    <objPosition posX="0" posY="25"></objPosition>
					</textBox>
					<textBox width="11" height="2">Reloader B
    <objPosition posX="0" posY="76"></objPosition>
					</textBox>
					<textBox width="11" height="1">AirSupply valve
    <objPosition posX="0" posY="106"></objPosition>
					</textBox>
					<textBox width="2" height="1">Valve V11
    <objPosition posX="18" posY="34"></objPosition>
					</textBox>
					<textBox width="11" height="1">AirSupply valve
    <objPosition posX="0" posY="49"></objPosition>
					</textBox>
					<textBox width="11" height="1">Reloader B<objPosition posX="0" posY="122"></objPosition>
					</textBox>
					<textBox width="2" height="1">Valve V13
    <objPosition posX="18" posY="107"></objPosition>
					</textBox>
					<textBox width="11" height="1">Set active by default. The next condition will overwrite this one when the reloaderset is idle
    <objPosition posX="0" posY="187"></objPosition>
					</textBox>
					<textBox width="11" height="1">Set idle when step 0 and 5 are active<objPosition posX="0" posY="189"></objPosition>
					</textBox>
					<textBox width="11" height="1">Vacuum valve
    <objPosition posX="0" posY="41"></objPosition>
					</textBox>
					<textBox width="11" height="1">Check if Blower is running before opening fill valve to prevent from creating a vacuum in the hold.
    <objPosition posX="0" posY="86"></objPosition>
					</textBox>
					<textBox width="2" height="1">Valve V13
    <objPosition posX="18" posY="50"></objPosition>
					</textBox>
					<textBox width="11" height="1">Assign valve commands
    <objPosition posX="0" posY="79"></objPosition>
					</textBox>
					<textBox width="2" height="1">Collect valve status
    <objPosition posX="18" posY="99"></objPosition>
					</textBox>
					<textBox width="11" height="1">Fill valve
    <objPosition posX="0" posY="82"></objPosition>
					</textBox>
					<textBox width="11" height="1">Discharge valve
    <objPosition posX="0" posY="90"></objPosition>
					</textBox>
					<textBox width="6" height="1">Keep AirSupply ReloaderB open when AirSupply ReloaderA is still closed<objPosition posX="14" posY="110"></objPosition>
					</textBox>
					<textBox width="2" height="1">Vent Valve<objPosition posX="18" posY="45"></objPosition>
					</textBox>
					<textBox width="11" height="1">Reset alarmword
    <objPosition posX="0" posY="4"></objPosition>
					</textBox>
					<textBox width="11" height="1">Set buzzer when an alarm comes up. the buzzer can be reset by pressing reset
    <objPosition posX="0" posY="183"></objPosition>
					</textBox>
					<textBox width="11" height="1">Alarms
    <objPosition posX="0" posY="165"></objPosition>
					</textBox>
					<textBox width="11" height="1">Request vacuum from vacuum set when either reloader is about to start vacuum
