							<objPosition posX="6" posY="1"></objPosition>
							<descriptionFFB execAfter="">
								<inputVariable invertedPin="false" formalParameter="EN"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="Pressure" effectiveParameter="Inputs.Pressure"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="spHigh" effectiveParameter="Settings.Discharge.High.SetPoint"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="spMid" effectiveParameter="Settings.Discharge.Mid.SetPoint"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="spLow" effectiveParameter="Settings.Discharge.Low.SetPoint"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="maxPress" effectiveParameter="MaxComp"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="VacRelease" effectiveParameter="ReleaseVac"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="MaxVac" effectiveParameter="MaxVac"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="FullScale" effectiveParameter="'4000'"></inputVariable>
								<outputVariable invertedPin="false" formalParameter="ENO"></outputVariable>
								<outputVariable invertedPin="false" formalParameter="HmiData" effectiveParameter="InOut.Gauge"></outputVariable>
							</descriptionFFB>
						</FFBBlock>
