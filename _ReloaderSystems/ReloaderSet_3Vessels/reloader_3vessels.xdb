		<FBProgram name="pressureTest">
			<STSource>
AirOpen:=Outputs.AirSupply.Output; (* ivm rising egde detection *)
TestOn:=InOut.PressureTestOn;

if not TestOn then
	StartTime:=False;
end_if;


if re(TestOn) then (* aan het begin van de test de drukken op 0 zetten *)
	InOut.PressTest.StartPressure:=0;
	InOut.PressTest.TestTime:=0;
end_if;

if InOut.PressureTestOn and InOut.Gauge.ActualPressure.Value&gt;=Settings.PressureTest.SetPoint and fe(AirOpen) then
	InOut.PressTest.StartPressure:=InOut.Gauge.ActualPressure.Value;
	StartTime:=true;
end_if;


secpuls:=%s6;



if StartTime then
	InOut.PressTest.PressureDifferents:=abs(InOut.PressTest.StartPressure-InOut.Gauge.ActualPressure.Value);


	if re(secpuls) then
		InOut.PressTest.TestTime:=InOut.PressTest.TestTime+1;
	end_if;
end_if;









</STSource>
		</FBProgram>
	</FBSource>
