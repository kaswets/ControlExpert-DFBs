								<inputVariable invertedPin="false" formalParameter="IN2" effectiveParameter="1"></inputVariable>
								<outputVariable invertedPin="false" formalParameter="ENO"></outputVariable>
								<outputVariable invertedPin="false" formalParameter="OUT" effectiveParameter="PurgeModeRuns"></outputVariable>
							</descriptionFFB>
						</FFBBlock>
						<emptyCell nbCells="12"></emptyCell>
					</typeLine>
					<typeLine>
						<HLink nbCells="6"></HLink>
