						<emptyLine nbRows="2"></emptyLine>
					</typeLine>
					<typeLine>
						<HLink nbCells="16"></HLink>
						<operateBlock width="4">
							<statement>InOut.Status:=0;</statement>
						</operateBlock>
					</typeLine>
					<typeLine>
						<HLink nbCells="2"></HLink>
						<contact typeContact="openContact" contactVariableName="InOut.Position &gt; 2"></contact>
						<HLink nbCells="13"></HLink>
						<operateBlock width="4">
							<statement>InOut.Status:=1;</statement>
						</operateBlock>
					</typeLine>
					<typeLine>
						<HLink nbCells="2"></HLink>
						<contact typeContact="openContact" contactVariableName="Out.Alarm"></contact>
						<HLink nbCells="13"></HLink>
						<operateBlock width="4">
							<statement>InOut.Status:=3;</statement>
						</operateBlock>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="1"></emptyLine>
					</typeLine>
					<typeLine>
						<HLink nbCells="2"></HLink>
						<contact typeContact="openContact" contactVariableName="false"></contact>
						<HLink nbCells="13"></HLink>
						<operateBlock width="4">
							<statement>InOut.Status:=4;</statement>
						</operateBlock>
					</typeLine>
					<typeLine>
						<HLink nbCells="16"></HLink>
						<operateBlock width="4">
							<statement>InOut.ActualPressure:=In.WorkingPress;</statement>
						</operateBlock>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="10"></emptyLine>
					</typeLine>
					<textBox width="11" height="1">Reset alarm
    <objPosition posX="0" posY="6"></objPosition>
					</textBox>
					<textBox width="11" height="1">Convert Int values to Real values
    <objPosition posX="0" posY="9"></objPosition>
					</textBox>
					<textBox width="11" height="1">Status
    <objPosition posX="0" posY="83"></objPosition>
					</textBox>
					<textBox width="11" height="1">Alarm
Following alarm will be set when the difference between position and setpoint is greater than 5 for 30seconds
    <objPosition posX="0" posY="72"></objPosition>
					</textBox>
					<textBox width="11" height="1">Convert the compressor pressure to 0..100% based on Start and stop pressure. Start pressure equals 0% and stop pressure equals 100%
    <objPosition posX="0" posY="18"></objPosition>
					</textBox>
					<textBox width="11" height="1">Convert the Feedback signal 0..10000 based on Lowest and Highest calibration value. Lowest value equals 0% and Highest value equals 100%
    <objPosition posX="0" posY="60"></objPosition>
					</textBox>
					<textBox width="5" height="1">Checkbit : Flashing this part is active<objPosition posX="5" posY="0"></objPosition>
					</textBox>
					<textBox width="11" height="1">Determine setpoint based on manual control, FullyOpen or Compressor pressure
    <objPosition posX="0" posY="31"></objPosition>
					</textBox>
				</networkLD>
			</LDSource>
		</FBProgram>
		<FBProgram name="VacReleaseMode" activationCondition="VacReleaseMode" logicCondition="standard">
			<STSource>



VacReleaseModeRuns:=VacReleaseModeRuns xor 1; (* check bit, flashing, this part is active *)


tmpWantedPress:=Settings.StartPressure.SetPoint;




if  CMD then
	PI_control (wanted := tmpWantedPress,
	              actual := In.WorkingPress,
	              kp := PID.Kp,
	              ki := PID.Ki,
	              kd := PID.Kd,
	              Last_error := Last_error,
	              MemdErr := MemdErr,
	              output =&gt; output);
end_if;




if CMD then
            Out.AnalogOut:=output;
end_if;

If (not CMD and not General.ManualMode and VacReleaseAlsoBypass) or FullyOpen then  (* totaal open *)
	Out.AnalogOut:=10000;
end_if;

If not CMD and not General.ManualMode and not VacReleaseAlsoBypass then  (* total CLosed*)
	Out.AnalogOut:=0;
end_if;


if not General.ManualMode then
	if VacReleaseAlsoBypass then
		InOut.Man_Setpoint:=100;
	else
		InOut.Man_Setpoint:=0;
	end_if;
	InOut.ShowManPopUp:=false;
end_if;

if General.ManualMode then
	Out.AnalogOut:=InOut.Man_Setpoint*100;
end_if;
</STSource>
		</FBProgram>
		<FBProgram name="BlowerSafetyMode" activationCondition="BlowerSafetyMode" logicCondition="standard">
			<STSource>BlowerSafetyModeRuns:=BlowerSafetyModeRuns xor 1; (* check bit, flashing, this part is active *)


tmpWantedPress:=Settings.StartPressure.SetPoint;


if  CMD then
	PI_control (wanted := tmpWantedPress,
	              actual := In.WorkingPress,
	              kp := PID.Kp,
	              ki := PID.Ki,
	              kd := PID.Kd,
	              Last_error := Last_error,
	              MemdErr := MemdErr,
	              output =&gt; output);
end_if;



if CMD then
            Out.AnalogOut:=10000-output;

end_if;

If not CMD then  (* totaal open *)
	Out.AnalogOut:=10000;
end_if;


</STSource>
		</FBProgram>
		<FBProgram name="DirectMode" activationCondition="Direct" logicCondition="standard">
			<STSource>DirectModeRuns:=DirectModeRuns xor 1; (* check bit, flashing, this part is active *)


if not General.ManualMode then
	InOut.Man_Setpoint:=100;
	InOut.ShowManPopUp:=false;
end_if;

if not General.ManualMode then
	Out.AnalogOut:=In.DirectWantedPosition;
end_if;


if General.ManualMode then
	Out.AnalogOut:=InOut.Man_Setpoint*100;
end_if;
</STSource>
		</FBProgram>
	</FBSource>
