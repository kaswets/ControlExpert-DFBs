			<variables name="ManOperation_Setpoint" typeName="INT"></variables>
			<variables name="TON_0" typeName="TON"></variables>
			<variables name="TON_1" typeName="TON"></variables>
			<variables name="Direct" typeName="BOOL"></variables>
			<variables name="DirectModeRuns" typeName="BOOL"></variables>
			<variables name="FeedbackOld" typeName="INT"></variables>
			<variables name="TON_2" typeName="TON"></variables>
			<variables name="FeedbackNotMoving" typeName="BOOL"></variables>
			<variables name="SetLowFeedback" typeName="REAL"></variables>
			<variables name="SetHighFeedback" typeName="REAL"></variables>
		</privateLocalVariables>
		<FBProgram name="Info">
			<STSource>(* In dit FunctieBlok zit alle verschillende soorten analoge kleppen die we gebruiken			*)
(* Dus alleen de kleppen die een analoge output gebruiken bij VABH					*)
(* Dmv parameters kan aan de buitkant van dit functie blok worden bepaald hoe het werkt. 		*)

(* SelectPressOrVac	: of hij reageert op Druk (purge) of op vacuum (nozzle)				*)
(* select1Or2Setpoints	: Of hij werkt met 1 (release valve , blower pressur constant houden) 		*)
(*					   2 (Purge/extra air  pf een nozzle) setpoints			*)

(* Als het function blok werkt met 1 setpoint, moeten de waarde Kp, Ki en Kd mee gegeven worden voor de	*)
(* PID regeling.											*(

(* Ik ga proberen al de door ons gebruikte geregelde kleppen in dit functie blok te bouwen, zodat 	*)
(* ik voortaan alijd alle kanten op kan									*)


</STSource>
		</FBProgram>
		<FBProgram name="selection">
			<STSource>

purgeMode	:=false;
Nozzlemode	:=false;
VacReleaseMode	:=False;
BlowerSafetyMode:=false;
Direct		:=false;
FaulrConfig	:=false;

if select1Or2Setpoints=2 and SelectPressOrVac=0 then
	purgeMode	:=true;
elsif select1Or2Setpoints=1 and SelectPressOrVac=0 then
	BlowerSafetyMode:=true;
elsif select1Or2Setpoints=2 and SelectPressOrVac=1 then
	Nozzlemode	:=true;
elsif select1Or2Setpoints=1 and SelectPressOrVac=1 then
	VacReleaseMode	:=true;
elsif select1Or2Setpoints=0 and SelectPressOrVac=0 then
	Direct		:=true;


else
	FaulrConfig:=true;
end_if;


</STSource>
		</FBProgram>
		<FBProgram name="AllModes">
			<LDSource nbColumns="20">
				<networkLD>
					<typeLine>
						<emptyLine nbRows="2"></emptyLine>
					</typeLine>
					<typeLine>
						<HLink nbCells="2"></HLink>
						<contact typeContact="closedContact" contactVariableName="InOut.AutoCalibrateFeedback"></contact>
						<shortCircuit>
							<VLink></VLink>
							<HLink nbCells="4"></HLink>
						</shortCircuit>
						<emptyCell nbCells="13"></emptyCell>
					</typeLine>
					<typeLine>
						<HLink nbCells="1"></HLink>
						<contact typeContact="openContact" contactVariableName="%s0"></contact>
						<shortCircuit>
							<VLink></VLink>
							<HLink nbCells="1"></HLink>
						</shortCircuit>
						<emptyCell nbCells="3"></emptyCell>
						<VLink></VLink>
						<emptyCell nbCells="13"></emptyCell>
					</typeLine>
					<typeLine>
						<HLink nbCells="1"></HLink>
						<contact typeContact="openContact" contactVariableName="%s1"></contact>
						<shortCircuit>
							<VLink></VLink>
							<HLink nbCells="1"></HLink>
						</shortCircuit>
						<HLink nbCells="4"></HLink>
						<shortCircuit>
							<VLink></VLink>
							<HLink nbCells="8"></HLink>
						</shortCircuit>
						<HLink nbCells="1"></HLink>
						<operateBlock width="4">
							<statement>SetLowFeedback:=0.0;</statement>
						</operateBlock>
					</typeLine>
					<typeLine>
						<HLink nbCells="1"></HLink>
						<contact typeContact="openContact" contactVariableName="%s13"></contact>
						<HLink nbCells="1"></HLink>
						<emptyCell nbCells="12"></emptyCell>
						<shortCircuit>
							<VLink></VLink>
							<HLink nbCells="1"></HLink>
						</shortCircuit>
						<operateBlock width="4">
							<statement>SetHighFeedback:=10000.0;</statement>
						</operateBlock>
					</typeLine>
					<typeLine>
						<HLink nbCells="1"></HLink>
						<contact typeContact="openContact" contactVariableName="SetHighFeedback=0.0"></contact>
						<HLink nbCells="14"></HLink>
						<emptyCell nbCells="4"></emptyCell>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="1"></emptyLine>
					</typeLine>
					<typeLine>
						<HLink nbCells="1"></HLink>
						<contact typeContact="closedContact" contactVariableName="InOut.AutoCalibrateFeedback"></contact>
						<HLink nbCells="14"></HLink>
						<control typeControl="jumpCoil" label="ReadFeedBack"></control>
						<emptyCell nbCells="3"></emptyCell>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="1"></emptyLine>
					</typeLine>
					<typeLine>
						<emptyCell nbCells="7"></emptyCell>
						<FFBBlock instanceName="TON_2" typeName="TON" additionnalPinNumber="0" enEnO="false" width="10" height="4">
							<objPosition posX="7" posY="10"></objPosition>
							<descriptionFFB execAfter="">
								<inputVariable invertedPin="false" formalParameter="EN"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="IN"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="PT" effectiveParameter="T#5000ms"></inputVariable>
								<outputVariable invertedPin="false" formalParameter="ENO"></outputVariable>
								<outputVariable invertedPin="false" formalParameter="Q"></outputVariable>
								<outputVariable invertedPin="false" formalParameter="ET"></outputVariable>
							</descriptionFFB>
						</FFBBlock>
						<emptyCell nbCells="11"></emptyCell>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="1"></emptyLine>
					</typeLine>
					<typeLine>
						<HLink nbCells="2"></HLink>
						<contact typeContact="openContact" contactVariableName="Abs(FeedbackOld - In.Feedback)&lt;10"></contact>
						<HLink nbCells="4"></HLink>
						<emptyCell nbCells="2"></emptyCell>
						<HLink nbCells="8"></HLink>
						<coil typeCoil="coil" coilVariableName="FeedbackNotMoving"></coil>
						<HLink nbCells="2"></HLink>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="2"></emptyLine>
					</typeLine>
					<typeLine>
						<HLink nbCells="2"></HLink>
						<contact typeContact="openContact" contactVariableName="Out.AnalogOut=0"></contact>
						<HLink nbCells="2"></HLink>
						<contact typeContact="openContact" contactVariableName="FeedbackNotMoving"></contact>
						<HLink nbCells="3"></HLink>
						<contact typeContact="openContact" contactVariableName="in.Feedback&lt;1000"></contact>
						<HLink nbCells="5"></HLink>
						<operateBlock width="4">
							<statement>SetLowFeedback:=int_to_real(in.feedback);</statement>
						</operateBlock>
						<HLink nbCells="1"></HLink>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="1"></emptyLine>
					</typeLine>
					<typeLine>
						<HLink nbCells="2"></HLink>
						<contact typeContact="openContact" contactVariableName="Out.AnalogOut=10000"></contact>
						<HLink nbCells="2"></HLink>
						<contact typeContact="openContact" contactVariableName="FeedbackNotMoving"></contact>
						<HLink nbCells="3"></HLink>
						<contact typeContact="openContact" contactVariableName="in.Feedback&gt;9000"></contact>
						<HLink nbCells="5"></HLink>
						<operateBlock width="4">
							<statement>SetHighFeedback:=int_to_real(in.feedback);</statement>
						</operateBlock>
						<HLink nbCells="1"></HLink>
					</typeLine>
					<typeLine>
						<HLink nbCells="16"></HLink>
						<operateBlock width="4">
							<statement>FeedbackOld:=In.Feedback;</statement>
						</operateBlock>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="1"></emptyLine>
					</typeLine>
					<typeLine>
						<labelCell label="ReadFeedBack">
							<objPosition posX="0" posY="20"></objPosition>
						</labelCell>
						<emptyCell nbCells="19"></emptyCell>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="1"></emptyLine>
					</typeLine>
					<typeLine>
						<emptyCell nbCells="6"></emptyCell>
						<FFBBlock instanceName="Scale_Feedback" typeName="Analog" additionnalPinNumber="0" enEnO="true" width="16" height="8">
							<objPosition posX="6" posY="22"></objPosition>
							<descriptionFFB execAfter="">
								<inputVariable invertedPin="false" formalParameter="EN"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="Config" effectiveParameter="Sensor"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="Raw" effectiveParameter="In.Feedback"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="InputHigh" effectiveParameter="SetHighFeedback"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="InputLow" effectiveParameter="SetLowFeedback"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="OutputHigh" effectiveParameter="1000.0"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="OutputLow" effectiveParameter="0.0"></inputVariable>
								<outputVariable invertedPin="false" formalParameter="ENO"></outputVariable>
								<outputVariable invertedPin="false" formalParameter="ActualValue" effectiveParameter="InOut.Position"></outputVariable>
								<outputVariable invertedPin="false" formalParameter="Alarms"></outputVariable>
								<outputVariable invertedPin="false" formalParameter="ConfigFail"></outputVariable>
								<outputVariable invertedPin="false" formalParameter="MilliAmps"></outputVariable>
							</descriptionFFB>
						</FFBBlock>
						<emptyCell nbCells="12"></emptyCell>
					</typeLine>
					<typeLine>
						<HLink nbCells="6"></HLink>
						<emptyCell nbCells="14"></emptyCell>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="6"></emptyLine>
					</typeLine>
					<typeLine>
						<HLink nbCells="2"></HLink>
						<contact typeContact="openContact" contactVariableName="InOut.Position&gt;1000"></contact>
						<HLink nbCells="13"></HLink>
						<operateBlock width="4">
							<statement>InOut.Position:=1000;</statement>
						</operateBlock>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="69"></emptyLine>
					</typeLine>
					<textBox width="11" height="1">Test if the valve is still moving<objPosition posX="0" posY="0"></objPosition>
					</textBox>
					<textBox width="11" height="1">Scale feedback to a position between 0 and 100% based on calibration values
    <objPosition posX="0" posY="21"></objPosition>
					</textBox>
				</networkLD>
			</LDSource>
		</FBProgram>
		<FBProgram name="PurgeMode" activationCondition="purgeMode" logicCondition="standard">
			<LDSource nbColumns="20">
				<networkLD>
					<typeLine>
						<emptyLine nbRows="1"></emptyLine>
					</typeLine>
					<typeLine>
						<emptyCell nbCells="6"></emptyCell>
						<FFBBlock instanceName=".1" typeName="XOR_BOOL" additionnalPinNumber="0" enEnO="true" width="12" height="4">
							<objPosition posX="6" posY="1"></objPosition>
							<descriptionFFB execAfter="">
								<inputVariable invertedPin="false" formalParameter="EN"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="IN1" effectiveParameter="PurgeModeRuns"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="IN2" effectiveParameter="1"></inputVariable>
								<outputVariable invertedPin="false" formalParameter="ENO"></outputVariable>
								<outputVariable invertedPin="false" formalParameter="OUT" effectiveParameter="PurgeModeRuns"></outputVariable>
							</descriptionFFB>
						</FFBBlock>
						<emptyCell nbCells="12"></emptyCell>
					</typeLine>
					<typeLine>
						<HLink nbCells="6"></HLink>
						<emptyCell nbCells="14"></emptyCell>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="4"></emptyLine>
					</typeLine>
					<typeLine>
						<HLink nbCells="1"></HLink>
						<contact typeContact="openContact" contactVariableName="General.Alarm_Reset"></contact>
						<HLink nbCells="16"></HLink>
						<coil typeCoil="resetCoil" coilVariableName="Out.Alarm"></coil>
						<HLink nbCells="1"></HLink>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="3"></emptyLine>
					</typeLine>
					<typeLine>
						<emptyCell nbCells="12"></emptyCell>
						<FFBBlock instanceName=".5" typeName="INT_TO_REAL" additionnalPinNumber="0" enEnO="true" width="12" height="3">
							<objPosition posX="12" posY="11"></objPosition>
							<descriptionFFB execAfter="">
								<inputVariable invertedPin="false" formalParameter="EN"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="IN" effectiveParameter="abs(Settings.StartPressure.SetPoint)"></inputVariable>
								<outputVariable invertedPin="false" formalParameter="ENO"></outputVariable>
								<outputVariable invertedPin="false" formalParameter="OUT" effectiveParameter="R_PurgeStart"></outputVariable>
							</descriptionFFB>
						</FFBBlock>
						<emptyCell nbCells="6"></emptyCell>
					</typeLine>
					<typeLine>
						<HLink nbCells="4"></HLink>
						<contact typeContact="closedContact" contactVariableName="SelectPressOrVac"></contact>
						<HLink nbCells="7"></HLink>
						<emptyCell nbCells="8"></emptyCell>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="1"></emptyLine>
					</typeLine>
					<typeLine>
						<emptyCell nbCells="12"></emptyCell>
						<FFBBlock instanceName=".6" typeName="INT_TO_REAL" additionnalPinNumber="0" enEnO="true" width="12" height="3">
							<objPosition posX="12" posY="14"></objPosition>
							<descriptionFFB execAfter="">
								<inputVariable invertedPin="false" formalParameter="EN"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="IN" effectiveParameter="abs(Settings.TotalOpenPressure.SetPoint)"></inputVariable>
								<outputVariable invertedPin="false" formalParameter="ENO"></outputVariable>
								<outputVariable invertedPin="false" formalParameter="OUT" effectiveParameter="R_PurgeStop"></outputVariable>
							</descriptionFFB>
						</FFBBlock>
						<emptyCell nbCells="6"></emptyCell>
					</typeLine>
					<typeLine>
						<HLink nbCells="4"></HLink>
						<contact typeContact="closedContact" contactVariableName="SelectPressOrVac"></contact>
						<HLink nbCells="7"></HLink>
						<emptyCell nbCells="8"></emptyCell>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="3"></emptyLine>
					</typeLine>
					<typeLine>
						<emptyCell nbCells="6"></emptyCell>
						<FFBBlock instanceName="Convert_Press_SP_Purge" typeName="Analog" additionnalPinNumber="0" enEnO="true" width="16" height="8">
							<objPosition posX="6" posY="19"></objPosition>
							<descriptionFFB execAfter="">
								<inputVariable invertedPin="false" formalParameter="EN"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="Config"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="Raw" effectiveParameter="abs(In.WorkingPress)"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="InputHigh" effectiveParameter="R_PurgeStop"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="InputLow" effectiveParameter="R_PurgeStart"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="OutputHigh" effectiveParameter="100.0"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="OutputLow" effectiveParameter="0.0"></inputVariable>
								<outputVariable invertedPin="false" formalParameter="ENO"></outputVariable>
								<outputVariable invertedPin="false" formalParameter="ActualValue" effectiveParameter="Auto_Setpoint"></outputVariable>
								<outputVariable invertedPin="false" formalParameter="Alarms"></outputVariable>
								<outputVariable invertedPin="false" formalParameter="ConfigFail"></outputVariable>
								<outputVariable invertedPin="false" formalParameter="MilliAmps"></outputVariable>
							</descriptionFFB>
						</FFBBlock>
						<emptyCell nbCells="12"></emptyCell>
					</typeLine>
					<typeLine>
						<HLink nbCells="6"></HLink>
						<emptyCell nbCells="14"></emptyCell>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="9"></emptyLine>
					</typeLine>
					<typeLine>
						<HLink nbCells="1"></HLink>
						<contact typeContact="PContact" contactVariableName="General.ManualMode"></contact>
						<HLink nbCells="14"></HLink>
						<operateBlock width="4">
							<statement>InOut.Man_Setpoint:=Setpoint;</statement>
						</operateBlock>
					</typeLine>
					<typeLine>
						<HLink nbCells="1"></HLink>
						<contact typeContact="closedContact" contactVariableName="General.ManualMode"></contact>
						<HLink nbCells="16"></HLink>
						<coil typeCoil="resetCoil" coilVariableName="InOut.ShowManPopUp"></coil>
						<HLink nbCells="1"></HLink>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="1"></emptyLine>
					</typeLine>
					<typeLine>
						<HLink nbCells="1"></HLink>
						<contact typeContact="openContact" contactVariableName="General.ManualMode"></contact>
						<HLink nbCells="14"></HLink>
						<operateBlock width="4">
							<statement>Setpoint:= InOut.Man_Setpoint;</statement>
						</operateBlock>
					</typeLine>
					<typeLine>
						<HLink nbCells="1"></HLink>
						<contact typeContact="NContact" contactVariableName="General.ManualMode"></contact>
						<shortCircuit>
							<VLink></VLink>
							<HLink nbCells="1"></HLink>
						</shortCircuit>
						<HLink nbCells="7"></HLink>
						<contact typeContact="closedContact" contactVariableName="SelectPressOrVac"></contact>
						<HLink nbCells="5"></HLink>
						<operateBlock width="4">
							<statement>InOut.Man_Setpoint:=0;</statement>
						</operateBlock>
					</typeLine>
					<typeLine>
						<HLink nbCells="1"></HLink>
						<contact typeContact="closedContact" contactVariableName="General.EMStopOkay"></contact>
						<HLink nbCells="1"></HLink>
						<emptyCell nbCells="17"></emptyCell>
					</typeLine>
					<typeLine>
						<HLink nbCells="1"></HLink>
						<contact typeContact="closedContact" contactVariableName="General.ManualMode"></contact>
						<shortCircuit>
							<VLink></VLink>
							<HLink nbCells="1"></HLink>
						</shortCircuit>
						<HLink nbCells="7"></HLink>
						<contact typeContact="closedContact" contactVariableName="SelectPressOrVac"></contact>
						<HLink nbCells="5"></HLink>
						<operateBlock width="4">
							<statement>Setpoint:= 0;</statement>
						</operateBlock>
					</typeLine>
					<typeLine>
						<emptyCell nbCells="2"></emptyCell>
						<VLink></VLink>
						<contact typeContact="openContact" contactVariableName="CMD"></contact>
						<HLink nbCells="12"></HLink>
						<operateBlock width="4">
							<statement>Setpoint:=Auto_Setpoint;</statement>
						</operateBlock>
					</typeLine>
					<typeLine>
						<emptyCell nbCells="3"></emptyCell>
						<contact typeContact="openContact" contactVariableName="FullyOpen"></contact>
						<HLink nbCells="12"></HLink>
						<operateBlock width="4">
							<statement>Setpoint:= 100;</statement>
						</operateBlock>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="2"></emptyLine>
					</typeLine>
					<typeLine>
						<emptyCell nbCells="4"></emptyCell>
						<FFBBlock instanceName="Convert_SP_Output_Purge" typeName="Analog" additionnalPinNumber="0" enEnO="true" width="16" height="8">
							<objPosition posX="4" posY="41"></objPosition>
							<descriptionFFB execAfter="">
								<inputVariable invertedPin="false" formalParameter="EN"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="Config" effectiveParameter="Sensor"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="Raw" effectiveParameter="Setpoint"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="InputHigh" effectiveParameter="100.0"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="InputLow" effectiveParameter="0.0"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="OutputHigh" effectiveParameter="10000.0"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="OutputLow" effectiveParameter="0.0"></inputVariable>
								<outputVariable invertedPin="false" formalParameter="ENO"></outputVariable>
								<outputVariable invertedPin="false" formalParameter="ActualValue" effectiveParameter="Setpoint_Analog"></outputVariable>
								<outputVariable invertedPin="false" formalParameter="Alarms"></outputVariable>
								<outputVariable invertedPin="false" formalParameter="ConfigFail"></outputVariable>
								<outputVariable invertedPin="false" formalParameter="MilliAmps"></outputVariable>
							</descriptionFFB>
						</FFBBlock>
						<emptyCell nbCells="14"></emptyCell>
					</typeLine>
					<typeLine>
						<HLink nbCells="4"></HLink>
						<emptyCell nbCells="16"></emptyCell>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="7"></emptyLine>
					</typeLine>
					<typeLine>
						<HLink nbCells="16"></HLink>
						<operateBlock width="4">
							<statement>Out.AnalogOut:=Setpoint_Analog;</statement>
						</operateBlock>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="2"></emptyLine>
					</typeLine>
					<typeLine>
						<contact typeContact="closedContact" contactVariableName="general.SimulationOn"></contact>
						<HLink nbCells="15"></HLink>
						<operateBlock width="4">
							<statement>MonitorTime:=t#60s;</statement>
						</operateBlock>
					</typeLine>
					<typeLine>
						<contact typeContact="openContact" contactVariableName="general.SimulationOn"></contact>
						<HLink nbCells="15"></HLink>
						<operateBlock width="4">
							<statement>MonitorTime:=t#40s;</statement>
						</operateBlock>
					</typeLine>
					<typeLine>
						<emptyCell nbCells="16"></emptyCell>
						<FFBBlock instanceName="TON_Alarm" typeName="TON" additionnalPinNumber="0" enEnO="false" width="10" height="4">
							<objPosition posX="16" posY="55"></objPosition>
							<descriptionFFB execAfter="">
								<inputVariable invertedPin="false" formalParameter="EN"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="IN"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="PT" effectiveParameter="MonitorTime"></inputVariable>
								<outputVariable invertedPin="false" formalParameter="ENO"></outputVariable>
								<outputVariable invertedPin="false" formalParameter="Q"></outputVariable>
								<outputVariable invertedPin="false" formalParameter="ET"></outputVariable>
							</descriptionFFB>
						</FFBBlock>
						<emptyCell nbCells="2"></emptyCell>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="1"></emptyLine>
					</typeLine>
					<typeLine>
						<HLink nbCells="2"></HLink>
						<contact typeContact="closedContact" contactVariableName="General.Alarm_Reset"></contact>
						<HLink nbCells="2"></HLink>
						<contact typeContact="openContact" contactVariableName="ABS((InOut.Position/10) - Setpoint) &gt; 5"></contact>
						<HLink nbCells="10"></HLink>
						<emptyCell nbCells="2"></emptyCell>
						<coil typeCoil="coil" coilVariableName="FollowingError"></coil>
						<HLink nbCells="1"></HLink>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="1"></emptyLine>
					</typeLine>
					<typeLine>
						<HLink nbCells="1"></HLink>
						<contact typeContact="openContact" contactVariableName="FollowingError"></contact>
						<shortCircuit>
							<VLink></VLink>
							<HLink nbCells="6"></HLink>
						</shortCircuit>
						<HLink nbCells="10"></HLink>
						<coil typeCoil="setCoil" coilVariableName="Out.Alarm"></coil>
						<HLink nbCells="1"></HLink>
					</typeLine>
