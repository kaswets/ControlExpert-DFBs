	<DDTSource DDTName="SensorConfig" version="0.01" dateTime="dt#2015-09-25-16:15:06">
		<comment>Hardware configuration of a sensor</comment>
		<attribute name="TypeSignatureCheckSumString" value="EED8"></attribute>
		<attribute name="TypeDataDicSubfieldsCount" value="5"></attribute>
		<structure>
			<variables name="ShowActualInput" typeName="BOOL">
				<comment>When set to "true" the sensor value is NOT limited to the outputhigh and outputloawvalues</comment>
			</variables>
			<variables name="OverflowPercentage" typeName="REAL">
				<comment>When the actual sensorvalue is over this value the sensor will generate a overflow warning</comment>
			</variables>
			<variables name="UnderflowPercentage" typeName="REAL">
				<comment>When the actual sensorvalue is under this value the sensor will generate a underflow warning</comment>
			</variables>
			<variables name="WirebreakPercentage" typeName="REAL">
				<comment>When the actual sensorvalue is under this value the sensor will generate a wirebreak alarm</comment>
			</variables>
		</structure>
	</DDTSource>
	<FBSource nameOfFBType="Analog" version="1.26" dateTime="dt#2025-09-14-13:02:11">
		<comment>Analog input scaling (scale inputinteger to outputinteger by selecting the range of the input and the range of the output)</comment>
		<attribute name="TypePassword" value=""></attribute>
		<attribute name="TypeProtectionLevel" value="2#0000_0000"></attribute>
		<attribute name="TypeCodeCheckSumString" value="4D42"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="98B5"></attribute>
		<attribute name="TypeDataDicSubfieldsCount" value="16"></attribute>
		<inputParameters>
			<variables name="Raw" typeName="INT">
				<comment>Raw value of the analog input</comment>
				<attribute name="PositionPin" value="2"></attribute>
			</variables>
			<variables name="InputHigh" typeName="REAL">
				<comment>High value of the input</comment>
				<attribute name="PositionPin" value="3"></attribute>
			</variables>
			<variables name="InputLow" typeName="REAL">
				<comment>Low value of the input</comment>
				<attribute name="PositionPin" value="4"></attribute>
			</variables>
			<variables name="OutputHigh" typeName="REAL">
				<comment>High value of the output</comment>
				<attribute name="PositionPin" value="5"></attribute>
			</variables>
			<variables name="OutputLow" typeName="REAL">
				<comment>Low value of the output</comment>
				<attribute name="PositionPin" value="6"></attribute>
			</variables>
			<variables name="Config" typeName="SensorConfig">
				<comment>Sensor configuration</comment>
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
		</inputParameters>
		<outputParameters>
			<variables name="ActualValue" typeName="INT">
				<comment>Actual value of the analog input</comment>
				<attribute name="PositionPin" value="2"></attribute>
			</variables>
			<variables name="Alarms" typeName="Analog_Alarms">
				<comment>Alarms and warning</comment>
				<attribute name="PositionPin" value="3"></attribute>
			</variables>
			<variables name="ConfigFail" typeName="BOOL">
				<comment>Configuration Error (the values of the inputHigh/low or output high/low is incorrect) value of high must be higher then low and not zero, value of low must be lower then high</comment>
				<attribute name="PositionPin" value="4"></attribute>
			</variables>
			<variables name="MilliAmps" typeName="UINT">
				<comment>Value of the input in milliamps</comment>
				<attribute name="PositionPin" value="5"></attribute>
			</variables>
		</outputParameters>
		<privateLocalVariables>
			<variables name="r_RAW" typeName="REAL">
				<comment>Converted value of the RAW input to real</comment>
			</variables>
			<variables name="WirebreakPercentage" typeName="REAL">
				<comment>5% of the Inputrange is </comment>
			</variables>
			<variables name="TON_Wirebreak" typeName="TON"></variables>
			<variables name="TON_Underflow" typeName="TON"></variables>
			<variables name="TON_Overflow" typeName="TON"></variables>
			<variables name="RealActualValue" typeName="REAL"></variables>
			<variables name="OverflowPercentage" typeName="REAL"></variables>
			<variables name="UnderflowPercentage" typeName="REAL"></variables>
			<variables name="tmpInputHigh" typeName="REAL"></variables>
			<variables name="tmpInputLow" typeName="REAL"></variables>
			<variables name="tmpOverflowPercentage" typeName="REAL"></variables>
			<variables name="tmpWirebreakPercentage" typeName="REAL"></variables>
			<variables name="tmpUnderflowPercentage" typeName="REAL"></variables>
			<variables name="milliAmpsReal" typeName="REAL"></variables>
		</privateLocalVariables>
		<FBProgram name="Main">
			<comment>Analog scaling</comment>
			<STSource>(* normal always use as input limits 0.0 to 10000.0 if they are not connected*)

if  not IS_PAR_CON (INP := InputHigh) then
	tmpInputHigh:=10000.0;
else
	tmpInputHigh:=InputHigh;
end_if;

if   Not IS_PAR_CON (INP := InputLow) then
	tmpInputLow:=0.0;
else
	tmpInputLow:=InputLow;
end_if;

(*Convert input to REAL for calculating*)

r_RAW		:=INT_TO_REAL(RAW);

(* Create configuration error when config is wrong *)
If tmpInputHigh &lt;= tmpInputLow OR OutputHigh &lt;= OutputLow THEN
	ConfigFail:=TRUE;
	ActualValue:=0;
ELSE
	ConfigFail:=FALSE;
	RealActualValue:=(((OutputHigh - OutputLow) / (tmpInputHigh - tmpInputLow)) * (r_Raw-tmpInputLow)) + OutputLow;

	if RealActualValue&lt;32766.0 THEN
		(*Copy Actual value to output*)
		ActualValue:=REAL_TO_INT(RealActualValue);
	end_if;

	(*Limit value to High and low output*)
	IF NOT Config.ShowActualInput THEN
		IF RealActualValue &gt; OutputHigh THEN
			ActualValue:=REAL_TO_INT(OutputHigh);
		END_IF;
		IF RealActualValue &lt; OutputLow THEN
			ActualValue:=REAL_TO_INT(OutputLow);
		END_IF;	
	END_IF;


	milliAmpsReal:=(((((20.0 - 4.0) / (tmpInputHigh - InputLow)) * (r_Raw-InputLow)) + 4.0)*100.0);

 	if milliAmpsReal&gt;0.0 then
		(* outputvalue in milliamps*)
		MilliAmps:=real_to_uint(((((20.0 - 4.0) / (tmpInputHigh - InputLow)) * (r_Raw-InputLow)) + 4.0)*100.0);
	end_if;



	if  not IS_PAR_CON (INP := Config.OverflowPercentage) then
		tmpOverflowPercentage:=2.0;
	else
		tmpOverflowPercentage:=Config.OverflowPercentage;
	end_if;

	if  not IS_PAR_CON (INP := Config.UnderflowPercentage) then
		tmpUnderflowPercentage:=1.0;
	else
		tmpUnderflowPercentage:=Config.UnderflowPercentage;
	end_if;

	if  not IS_PAR_CON (INP := Config.WirebreakPercentage) then
		tmpWirebreakPercentage:=4.0;
	else
		tmpWirebreakPercentage:=Config.WirebreakPercentage;
	end_if;

	(* get 5% of the range for setting wirebreak alarm *)
	OverflowPercentage:=((tmpInputHigh - tmpInputLow)*(tmpOverflowPercentage/100.0));
	UnderflowPercentage:=((tmpInputHigh - tmpInputLow)*(tmpUnderflowPercentage/100.0));
	WirebreakPercentage:=((tmpInputHigh - tmpInputLow)*(tmpWirebreakPercentage/100.0));
END_IF;
</STSource>
		</FBProgram>
		<FBProgram name="Alarms">
			<LDSource nbColumns="11">
				<networkLD>
					<typeLine>
						<emptyLine nbRows="1"></emptyLine>
					</typeLine>
					<typeLine>
						<emptyCell nbCells="7"></emptyCell>
						<FFBBlock instanceName="TON_Wirebreak" typeName="TON" additionnalPinNumber="0" enEnO="true" width="10" height="4">
							<objPosition posX="7" posY="1"></objPosition>
							<descriptionFFB execAfter="">
								<inputVariable invertedPin="false" formalParameter="EN"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="IN"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="PT" effectiveParameter="t#3s"></inputVariable>
								<outputVariable invertedPin="false" formalParameter="ENO"></outputVariable>
								<outputVariable invertedPin="false" formalParameter="Q"></outputVariable>
								<outputVariable invertedPin="false" formalParameter="ET"></outputVariable>
							</descriptionFFB>
						</FFBBlock>
						<emptyCell nbCells="2"></emptyCell>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="1"></emptyLine>
					</typeLine>
					<typeLine>
						<compareBlock width="2">
							<expression>r_RAW &lt;= (tmpInputLow-WirebreakPercentage)</expression>
						</compareBlock>
						<HLink nbCells="5"></HLink>
						<emptyCell nbCells="2"></emptyCell>
						<HLink nbCells="1"></HLink>
						<coil typeCoil="coil" coilVariableName="Alarms.WireBreak"></coil>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="3"></emptyLine>
					</typeLine>
					<typeLine>
						<emptyCell nbCells="7"></emptyCell>
						<FFBBlock instanceName="TON_Underflow" typeName="TON" additionnalPinNumber="0" enEnO="true" width="10" height="4">
							<objPosition posX="7" posY="7"></objPosition>
							<descriptionFFB execAfter="">
								<inputVariable invertedPin="false" formalParameter="EN"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="IN"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="PT" effectiveParameter="t#3s"></inputVariable>
								<outputVariable invertedPin="false" formalParameter="ENO"></outputVariable>
								<outputVariable invertedPin="false" formalParameter="Q"></outputVariable>
								<outputVariable invertedPin="false" formalParameter="ET"></outputVariable>
							</descriptionFFB>
						</FFBBlock>
						<emptyCell nbCells="2"></emptyCell>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="1"></emptyLine>
					</typeLine>
					<typeLine>
						<compareBlock width="2">
							<expression>r_RAW &lt; (tmpInputLow-UnderflowPercentage)</expression>
						</compareBlock>
						<HLink nbCells="1"></HLink>
						<contact typeContact="closedContact" contactVariableName="Alarms.WireBreak"></contact>
						<HLink nbCells="3"></HLink>
						<emptyCell nbCells="2"></emptyCell>
						<HLink nbCells="1"></HLink>
						<coil typeCoil="coil" coilVariableName="Alarms.UnderFlow"></coil>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="2"></emptyLine>
					</typeLine>
					<typeLine>
						<emptyCell nbCells="7"></emptyCell>
						<FFBBlock instanceName="TON_Overflow" typeName="TON" additionnalPinNumber="0" enEnO="true" width="10" height="4">
							<objPosition posX="7" posY="12"></objPosition>
							<descriptionFFB execAfter="">
								<inputVariable invertedPin="false" formalParameter="EN"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="IN"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="PT" effectiveParameter="t#3s"></inputVariable>
								<outputVariable invertedPin="false" formalParameter="ENO"></outputVariable>
								<outputVariable invertedPin="false" formalParameter="Q"></outputVariable>
								<outputVariable invertedPin="false" formalParameter="ET"></outputVariable>
							</descriptionFFB>
						</FFBBlock>
						<emptyCell nbCells="2"></emptyCell>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="1"></emptyLine>
					</typeLine>
					<typeLine>
						<compareBlock width="2">
							<expression>r_RAW &gt; (tmpInputHigh+OverflowPercentage)</expression>
						</compareBlock>
						<HLink nbCells="1"></HLink>
						<contact typeContact="closedContact" contactVariableName="Alarms.WireBreak"></contact>
						<HLink nbCells="3"></HLink>
						<emptyCell nbCells="2"></emptyCell>
						<HLink nbCells="1"></HLink>
						<coil typeCoil="coil" coilVariableName="Alarms.Overflow"></coil>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="85"></emptyLine>
					</typeLine>
					<textBox width="11" height="1">Create Overflowalarm
    <objPosition posX="0" posY="11"></objPosition>
					</textBox>
					<textBox width="11" height="1">Create Underflowalarm
    <objPosition posX="0" posY="6"></objPosition>
					</textBox>
					<textBox width="11" height="1">Create Sensorfailalarm
    <objPosition posX="0" posY="0"></objPosition>
					</textBox>
				</networkLD>
			</LDSource>
		</FBProgram>
	</FBSource>
	<FBSource nameOfFBType="PI_control" version="0.76" dateTime="dt#2021-09-01-15:26:10">
		<comment>een soort PI regeling - swets(c)</comment>
		<attribute name="TypeCodeCheckSumString" value="24DA"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="B787"></attribute>
		<attribute name="TypeDataDicSubfieldsCount" value="9"></attribute>
		<inputParameters>
			<variables name="wanted" typeName="INT">
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
			<variables name="actual" typeName="INT">
				<attribute name="PositionPin" value="2"></attribute>
			</variables>
			<variables name="kp" typeName="INT">
				<attribute name="PositionPin" value="3"></attribute>
			</variables>
			<variables name="ki" typeName="INT">
				<attribute name="PositionPin" value="4"></attribute>
			</variables>
			<variables name="kd" typeName="INT">
				<attribute name="PositionPin" value="5"></attribute>
			</variables>
		</inputParameters>
		<inOutParameters>
			<variables name="Last_error" typeName="REAL">
				<attribute name="PositionPin" value="6"></attribute>
			</variables>
			<variables name="MemdErr" typeName="REAL">
				<attribute name="PositionPin" value="7"></attribute>
			</variables>
		</inOutParameters>
		<outputParameters>
			<variables name="output" typeName="INT">
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
		</outputParameters>
		<privateLocalVariables>
			<variables name="rKp" typeName="REAL"></variables>
			<variables name="rKi" typeName="REAL"></variables>
			<variables name="ErrorSum" typeName="REAL"></variables>
			<variables name="tempOutput" typeName="REAL"></variables>
			<variables name="Error" typeName="REAL"></variables>
			<variables name="dErr" typeName="REAL"></variables>
			<variables name="rKd" typeName="REAL"></variables>
			<variables name="outP" typeName="REAL"></variables>
			<variables name="OutI" typeName="REAL"></variables>
			<variables name="OutD" typeName="REAL"></variables>
			<variables name="rKiOld" typeName="REAL"></variables>
		</privateLocalVariables>
		<FBProgram name="program_PI">
			<STSource>(* =================================================================================================== *)
(* PID regelaar simpele versie swets(c)                                                                *)
(*                                                                                                     *)
(* error is het verschil tussen de waarde waar de regeling naar toen moet (setpoint) en wat hij op dit *)
(* waar hij op dit moment is , actual is de feedback.                                                  *)
(*                                                                                                     *)
(* P :                                                                                                 *)
(*                                                                                                     *)
(* =================================================================================================== *)

Error:= int_to_real(wanted - actual);
if output&gt;0 and output&lt;10000 then
	ErrorSum := ErrorSum + (Error*0.01);
end_if;

dErr := (error-last_error)/0.02;

rKp := int_to_real( kp )/1000.0;
rKi := int_to_real( ki )/1000.0;
rKd := int_to_real( kd )/1000.0;


if rKi&lt;&gt;rKiOld then (* als rKi veranderd word aan de buitenkant *)
	errorSum:=OutI/rKi;
End_if;

rKiOld:=rKi;

outP:=(Error)*rkp;
OutI:=(ErrorSum) * rKi;
OutD:=rKd * dErr;

	TempOutput := outP + OutI + OutD; 


if TempOutput&lt;0.0 then
  TempOutput :=0.0;
end_if;

if TempOutput&gt;10000.0 then
  TempOutput := 10000.0;
end_if;


(*-------------------------------------------------------------------------------------------------------------*)
(* Naar de echte uitgang sturen                                                         *)
output:=real_to_int(tempOutput);


last_error:=error;
</STSource>
		</FBProgram>
	</FBSource>
</FBExchangeFile>
