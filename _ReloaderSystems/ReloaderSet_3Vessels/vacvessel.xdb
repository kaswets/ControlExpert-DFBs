					<textBox width="11" height="1">Valve output
    <objPosition posX="0" posY="28"></objPosition>
					</textBox>
					<textBox width="11" height="1">Status valve is in alarm
    <objPosition posX="0" posY="9"></objPosition>
					</textBox>
					<textBox width="11" height="1">Status valve is open
    <objPosition posX="0" posY="82"></objPosition>
					</textBox>
					<textBox width="11" height="1">Status valve is moving
    <objPosition posX="0" posY="63"></objPosition>
					</textBox>
					<textBox width="11" height="1">Reset manual control when not in manual mode
    <objPosition posX="0" posY="42"></objPosition>
					</textBox>
					<textBox width="1" height="1">Geel<objPosition posX="18" posY="65"></objPosition>
					</textBox>
					<textBox width="6" height="2">InOut.HmiControl.4  = touch button manual open/closed in het hmi scherm.

in het scherm word het bitje geset, hier , nadat dat gezien is, word het bitje weer gereset<objPosition posX="0" posY="0"></objPosition>
					</textBox>
					<textBox width="11" height="1">Copied from klepfout_NC_2es
    <objPosition posX="0" posY="49"></objPosition>
					</textBox>
					<textBox width="11" height="1">Manual bit -&gt; show touch switch on hmi screen
    <objPosition posX="0" posY="89"></objPosition>
					</textBox>
					<textBox width="11" height="1">Swap feedback when normally open is activated
    <objPosition posX="0" posY="13"></objPosition>
					</textBox>
					<textBox width="1" height="1">Rood<objPosition posX="16" posY="86"></objPosition>
					</textBox>
					<textBox width="11" height="1">Status valve is closed
    <objPosition posX="0" posY="78"></objPosition>
					</textBox>
					<textBox width="1" height="1">Groen<objPosition posX="16" posY="82"></objPosition>
					</textBox>
					<textBox width="11" height="1">Check if valve was open in auto when switching to manual<objPosition posX="0" posY="17"></objPosition>
					</textBox>
					<textBox width="1" height="1">Grijs<objPosition posX="16" posY="78"></objPosition>
					</textBox>
					<textBox width="11" height="1">Alarm
    <objPosition posX="0" posY="86"></objPosition>
					</textBox>
					<textBox width="11" height="1">Set buzzer on active alarm
    <objPosition posX="0" posY="60"></objPosition>
					</textBox>
				</networkLD>
			</LDSource>
		</FBProgram>
		<FBProgram name="ActiveTimeToHmi">
			<STSource>Secpuls:=%s6;


OutputActive:=Out.Output;


If re(OutputActive) then
	InOut.ActiveTime:=0;
end_if;

if OutputActive and re(Secpuls) then
	InOut.ActiveTime:=	InOut.ActiveTime+1;
end_if;
</STSource>
		</FBProgram>
		<FBProgram name="angle">
			<STSource>


if IS_PAR_CON (INP := Angle) then
		ShiftAngle (angle := ANGLE,
		              Status := InOut.HmiControl);
end_if;
</STSource>
		</FBProgram>
