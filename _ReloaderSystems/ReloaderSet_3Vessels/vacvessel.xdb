	<FBSource nameOfFBType="DValve" version="1.97" dateTime="dt#2025-04-04-08:00:36">
		<comment>Digital valve function Normally closed</comment>
		<attribute name="TypeCodeCheckSumString" value="F17B"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="6735"></attribute>
		<attribute name="TypeDataDicSubfieldsCount" value="32"></attribute>
		<inputParameters>
			<variables name="Valve_Command" typeName="BOOL">
				<comment>Auto command valve</comment>
				<attribute name="PositionPin" value="4"></attribute>
			</variables>
			<variables name="Angle" typeName="WORD">
				<attribute name="PositionPin" value="6"></attribute>
			</variables>
			<variables name="System" typeName="INT">
				<comment>Valve party of silo system 1= 1, 2=2 or 3 is both</comment>
				<attribute name="PositionPin" value="7"></attribute>
			</variables>
			<variables name="BlockManual" typeName="BOOL">
				<attribute name="PositionPin" value="8"></attribute>
			</variables>
			<variables name="In" typeName="DValve_In">
				<attribute name="PositionPin" value="2"></attribute>
			</variables>
			<variables name="Enable" typeName="BOOL">
				<comment>Valve is enabled. Alarms are suppressed when the valve is not enabled</comment>
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
		</inputParameters>
		<inOutParameters>
			<variables name="InOut" typeName="DValve_InOut">
				<comment>InOut Signals</comment>
				<attribute name="PositionPin" value="3"></attribute>
			</variables>
			<variables name="General" typeName="General">
				<comment>General struct used in almost all function blocks</comment>
				<attribute name="PositionPin" value="5"></attribute>
			</variables>
		</inOutParameters>
		<outputParameters>
			<variables name="Out" typeName="DValve_Out">
				<comment>Output signals</comment>
				<attribute name="PositionPin" value="2"></attribute>
			</variables>
			<variables name="travelActiveTime" typeName="INT">
				<attribute name="PositionPin" value="6"></attribute>
			</variables>
			<variables name="travelDeactiveTime" typeName="INT">
				<attribute name="PositionPin" value="7"></attribute>
			</variables>
		</outputParameters>
		<publicLocalVariables>
			<variables name="Parameters" typeName="DValve_Param">
				<comment>Valve parameters</comment>
			</variables>
		</publicLocalVariables>
		<privateLocalVariables>
			<variables name="TOF_DelayOut" typeName="TOF"></variables>
			<variables name="TOF_Valve_2" typeName="TOF"></variables>
			<variables name="TOF_Valve_3" typeName="TOF"></variables>
			<variables name="TON_Alarm" typeName="TON"></variables>
			<variables name="Feedback_Open" typeName="BOOL"></variables>
			<variables name="Feedback_Closed" typeName="BOOL"></variables>
			<variables name="Delayed_Output" typeName="BOOL"></variables>
			<variables name="mOutput" typeName="BOOL"></variables>
			<variables name="TOF_1" typeName="TOF"></variables>
			<variables name="ValveStartMoving" typeName="BOOL"></variables>
			<variables name="BtnManual" typeName="BOOL"></variables>
			<variables name="ShiftAngle" typeName="RotateValve"></variables>
			<variables name="ThisValveInManual" typeName="EBOOL"></variables>
			<variables name="ExtraManualBlock" typeName="BOOL"></variables>
			<variables name="MeasureTime_reactionActive" typeName="MeasureTime2in"></variables>
			<variables name="MeasureTimeTravelActive" typeName="MeasureTime2in"></variables>
			<variables name="MeasureTime_reactionDeActive" typeName="MeasureTime2in"></variables>
			<variables name="MeasureTimeTravelDeActive" typeName="MeasureTime2in"></variables>
			<variables name="tmpReactActive" typeName="INT"></variables>
			<variables name="tmpReactDeactive" typeName="INT"></variables>
			<variables name="Secpuls" typeName="EBOOL"></variables>
			<variables name="OutputActive" typeName="EBOOL"></variables>
		</privateLocalVariables>
		<FBProgram name="Info">
			<STSource>(*																					*)
(* D_valve veranderd. (JB werstuurde 2 x 16bits naar het scherm, terwijl in de ene int alleen maar 0 of 1 staat, voor de manual knop					*)
(*																					*)
(* op die manier stuur je heel veel naar het scherm heen en weer, wat niet nodig is) het geheel veranderd, sturen nu nog maar 1 woord naar het scherm met daarin	*)	
(*																					*)
(* bit 0 &gt;&gt;&gt;   0=closed(grijs) / 1=open(groen)																*)
(* bit 1 &gt;&gt;&gt;  1=Moving (geel), dit als beide eindschakelaars weg zijn)													*)
(* bit 2 &gt;&gt;&gt;  1= alarm (rood)																		*)
(* Bit 3 &gt;&gt;&gt; 1=manaul touch button visual and active															*)
(* Bit 4 &gt;&gt;&gt; touch manual button																	*)
(*																					*)
(* bit5 tot Bit13 = hoek van de klep op het HMI van 0 tot 360 graden													*)													

(* De vorige klep kon alleen maar gedraaid worden in stappen van 90 graden, daardoor kon ik nooit een klep schui platen... nu kan de klep 360 draaien.
(*																					*)
(*																					*)
(*																					*)


</STSource>
		</FBProgram>
		<FBProgram name="BlockManual">
			<STSource>if IS_PAR_CON (INP := BlockManual) then
	ExtraManualBlock:=BlockManual;
else
	ExtraManualBlock:=false;
end_if;
</STSource>
		</FBProgram>
		<FBProgram name="ValveNew">
			<LDSource nbColumns="20">
				<networkLD>
					<typeLine>
						<emptyLine nbRows="2"></emptyLine>
					</typeLine>
					<typeLine>
						<HLink nbCells="1"></HLink>
						<contact typeContact="PContact" contactVariableName="InOut.HmiControl.4"></contact>
						<shortCircuit>
							<VLink></VLink>
							<HLink nbCells="1"></HLink>
						</shortCircuit>
						<HLink nbCells="1"></HLink>
						<contact typeContact="openContact" contactVariableName="BtnManual"></contact>
						<shortCircuit>
							<VLink></VLink>
							<HLink nbCells="11"></HLink>
						</shortCircuit>
						<coil typeCoil="resetCoil" coilVariableName="BtnManual"></coil>
						<HLink nbCells="3"></HLink>
					</typeLine>
					<typeLine>
						<emptyCell nbCells="2"></emptyCell>
						<VLink></VLink>
						<emptyCell nbCells="13"></emptyCell>
						<control typeControl="jumpCoil" label="next"></control>
						<emptyCell nbCells="3"></emptyCell>
					</typeLine>
					<typeLine>
						<emptyCell nbCells="3"></emptyCell>
						<HLink nbCells="1"></HLink>
						<contact typeContact="closedContact" contactVariableName="btnManual"></contact>
						<HLink nbCells="11"></HLink>
						<coil typeCoil="setCoil" coilVariableName="BtnManual"></coil>
						<HLink nbCells="3"></HLink>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="1"></emptyLine>
					</typeLine>
					<typeLine>
						<labelCell label="next">
							<objPosition posX="0" posY="6"></objPosition>
						</labelCell>
						<emptyCell nbCells="19"></emptyCell>
					</typeLine>
					<typeLine>
						<HLink nbCells="17"></HLink>
						<coil typeCoil="resetCoil" coilVariableName="InOut.HmiControl.4"></coil>
						<HLink nbCells="2"></HLink>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="2"></emptyLine>
					</typeLine>
					<typeLine>
						<HLink nbCells="1"></HLink>
						<contact typeContact="openContact" contactVariableName="General.Alarm_Reset"></contact>
						<shortCircuit>
							<VLink></VLink>
							<HLink nbCells="3"></HLink>
						</shortCircuit>
						<HLink nbCells="13"></HLink>
						<coil typeCoil="resetCoil" coilVariableName="Out.Alarm"></coil>
						<HLink nbCells="1"></HLink>
					</typeLine>
					<typeLine>
						<HLink nbCells="1"></HLink>
						<contact typeContact="closedContact" contactVariableName="Enable"></contact>
						<HLink nbCells="3"></HLink>
						<emptyCell nbCells="15"></emptyCell>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="2"></emptyLine>
					</typeLine>
					<typeLine>
						<HLink nbCells="2"></HLink>
						<contact typeContact="openContact" contactVariableName="In.FB_Open"></contact>
						<HLink nbCells="15"></HLink>
						<coil typeCoil="coil" coilVariableName="Feedback_Open"></coil>
						<HLink nbCells="1"></HLink>
					</typeLine>
					<typeLine>
