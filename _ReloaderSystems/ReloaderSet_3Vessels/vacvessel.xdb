	<DDTSource DDTName="DValve_Param" version="0.08" dateTime="dt#2019-08-28-13:35:22">
		<comment>Parameters which can be used to change a valve's behaviour while still using the same FB</comment>
		<attribute name="TypeSignatureCheckSumString" value="4882"></attribute>
		<attribute name="TypeDataDicSubfieldsCount" value="7"></attribute>
		<structure>
			<variables name="NormallyOpen" typeName="BOOL">
				<comment>0=Normally Closed, 1=Normally Open</comment>
			</variables>
			<variables name="Delayed_ReturnOutput" typeName="TIME">
				<comment>Delay the signal when the output is removed (only output)</comment>
			</variables>
			<variables name="Delayed_Return" typeName="TIME">
				<comment>Delay the signal when the output is removed (output and status)</comment>
			</variables>
			<variables name="Clino_Enable" typeName="BOOL">
				<comment>Enable the clino function for valves</comment>
			</variables>
			<variables name="Clino_Signal" typeName="BOOL">
				<comment>Close the valve when Clino signal comes</comment>
			</variables>
			<variables name="MonitorTime" typeName="TIME">
				<comment>Time the valve is moving from open to closed/closed to open</comment>
			</variables>
		</structure>
	</DDTSource>
	<FBSource nameOfFBType="RotateValve" version="0.07" dateTime="dt#2021-08-18-14:19:29">
		<attribute name="TypeCodeCheckSumString" value="2A09"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="2E22"></attribute>
		<attribute name="TypeDataDicSubfieldsCount" value="3"></attribute>
		<inputParameters>
			<variables name="angle" typeName="WORD">
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
		</inputParameters>
		<inOutParameters>
			<variables name="Status" typeName="WORD">
				<attribute name="PositionPin" value="2"></attribute>
			</variables>
		</inOutParameters>
		<privateLocalVariables>
			<variables name="Wrd_angle" typeName="WORD"></variables>
		</privateLocalVariables>
		<FBProgram name="Prg">
			<STSource>Wrd_angle:= SHL_WORD (IN := angle, N := 5); 

Status:=Status or Wrd_angle;



</STSource>
		</FBProgram>
	</FBSource>
	<FBSource nameOfFBType="MeasureTime2in" version="0.11" dateTime="dt#2025-04-04-08:00:36">
		<attribute name="TypeCodeCheckSumString" value="006F"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="1288"></attribute>
		<attribute name="TypeDataDicSubfieldsCount" value="6"></attribute>
		<inputParameters>
			<variables name="startPuls" typeName="EBOOL">
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
			<variables name="StopPuls" typeName="EBOOL">
				<attribute name="PositionPin" value="2"></attribute>
			</variables>
		</inputParameters>
		<outputParameters>
			<variables name="TimeLength" typeName="DINT">
				<comment>/ 1000 = mSec</comment>
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
			<variables name="length_mS" typeName="INT">
				<comment>mSec</comment>
				<attribute name="PositionPin" value="2"></attribute>
			</variables>
			<variables name="Length_sec" typeName="INT">
				<attribute name="PositionPin" value="3"></attribute>
			</variables>
		</outputParameters>
		<privateLocalVariables>
			<variables name="startTime" typeName="DINT"></variables>
			<variables name="StopTime" typeName="DINT"></variables>
		</privateLocalVariables>
		<FBProgram name="prg">
			<STSource>




if re(StartPuls) or %s13 then
	startTime:=FREERUN ();
end_if;

if re(StopPuls) or %s13  then
	StopTime:=FREERUN ();

	if stoptime&gt;starttime and Stoptime&gt;0 and Starttime&gt;0 then
		TimeLength:=abs(stoptime-starttime);
		length_mS:=dint_to_int(TimeLength/1000);
		Length_sec:=length_mS/1000;
	end_if;
end_if;
</STSource>
		</FBProgram>
	</FBSource>
	<FBSource nameOfFBType="Filterpulse" version="1.11" dateTime="dt#2022-07-07-12:11:57">
		<comment>The filter pulse is used to blow air in a cloth at the bottom of a tank or clean the filters in a Tank. It has configurable valves without feedback and when the input PulseOn is 1 the cycling is started with valve 1 set to 1 for the time set in pulselenght this time is in ms. When this time is over the time set in pulsegap in seconds determines the gap before valve 2 is set to 1 for the time in pulselength and so on.</comment>
		<attribute name="TypePassword" value=""></attribute>
		<attribute name="TypeProtectionLevel" value="2#0000_0000"></attribute>
		<attribute name="TypeCodeCheckSumString" value="A445"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="19FA"></attribute>
		<attribute name="TypeDataDicSubfieldsCount" value="11"></attribute>
		<inputParameters>
			<variables name="Num_valves" typeName="INT">
				<comment>Number of valves (1 to 15)</comment>
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
			<variables name="parameters" typeName="FilterPulse_Parameters">
				<comment>Filterpulse parameters</comment>
				<attribute name="PositionPin" value="2"></attribute>
			</variables>
			<variables name="PulseOn" typeName="BOOL">
				<comment>Start Filterpulse</comment>
				<attribute name="PositionPin" value="3"></attribute>
			</variables>
			<variables name="ShowHMItime" typeName="TIME">
				<attribute name="PositionPin" value="4"></attribute>
			</variables>
		</inputParameters>
		<outputParameters>
			<variables name="Valves" typeName="Filterpulse_Outputs">
				<comment>Valves 1 to 15</comment>
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
			<variables name="Pulse" typeName="BOOL">
				<comment>Filterpulse running</comment>
				<attribute name="PositionPin" value="2"></attribute>
			</variables>
			<variables name="hmiShowFP" typeName="WORD">
				<attribute name="PositionPin" value="3"></attribute>
			</variables>
		</outputParameters>
		<privateLocalVariables>
			<variables name="TON_GapLength" typeName="TON">
				<comment>TON timer Gap length between pulses</comment>
			</variables>
			<variables name="TOF_PulseLength" typeName="TOF">
				<comment>TOF timer Pulselength</comment>
			</variables>
			<variables name="TempIntToTime" typeName="TIME">
				<comment>Pulselength in milliseconds (t#..ms)</comment>
			</variables>
			<variables name="TempIntToTime2" typeName="TIME">
				<comment>Pulsegap in seconds (t#..s)</comment>
			</variables>
			<variables name="value" typeName="INT">
				<comment>Current value of the counter</comment>
			</variables>
			<variables name="TON_Running" typeName="TON">
				<comment>Filterpulse running delay</comment>
			</variables>
			<variables name="Int_To_Time_Length" typeName="Int_To_Time2"></variables>
			<variables name="Int_To_Time2_Gap" typeName="Int_To_Time2"></variables>
			<variables name="TimeShowHMI" typeName="TON"></variables>
		</privateLocalVariables>
		<FBProgram name="Main">
			<comment>The filterpulse contains 3 valves that blows out air on at a time depending on the pulsegap and pulselength</comment>
			<LDSource nbColumns="11">
				<networkLD>
					<typeLine>
						<emptyLine nbRows="3"></emptyLine>
					</typeLine>
					<typeLine>
						<emptyCell nbCells="4"></emptyCell>
						<FFBBlock instanceName="Int_To_Time_Length" typeName="Int_To_Time2" additionnalPinNumber="0" enEnO="true" width="12" height="4">
							<objPosition posX="4" posY="3"></objPosition>
							<descriptionFFB execAfter="">
								<inputVariable invertedPin="false" formalParameter="EN"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="In" effectiveParameter="Parameters.SP_PulseLength"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="Select" effectiveParameter="0"></inputVariable>
								<outputVariable invertedPin="false" formalParameter="ENO"></outputVariable>
								<outputVariable invertedPin="false" formalParameter="Out" effectiveParameter="TempIntToTime"></outputVariable>
							</descriptionFFB>
						</FFBBlock>
						<emptyCell nbCells="5"></emptyCell>
					</typeLine>
					<typeLine>
						<HLink nbCells="4"></HLink>
						<emptyCell nbCells="7"></emptyCell>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="3"></emptyLine>
					</typeLine>
					<typeLine>
						<emptyCell nbCells="4"></emptyCell>
						<FFBBlock instanceName="Int_To_Time2_Gap" typeName="Int_To_Time2" additionnalPinNumber="0" enEnO="true" width="12" height="4">
							<objPosition posX="4" posY="8"></objPosition>
							<descriptionFFB execAfter="">
								<inputVariable invertedPin="false" formalParameter="EN"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="In" effectiveParameter="Parameters.SP_PulseGap"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="Select" effectiveParameter="1"></inputVariable>
								<outputVariable invertedPin="false" formalParameter="ENO"></outputVariable>
								<outputVariable invertedPin="false" formalParameter="Out" effectiveParameter="TempIntToTime2"></outputVariable>
							</descriptionFFB>
						</FFBBlock>
						<emptyCell nbCells="5"></emptyCell>
					</typeLine>
					<typeLine>
						<HLink nbCells="4"></HLink>
						<emptyCell nbCells="7"></emptyCell>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="4"></emptyLine>
					</typeLine>
					<typeLine>
						<emptyCell nbCells="7"></emptyCell>
						<FFBBlock instanceName="TOF_PulseLength" typeName="TOF" additionnalPinNumber="0" enEnO="true" width="10" height="4">
							<objPosition posX="7" posY="14"></objPosition>
							<descriptionFFB execAfter="">
								<inputVariable invertedPin="false" formalParameter="EN"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="IN"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="PT" effectiveParameter="TempIntToTime"></inputVariable>
								<outputVariable invertedPin="false" formalParameter="ENO"></outputVariable>
								<outputVariable invertedPin="false" formalParameter="Q"></outputVariable>
								<outputVariable invertedPin="false" formalParameter="ET"></outputVariable>
							</descriptionFFB>
						</FFBBlock>
						<emptyCell nbCells="2"></emptyCell>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="1"></emptyLine>
