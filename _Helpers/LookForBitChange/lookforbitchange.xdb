	<FBSource nameOfFBType="LookForBitChange" version="0.09" dateTime="dt#2022-09-01-13:53:24">
		<attribute name="TypeCodeCheckSumString" value="BC8F"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="2080"></attribute>
		<attribute name="TypeDataDicSubfieldsCount" value="5"></attribute>
		<inputParameters>
			<variables name="ChoiceWrd" typeName="WORD">
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
			<variables name="PreChoiceWrd" typeName="WORD">
				<attribute name="PositionPin" value="2"></attribute>
			</variables>
		</inputParameters>
		<inOutParameters>
