				<attribute name="PositionPin" value="5"></attribute>
			</variables>
			<variables name="ChangeOffWrd" typeName="WORD">
				<attribute name="PositionPin" value="6"></attribute>
			</variables>
		</inOutParameters>
		<FBProgram name="prg">
			<STSource>

(* Check if a bit is turn On or Off*)


if ChoiceWrd.0=True and PreChoiceWrd.0=False then (*now On, previous cycle Off, so it's turned on*)
	ChangeOnWrd.0:=true;
end_if;
if ChoiceWrd.0=False and PreChoiceWrd.0=True then (*now Off, previous cycle On, so it's turned off*)
	ChangeOffWrd.0:=true;
end_if;

if ChoiceWrd.1=True and PreChoiceWrd.1=False then (*now On, previous cycle Off, so it's turned on*)
	ChangeOnWrd.1:=true;
end_if;
