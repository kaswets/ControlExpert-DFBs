Dummy:=ActualPressBothSides[11];
Dummy:=ActualPressBothSides[12];


Dummy:=EmptyPressBothSides[1];
Dummy:=EmptyPressBothSides[2];
Dummy:=EmptyPressBothSides[3];
Dummy:=EmptyPressBothSides[4];
Dummy:=EmptyPressBothSides[5];
Dummy:=EmptyPressBothSides[6];
Dummy:=EmptyPressBothSides[7];
Dummy:=EmptyPressBothSides[8];
Dummy:=EmptyPressBothSides[9];
Dummy:=EmptyPressBothSides[10];
Dummy:=EmptyPressBothSides[11];
