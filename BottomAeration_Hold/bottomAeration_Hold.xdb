							<objPosition posX="4" posY="64"></objPosition>
							<descriptionFFB execAfter="">
								<inputVariable invertedPin="false" formalParameter="EN"></inputVariable>
								<inputVariable invertedPin="true" formalParameter="IN"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="PT" effectiveParameter="t#1S"></inputVariable>
								<outputVariable invertedPin="false" formalParameter="ENO"></outputVariable>
								<outputVariable invertedPin="false" formalParameter="Q" effectiveParameter="Pulse"></outputVariable>
								<outputVariable invertedPin="false" formalParameter="ET"></outputVariable>
							</descriptionFFB>
						</FFBBlock>
						<emptyCell nbCells="5"></emptyCell>
					</typeLine>
