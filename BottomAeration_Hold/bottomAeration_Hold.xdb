	<DDTSource DDTName="General" version="0.54" dateTime="dt#2026-06-04-10:47:56">
		<comment>General struct used in most functionblocks</comment>
		<attribute name="TypeSignatureCheckSumString" value="269D"></attribute>
		<attribute name="TypeDataDicSubfieldsCount" value="6"></attribute>
		<structure>
			<variables name="Word1" typeName="WORD">
				<comment>ControlWord</comment>
			</variables>
			<variables name="Alarm_Active" typeName="BOOL">
				<comment>Alarm is active</comment>
				<attribute name="ExtractBit" value="0"></attribute>
			</variables>
			<variables name="Alarm_Reset" typeName="BOOL">
				<comment>Command reset alarm</comment>
				<attribute name="ExtractBit" value="1"></attribute>
			</variables>
			<variables name="W1B2" typeName="BOOL">
				<comment>Manual mode is active</comment>
				<attribute name="ExtractBit" value="2"></attribute>
			</variables>
