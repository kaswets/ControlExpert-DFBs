					</typeLine>
					<typeLine>
						<HLink nbCells="2"></HLink>
						<contact typeContact="openContact" contactVariableName="IS_PAR_CON (INP := System)"></contact>
						<HLink nbCells="5"></HLink>
						<contact typeContact="openContact" contactVariableName="ManualActive"></contact>
						<HLink nbCells="5"></HLink>
						<contact typeContact="closedContact" contactVariableName="General.ManualPressWhileBlocked"></contact>
						<HLink nbCells="3"></HLink>
						<coil typeCoil="coil" coilVariableName="ThisValveInManual"></coil>
						<HLink nbCells="1"></HLink>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="1"></emptyLine>
					</typeLine>
					<typeLine>
						<emptyCell nbCells="3"></emptyCell>
						<FFBBlock instanceName="TOF_DelayOut" typeName="TOF" additionnalPinNumber="0" enEnO="true" width="10" height="4">
							<objPosition posX="3" posY="20"></objPosition>
							<descriptionFFB execAfter="">
								<inputVariable invertedPin="false" formalParameter="EN"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="IN"></inputVariable>
								<inputVariable invertedPin="false" formalParameter="PT" effectiveParameter="T#100ms"></inputVariable>
								<outputVariable invertedPin="false" formalParameter="ENO"></outputVariable>
								<outputVariable invertedPin="false" formalParameter="Q" effectiveParameter="Delayed_Output"></outputVariable>
