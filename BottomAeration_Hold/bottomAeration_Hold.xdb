					<typeLine>
						<HLink nbCells="2"></HLink>
						<contact typeContact="openContact" contactVariableName="In.FB_Open"></contact>
						<HLink nbCells="14"></HLink>
						<coil typeCoil="coil" coilVariableName="Feedback_Open"></coil>
