					<typeLine>
						<HLink nbCells="1"></HLink>
						<contact typeContact="openContact" contactVariableName="value=0"></contact>
						<HLink nbCells="2"></HLink>
						<emptyCell nbCells="7"></emptyCell>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="33"></emptyLine>
					</typeLine>
					<textBox width="11" height="1">Gaplength timer
    <objPosition posX="0" posY="14"></objPosition>
					</textBox>
					<textBox width="11" height="1">Convert integer to time
    <objPosition posX="0" posY="3"></objPosition>
					</textBox>
					<textBox width="11" height="1">open valves one at a time, first 1 then 2 then 3 enz.<objPosition posX="0" posY="26"></objPosition>
					</textBox>
					<textBox width="11" height="2">The filter pulse is used to blow air in a cloth at the bottom of a tank or clean the filters in a Ventfilter. 
when the input PulseOn is 1 the cycling is started with valve 1 set to 1 for the time set in pulselenght this time is in ms. 
When this time is over the time set in pulsegap in seconds determines the gap before valve 2 is set to 1 for the time in pulselength and so on.<objPosition posX="0" posY="0"></objPosition>
					</textBox>
					<textBox width="11" height="1">reset pulses when off
    <objPosition posX="0" posY="60"></objPosition>
					</textBox>
					<textBox width="11" height="1">Filterpulse running
    <objPosition posX="0" posY="63"></objPosition>
					</textBox>
					<textBox width="11" height="1">open valves one at a time, firt 1 then 2 then 3 enz.
    <objPosition posX="0" posY="45"></objPosition>
					</textBox>
					<textBox width="11" height="1">Gaplength timer
    <objPosition posX="0" posY="20"></objPosition>
					</textBox>
				</networkLD>
			</LDSource>
		</FBProgram>
	</FBSource>
	<DDTSource DDTName="ValveControl" version="0.05" dateTime="dt#2021-03-11-22:07:28">
		<comment>Valve control used for bottom aeration containing 32 bits for 32 valves</comment>
		<attribute name="TypeSignatureCheckSumString" value="9C11"></attribute>
		<attribute name="TypeDataDicSubfieldsCount" value="2"></attribute>
		<structure>
			<variables name="ControlWord1" typeName="WORD">
				<comment>controlword containing 16 bits</comment>
			</variables>
			<variables name="Step1" typeName="BOOL">
				<comment>Signal valve</comment>
				<attribute name="ExtractBit" value="0"></attribute>
			</variables>
			<variables name="Step2" typeName="BOOL">
				<comment>Signal valve</comment>
				<attribute name="ExtractBit" value="1"></attribute>
			</variables>
			<variables name="Step3" typeName="BOOL">
				<comment>Signal valve</comment>
				<attribute name="ExtractBit" value="2"></attribute>
			</variables>
			<variables name="Step4" typeName="BOOL">
				<comment>Signal valve</comment>
				<attribute name="ExtractBit" value="3"></attribute>
			</variables>
			<variables name="Step5" typeName="BOOL">
				<comment>Signal valve</comment>
				<attribute name="ExtractBit" value="4"></attribute>
			</variables>
			<variables name="Step6" typeName="BOOL">
				<comment>Signal valve</comment>
				<attribute name="ExtractBit" value="5"></attribute>
			</variables>
			<variables name="Step7" typeName="BOOL">
				<comment>Signal valve</comment>
				<attribute name="ExtractBit" value="6"></attribute>
			</variables>
			<variables name="Step8" typeName="BOOL">
				<comment>Signal valve</comment>
				<attribute name="ExtractBit" value="7"></attribute>
			</variables>
			<variables name="Step9" typeName="BOOL">
				<comment>Signal valve</comment>
				<attribute name="ExtractBit" value="8"></attribute>
			</variables>
			<variables name="Step10" typeName="BOOL">
				<comment>Signal valve</comment>
