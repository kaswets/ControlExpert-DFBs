		</privateLocalVariables>
		<FBProgram name="Info">
			<STSource>(*																					*)
(* D_valve veranderd. (JB werstuurde 2 x 16bits naar het scherm, terwijl in de ene int alleen maar 0 of 1 staat, voor de manual knop					*)
(*																					*)
(* op die manier stuur je heel veel naar het scherm heen en weer, wat niet nodig is) het geheel veranderd, sturen nu nog maar 1 woord naar het scherm met daarin	*)	
(*																					*)
(* bit 0 &gt;&gt;&gt;   0=closed(grijs) / 1=open(groen)																*)
(* bit 1 &gt;&gt;&gt;  1=Moving (geel), dit als beide eindschakelaars weg zijn)													*)
(* bit 2 &gt;&gt;&gt;  1= alarm (rood)																		*)
(* Bit 3 &gt;&gt;&gt; 1=manaul touch button visual and active															*)
(* Bit 4 &gt;&gt;&gt; touch manual button																	*)
(*																					*)
(* bit5 tot Bit13 = hoek van de klep op het HMI van 0 tot 360 graden													*)													

(* De vorige klep kon alleen maar gedraaid worden in stappen van 90 graden, daardoor kon ik nooit een klep schui platen... nu kan de klep 360 draaien.
(*																					*)
(*																					*)
(* ─────────────────────────────────────────────────────────────────
   BitCheck_SystemIn: splits het System-woord op in losse bits
   Bit 0 = Fore systeem        (waarde 1)
   Bit 1 = Aft systeem         (waarde 2)
   Bit 2 = Lubrication systeem (waarde 4)
   Bit 3 = EXACT-vlag: HMI manual-knoppen moeten exact overeenkomen
           met de groepsindeling van deze klep
   ───────────────────────────────────────────────────────────────── *)

</STSource>
		</FBProgram>
		<FBProgram name="NewManual">
			<STSource>(* Converteer System integer naar WORD voor bitverwerking *)
wSystem := Int_To_word(System);

(* ─────────────────────────────────────────────────────────────────
   BitCheck_SystemIn: splits het System-woord op in losse bits
   Bit 0 = Fore systeem        (waarde 1)
   Bit 1 = Aft systeem         (waarde 2)
   Bit 2 = Lubrication systeem (waarde 4)
   Bit 3 = EXACT-vlag: HMI manual-knoppen moeten exact overeenkomen
           met de groepsindeling van deze klep
   ───────────────────────────────────────────────────────────────── *)
BitCheck_SystemIn (WrdIn := wSystem,
                   ValueOut =&gt; SystemIn_Out,
                   Bit0 =&gt; SystemInB0,
                   Bit1 =&gt; SystemInB1,
                   Bit2 =&gt; SystemInB2,
                   Bit3 =&gt; SystemInB3,
                   Bit4 =&gt; SystemInB4,
                   Bit5 =&gt; SystemInB5,
                   Bit6 =&gt; SystemInB6,
                   Bit7 =&gt; SystemInB7,
                   Bit8 =&gt; SystemInB8,
                   Bit9 =&gt; SystemInB9,
                   Bit10 =&gt; SystemInB10,
                   Bit11 =&gt; SystemInB11,
                   Bit12 =&gt; SystemInB12,
                   Bit13 =&gt; SystemInB13,
                   Bit14 =&gt; SystemInB14,
                   Bit15 =&gt; SystemInB15,
                   NumberOffBits =&gt; SystemNBBits);

(* ─────────────────────────────────────────────────────────────────
   BitCheck_GeneralMan: splits het HMI manual-woord op in losse bits
   Bit 0 = Systeem 1 (Fore) in manual gezet via HMI
   Bit 1 = Systeem 2 (Aft) in manual gezet via HMI
   Bit 2 = Lubrication actief gezet via HMI
   ───────────────────────────────────────────────────────────────── *)
BitCheck_GeneralMan (WrdIn := General.Manual.wrd,
                   ValueOut =&gt; GeneralManual_Out,
                   Bit0 =&gt; GeneralManualB0,		(* System 1 Manual *)
                   Bit1 =&gt; GeneralManualB1,		(* System 2 Manual *)
                   Bit2 =&gt; GeneralManualB2,		(* System 3 Manual *)
                   Bit3 =&gt; GeneralManualB3,		(* System 4 Manual *)
                   Bit4 =&gt; GeneralManualB4,
                   Bit5 =&gt; GeneralManualB5,		(* Force Manual 1 *)
                   Bit6 =&gt; GeneralManualB6,		(* Force Manual 2 *)
                   Bit7 =&gt; GeneralManualB7,
                   Bit8 =&gt; GeneralManualB8,		(* Block Manual System 1 *)
                   Bit9 =&gt; GeneralManualB9,		(* Block Manual System 2 *)
                   Bit10 =&gt; GeneralManualB10,
                   Bit11 =&gt; GeneralManualB11,
                   Bit12 =&gt; GeneralManualB12,
                   Bit13 =&gt; GeneralManualB13,
                   Bit14 =&gt; GeneralManualB14,
                   Bit15 =&gt; GeneralManualB15,
                   NumberOffBits =&gt; GeneralManualNBBits);

(* Haal alleen de 3 groepsbits op uit het System-woord (Fore/Aft/Lub) *)
ManualGroep := SystemIn_Out &amp; 2#0000000000000111;

(* Haal de HMI manual-knoppen op (8 bits, Fore/Aft/Lub en reserve) *)
GeneralGroep := GeneralManual_Out &amp; 2#0000000011111111;

(* ─────────────────────────────────────────────────────────────────
   Bepaal of deze klep in ManualActive moet gaan

   System waarden zonder EXACT-vlag (bit3=0, waarde &lt; 8):
     1  = alleen Fore
     2  = alleen Aft
     3  = Fore of Aft
     4  = alleen Lubrication
   → LOOSE: klep gaat in manual als MINSTENS ÉÉN van zijn
     groepsbits overeenkomt met de actieve HMI manual-knoppen

   System waarden met EXACT-vlag (bit3=1, waarde &gt;= 8):
     11 = Fore en Aft  → manual alleen als exact Fore+Aft actief zijn
     12 = Lubrication  → manual alleen als exact Lub actief is
   → EXACT: de actieve HMI manual-knoppen moeten precies
     overeenkomen met de groepsindeling van deze klep
   ───────────────────────────────────────────────────────────────── *)
ManualActive := False;

if wSystem &lt; 8 then
    (* LOOSE: minimaal één groepsbit moet overeenkomen *)
    if (ManualGroep &amp; GeneralGroep) &lt;&gt; 0 then
        ManualActive := true;
    end_if;
else
    (* EXACT: de groepsbits moeten precies overeenkomen *)
    if ManualGroep = GeneralGroep then
        ManualActive := true;
    end_if;
end_if;
</STSource>
		</FBProgram>
		<FBProgram name="ValveNew">
			<LDSource nbColumns="20">
				<networkLD>
					<typeLine>
						<emptyLine nbRows="2"></emptyLine>
					</typeLine>
