		</FBProgram>
		<FBProgram name="angle">
			<STSource>(* Als input Angle is aangesloten, word de waardie daar staat op de goede plek in het statuswoord gezet *)

if IS_PAR_CON (INP := Angle) then
		ShiftAngle_0 (angle := ANGLE,
		              Status := InOut.HMIControl);
end_if;
</STSource>
		</FBProgram>
	</FBSource>
	<DDTSource DDTName="DValve_Param" version="0.09" dateTime="dt#2024-05-03-08:47:56">
		<comment>Parameters which can be used to change a valve's behaviour while still using the same FB</comment>
		<attribute name="TypeSignatureCheckSumString" value="D9E7"></attribute>
		<attribute name="TypeDataDicSubfieldsCount" value="8"></attribute>
		<structure>
			<variables name="NormallyOpen" typeName="BOOL">
				<comment>0=Normally Closed, 1=Normally Open</comment>
			</variables>
			<variables name="Delayed_ReturnOutput" typeName="TIME">
				<comment>Delay the signal when the output is removed (only output)</comment>
			</variables>
			<variables name="Delayed_Return" typeName="TIME">
				<comment>Delay the signal when the output is removed (output and status)</comment>
			</variables>
			<variables name="Clino_Enable" typeName="BOOL">
				<comment>Enable the clino function for valves</comment>
			</variables>
			<variables name="Clino_Signal" typeName="BOOL">
				<comment>Close the valve when Clino signal comes</comment>
			</variables>
			<variables name="MonitorTime" typeName="TIME">
				<comment>Time the valve is moving from open to closed/closed to open</comment>
			</variables>
			<variables name="2Outputs" typeName="BOOL"></variables>
		</structure>
	</DDTSource>
	<FBSource nameOfFBType="RotateValve" version="0.07" dateTime="dt#2021-08-18-14:19:29">
		<comment>Turn a valve on the HMI. 0 to 90</comment>
		<attribute name="TypeCodeCheckSumString" value="2A09"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="2E22"></attribute>
		<attribute name="TypeDataDicSubfieldsCount" value="3"></attribute>
		<inputParameters>
			<variables name="angle" typeName="WORD">
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
		</inputParameters>
		<inOutParameters>
			<variables name="Status" typeName="WORD">
				<attribute name="PositionPin" value="2"></attribute>
			</variables>
		</inOutParameters>
		<privateLocalVariables>
			<variables name="Wrd_angle" typeName="WORD"></variables>
		</privateLocalVariables>
		<FBProgram name="Prg">
			<STSource>Wrd_angle:= SHL_WORD (IN := angle, N := 5); 

Status:=Status or Wrd_angle;



</STSource>
		</FBProgram>
	</FBSource>
	<FBSource nameOfFBType="BitCheck" version="0.12" dateTime="dt#2026-05-19-15:52:06">
		<comment>Function Count how many bits there are 1 in a word</comment>
		<attribute name="TypeCodeCheckSumString" value="DC0D"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="C978"></attribute>
		<attribute name="TypeDataDicSubfieldsCount" value="21"></attribute>
		<inputParameters>
			<variables name="WrdIn" typeName="WORD">
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
		</inputParameters>
		<outputParameters>
			<variables name="ValueOut" typeName="WORD">
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
			<variables name="Bit0" typeName="BOOL">
				<attribute name="PositionPin" value="2"></attribute>
			</variables>
			<variables name="Bit1" typeName="BOOL">
				<attribute name="PositionPin" value="3"></attribute>
			</variables>
			<variables name="Bit2" typeName="BOOL">
				<attribute name="PositionPin" value="4"></attribute>
			</variables>
			<variables name="Bit3" typeName="BOOL">
				<attribute name="PositionPin" value="5"></attribute>
			</variables>
			<variables name="Bit4" typeName="BOOL">
				<attribute name="PositionPin" value="6"></attribute>
			</variables>
			<variables name="Bit5" typeName="BOOL">
				<attribute name="PositionPin" value="7"></attribute>
			</variables>
			<variables name="Bit6" typeName="BOOL">
				<attribute name="PositionPin" value="8"></attribute>
			</variables>
			<variables name="Bit7" typeName="BOOL">
				<attribute name="PositionPin" value="9"></attribute>
			</variables>
			<variables name="Bit8" typeName="BOOL">
				<attribute name="PositionPin" value="10"></attribute>
			</variables>
			<variables name="Bit9" typeName="BOOL">
				<attribute name="PositionPin" value="11"></attribute>
			</variables>
			<variables name="Bit10" typeName="BOOL">
				<attribute name="PositionPin" value="12"></attribute>
			</variables>
			<variables name="Bit11" typeName="BOOL">
				<attribute name="PositionPin" value="13"></attribute>
			</variables>
			<variables name="Bit12" typeName="BOOL">
				<attribute name="PositionPin" value="14"></attribute>
			</variables>
			<variables name="Bit13" typeName="BOOL">
				<attribute name="PositionPin" value="15"></attribute>
			</variables>
			<variables name="Bit14" typeName="BOOL">
				<attribute name="PositionPin" value="16"></attribute>
			</variables>
			<variables name="Bit15" typeName="BOOL">
				<attribute name="PositionPin" value="17"></attribute>
			</variables>
			<variables name="Even" typeName="BOOL">
				<attribute name="PositionPin" value="18"></attribute>
			</variables>
			<variables name="NumberOffBits" typeName="INT">
				<attribute name="PositionPin" value="19"></attribute>
			</variables>
		</outputParameters>
		<privateLocalVariables>
			<variables name="Count" typeName="INT"></variables>
			<variables name="Temp" typeName="WORD"></variables>
			<variables name="oldCount" typeName="INT"></variables>
			<variables name="fault" typeName="INT"></variables>
		</privateLocalVariables>
		<FBProgram name="info">
			<STSource>(*

Kijken hoeveel bitjes er hoog zijn in een WRD *)
</STSource>
		</FBProgram>
		<FBProgram name="ProgramBitCheck">
			<STSource>
(* copy bits from Word to bools *)

Bit0:=Wrdin.0;
Bit1:=Wrdin.1;
Bit2:=Wrdin.2;
Bit3:=Wrdin.3;
Bit4:=Wrdin.4;
Bit5:=Wrdin.5;
Bit6:=Wrdin.6;
Bit7:=Wrdin.7;
Bit8:=Wrdin.8;
Bit9:=Wrdin.9;
Bit10:=Wrdin.10;
Bit11:=Wrdin.11;
Bit12:=Wrdin.12;
Bit13:=Wrdin.13;
Bit14:=Wrdin.14;
Bit15:=Wrdin.15;

ValueOut:=Wrdin;
NumberOffBits:=0;
temp:=WrdIn;
Count:=0;

while Count&lt;16 do
	if (temp AND 2#0000000000000001)=1 then
		NumberOffBits:=NumberOffBits+1;
	end_if;

	temp := SHR (IN := temp,N := 1);

	Count:=Count+1;

		if (oldCount=Count) then 
			jmp end; (* gezien dat hij in deze stap blijft hangen? *)
			fault:=fault+1;
		end_if;

	oldCount:=Count;

end_while;


end:

</STSource>
		</FBProgram>
	</FBSource>
</FBExchangeFile>
