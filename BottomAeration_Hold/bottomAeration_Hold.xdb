							<statement>value:=WantedStep;</statement>
						</operateBlock>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="2"></emptyLine>
					</typeLine>
					<typeLine>
						<contact typeContact="closedContact" contactVariableName="PulseOn"></contact>
						<contact typeContact="openContact" contactVariableName="false"></contact>
						<HLink nbCells="5"></HLink>
						<operateBlock width="4">
							<statement>value:=Local_Num_valves;</statement>
						</operateBlock>
