	<FBSource nameOfFBType="PulseOrder" version="1.49" dateTime="dt#2021-05-10-14:17:41">
		<comment>The pulse order is used to blow air in a cloth at the bottom of a hold. It has configurable valves without feedback and when the input PulseOn is 1 the cycling is started with valve 1 set to 1 for the time set in pulselenght this time is in sec</comment>
		<attribute name="TypePassword" value=""></attribute>
		<attribute name="TypeProtectionLevel" value="2#0000_0000"></attribute>
		<attribute name="TypeCodeCheckSumString" value="5A04"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="55C7"></attribute>
		<attribute name="TypeDataDicSubfieldsCount" value="13"></attribute>
		<inputParameters>
			<variables name="Num_valves" typeName="INT">
				<comment>Number of valves (1 to 31)</comment>
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
			<variables name="PulseOn" typeName="BOOL">
				<comment>Start Pulse</comment>
				<attribute name="PositionPin" value="2"></attribute>
			</variables>
			<variables name="SP_PulseLengthNormal" typeName="INT">
				<comment>Setpoint -  pulse length in seconds </comment>
