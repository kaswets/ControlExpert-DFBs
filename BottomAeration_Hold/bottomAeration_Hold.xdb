ValvePS3.Parameters.Delayed_Return		:= TimeDelayAll;		(* slowdown valve &amp; feedback *)
ValvePS3.Parameters.Clino_Enable		:= TRUE;
ValvePS3.Parameters.Clino_Signal		:= ClinoPSLow;
ValvePS3.Parameters.MonitorTime     		:= MonitorTime;
(* Call Valve function *)
ValvePS3 (Enable := NumberOfValves &gt;= 6,
          In := Inputs.PS3,
          InOut := InOut._PS3,
          Valve_Command := BottomPulseOrder.Step3,
          General := General,
          System := SystemValveIn,
          Out =&gt; Outputs.PS3);							(* Output signals *)

(*------------------------------------------------------------------------------------------------------------------------------*)
(* Set valve parameters which set these valves apart from other valves *)
ValveSB3.Parameters.Delayed_ReturnOutput	:= TimeDelayOnlyOutput;		(* slowdown output Not feedback *)
ValveSB3.Parameters.Delayed_Return		:= TimeDelayAll;		(* slowdown valve &amp; feedback *)
ValveSB3.Parameters.Clino_Enable		:= TRUE;
ValveSB3.Parameters.Clino_Signal		:= ClinoSBLow;
ValveSB3.Parameters.MonitorTime     		:= MonitorTime;
(* Call Valve function *)
ValveSB3 (Enable := NumberOfValves &gt;= 5,
          In := Inputs.SB3,
          InOut := InOut._SB3,
          Valve_Command := BottomPulseOrder.Step3,
          General := General,
          System := SystemValveIn,
          Out =&gt; Outputs.SB3);							(* Output signals *)

(*------------------------------------------------------------------------------------------------------------------------------*)
(* Set valve parameters which set these valves apart from other valves *)
ValvePS2.Parameters.Delayed_ReturnOutput	:= TimeDelayOnlyOutput;		(* slowdown output Not feedback *)
ValvePS2.Parameters.Delayed_Return		:= TimeDelayAll;		(* slowdown valve &amp; feedback *)
ValvePS2.Parameters.Clino_Enable		:= TRUE;
ValvePS2.Parameters.Clino_Signal		:= ClinoPSLow;
ValvePS2.Parameters.MonitorTime     		:= MonitorTime;
(* Call Valve function *)
ValvePS2 (Enable := NumberOfValves &gt;= 4,
          In := Inputs.PS2,
          InOut := InOut._PS2,
          Valve_Command := BottomPulseOrder.Step2,
          General := General,
          System := SystemValveIn,
          Out =&gt; Outputs.PS2);							(* Output signals *)

(*------------------------------------------------------------------------------------------------------------------------------*)
(* Set valve parameters which set these valves apart from other valves *)
ValveSB2.Parameters.Delayed_ReturnOutput	:= TimeDelayOnlyOutput;		(* slowdown output Not feedback *)
ValveSB2.Parameters.Delayed_Return		:= TimeDelayAll;		(* slowdown valve &amp; feedback *)
ValveSB2.Parameters.Clino_Enable		:= TRUE;
ValveSB2.Parameters.Clino_Signal		:= ClinoSBLow;
ValveSB2.Parameters.MonitorTime     		:= MonitorTime;
(* Call Valve function *)
ValveSB2 (Enable := NumberOfValves &gt;= 3,
          In := Inputs.SB2,
          InOut := InOut._SB2,
          Valve_Command := BottomPulseOrder.Step2,
          General := General,
          System := SystemValveIn,
          Out =&gt; Outputs.SB2);							(* Output signals *)

(*------------------------------------------------------------------------------------------------------------------------------*)
(* Set valve parameters which set these valves apart from other valves *)
ValvePS1.Parameters.Delayed_ReturnOutput	:= TimeDelayOnlyOutput;		(* slowdown output Not feedback *)
ValvePS1.Parameters.Delayed_Return		:= TimeDelayAll;		(* slowdown valve &amp; feedback *)
ValvePS1.Parameters.Clino_Enable		:= TRUE;
ValvePS1.Parameters.Clino_Signal		:= ClinoPSLow;
ValvePS1.Parameters.MonitorTime     		:= MonitorTime;
(* Call Valve function *)
ValvePS1 (Enable := NumberOfValves &gt;= 2,
          In := Inputs.PS1,
          InOut := InOut._PS1,
          Valve_Command := BottomPulseOrder.Step1,
          General := General,
          System := SystemValveIn,
          Out =&gt; Outputs.PS1);							(* Output signals *)
(*------------------------------------------------------------------------------------------------------------------------------*)
(* Set valve parameters which set these valves apart from other valves *)
ValveSB1.Parameters.Delayed_ReturnOutput	:= TimeDelayOnlyOutput;		(* slowdown output Not feedback *)
ValveSB1.Parameters.Delayed_Return		:= TimeDelayAll;		(* slowdown valve &amp; feedback *)
ValveSB1.Parameters.Clino_Enable		:= TRUE;
ValveSB1.Parameters.Clino_Signal		:= ClinoSBLow;
ValveSB1.Parameters.MonitorTime     		:= MonitorTime;
(* Call Valve function *)
ValveSB1 (Enable := NumberOfValves &gt;= 1,
          In := Inputs.SB1,
          InOut := InOut._SB1,
          Valve_Command := BottomPulseOrder.Step1,
          General := General,
          System := SystemValveIn,
          Out =&gt; Outputs.SB1);							(* Output signals *)

(*------------------------------------------------------------------------------------------------------------------------------*)
(* Set valve parameters which set these valves apart from other valves *)
GutterValve1.Parameters.Delayed_ReturnOutput	:= T#1000ms;			(* slowdown output Not feedback *)
GutterValve1.Parameters.Delayed_Return		:= T#1000ms;			(* slowdown valve &amp; feedback *)
GutterValve1.Parameters.Clino_Enable		:= TRUE;
GutterValve1.Parameters.Clino_Signal		:= TRUE;
GutterValve1.Parameters.MonitorTime     	:= MonitorTime;
(* Call Valve function *)
GutterValve1 (Enable := TRUE,
              In := Inputs.Gutter1,
              InOut := InOut.Gutter1,
              Valve_Command := Command_GutterValve1,
              General := General,
              System := SystemValveIn,
              Out =&gt; Outputs.Gutter1);						(* Output signals *)

(*------------------------------------------------------------------------------------------------------------------------------*)
(* Set valve parameters which set these valves apart from other valves *)
GutterValve2.Parameters.Delayed_ReturnOutput	:= T#1000ms;			(* slowdown output Not feedback *)
GutterValve2.Parameters.Delayed_Return     	:= T#1000ms;
GutterValve2.Parameters.Clino_Enable		:= TRUE;
GutterValve2.Parameters.Clino_Signal		:= TRUE;
GutterValve2.Parameters.MonitorTime     	:= MonitorTime;
(* Call Valve function *)
GutterValve2 (Enable := TRUE,
              In := Inputs.Gutter2,
              InOut := InOut.Gutter2,
              Valve_Command := Command_GutterValve2,
              General := General,
              System := SystemValveIn,
              Out =&gt; Outputs.Gutter2);						(* Output signals *)

(*------------------------------------------------------------------------------------------------------------------------------*)
(* Set valve parameters which set these valves apart from other valves *)
GutterValve3.Parameters.Delayed_ReturnOutput	:= T#1000ms;			(* slowdown output Not feedback *)
GutterValve3.Parameters.Delayed_Return     	:= T#1000ms;
GutterValve3.Parameters.Clino_Enable		:= TRUE;
GutterValve3.Parameters.Clino_Signal		:= TRUE;
GutterValve3.Parameters.MonitorTime     	:= MonitorTime;
(* Call Valve function *)
GutterValve3 (Enable := TRUE,
              In := Inputs.Gutter3,
              InOut := InOut.Gutter3,
              Valve_Command := Command_GutterValve3,
              General := General,
              System := SystemValveIn,
              Out =&gt; Outputs.Gutter3);						(* Output signals *)

(*------------------------------------------------------------------------------------------------------------------------------*)
(* Set valve parameters which set these valves apart from other valves *)
GutterValve4.Parameters.Delayed_ReturnOutput	:= T#1000ms;			(* slowdown output Not feedback *)
GutterValve4.Parameters.Delayed_Return     	:= T#1000ms;
GutterValve4.Parameters.Clino_Enable		:= TRUE;
GutterValve4.Parameters.Clino_Signal		:= TRUE;
GutterValve4.Parameters.MonitorTime     	:= MonitorTime;
(* Call Valve function *)
GutterValve4 (Enable := TRUE,
              In := Inputs.Gutter4,
              InOut := InOut.Gutter4,
              Valve_Command := Command_GutterValve4,
              General := General,
              System := SystemValveIn,
              Out =&gt; Outputs.Gutter4);						(* Output signals *)

(*------------------------------------------------------------------------------------------------------------------------------*)
(* Check if any bottom valve is open *)
(* Thijs keek hier naar de outputs, maar als ik deze iets langer open wil laten staan, werkt dat niet, dus veranderd naar statusword *)
(* was dit  ook weer een thijsje en ik mis klep 17?
Outputs.AnyBottomValveOpen := 	Outputs.BottomValve24.open OR Outputs.BottomValve23.Open OR Outputs.BottomValve22.Open OR Outputs.BottomValve21.Open OR Outputs.BottomValve20.Open OR Outputs.BottomValve19.Open OR Outputs.BottomValve18.Open OR Outputs.BottomValve16.Open OR
				Outputs.BottomValve16.Open OR Outputs.BottomValve15.Open OR Outputs.BottomValve14.Open OR Outputs.BottomValve13.Open OR Outputs.BottomValve12.Open OR Outputs.BottomValve11.Open OR Outputs.BottomValve10.Open OR Outputs.BottomValve9.Open  OR
				Outputs.BottomValve8.Open  OR Outputs.BottomValve7.Open  OR Outputs.BottomValve6.Open  OR Outputs.BottomValve5.Open  OR Outputs.BottomValve4.Open  OR Outputs.BottomValve3.Open  OR Outputs.BottomValve2.Open  OR Outputs.BottomValve1.Open;

*)
Outputs.AnyBottomValveOpen :=  Inout._SB12.HMIControl.0=1 or Inout._PS12.HMIControl.0=1 or Inout._SB11.HMIControl.0=1 or
                               Inout._PS11.HMIControl.0=1 or Inout._SB10.HMIControl.0=1 or Inout._PS10.HMIControl.0=1 or 
			       Inout._Sb9.HMIControl.0=1 or Inout._PS9.HMIControl.0=1 or Inout._SB8.HMIControl.0=1 or
			       Inout._PS8.HMIControl.0=1 or Inout._SB7.HMIControl.0=1 or Inout._PS7.HMIControl.0=1 or
			       Inout._SB6.HMIControl.0=1 or Inout._PS6.HMIControl.0=1 or Inout._SB5.HMIControl.0=1 or
			       Inout._PS5.HMIControl.0=1 or Inout._SB4.HMIControl.0=1 or Inout._PS4.HMIControl.0=1 or
			       Inout._SB3.HMIControl.0=1 or Inout._PS3.HMIControl.0=1 or Inout._SB2.HMIControl.0=1 or
			       Inout._PS2.HMIControl.0=1 or Inout._SB1.HMIControl.0=1 or Inout._PS1.HMIControl.0=1;


(*------------------------------------------------------------------------------------------------------------------------------*)
(* Check if any gutter valve is open *)
(* ook aangepast om de output dmv een tof te kunnen vertragen *)
(* Outputs.AnyGutterValveOpen :=	Outputs.GutterValve1.Open  OR Outputs.GutterValve2.Open; 
*)
Outputs.AnyGutterValveOpen := Inout.Gutter1.HMIControl.0=1 or Inout.Gutter2.HMIControl.0=1;
</STSource>
		</FBProgram>
		<FBProgram name="ExtraInformatie">
			<STSource>(*==========================================================================================================*)
(*  SMARTBOTTOM - UITLEG WERKING EN VARIABELEN                                                              *)
(*==========================================================================================================*)
(*                                                                                                          *)
(*  DOEL VAN DIT PROGRAMMA                                                                                  *)
(*----------------------------------------------------------------------------------------------------------*)
(*De ruimbodem van het schip is trechtervormig: schuine vlakken lopen naar het midden, waar de zuigbuis zit.*)
(*In die schuine vlakken zitten doeken (beluchte vlakken/kleppen) waar lucht onderdoor geblazen kan worden. *)
(*                                                                                                          *)
(*Waar nog cement op een doek ligt, geeft dat weerstand: hoge tegendruk op de blower. Waar een doek al vrij *)
(*ligt (weinig/geen cement), gaat de lucht er makkelijk doorheen: lage tegendruk. Daar hoeft niet meer      *)
(*belucht te worden.                                                                                        *)
(*                                                                                                          *)
(*Omdat de vlakken niet allemaal even groot zijn, geeft 'leeg' niet overal dezelfde tegendruk. Daarom wordt *)
(*per vlak een eigen leeg-referentie ingemeten (Find Empty Press): elk vlak wordt een tijd belucht terwijl  *)
(*het ruim al leeg is, en die tegendruk wordt opgeslagen als 100%-punt.                                     *)
(*                                                                                                          *)
(*SmartBottom kiest daarna telkens het vlak met de hoogste tegendruk TEN OPZICHTE VAN zijn eigen leeg-      *)
(*referentie (dus verhoudingsgewijs het meeste cement), in plaats van gewoon op volgorde langs alle kleppen *)
(*te lopen. Zo wordt geen tijd verspild aan hoeken/vlakken die al leeg zijn, en gaat het laatste restje     *)
(*cement (het traagste, duurste deel van het lossen) sneller weg.                                           *)
(*                                                                                                          *)
(*  HOE WERKT DE KLEPKEUZE (elke keer als NextStep afgaat)                                                  *)
(*----------------------------------------------------------------------------------------------------------*)
(*1. Van elke klep wordt de verhouding ActualPress/EmptyPress uitgerekend (in procenten). Hoe hoger die     *)
(*verhouding, hoe voller dat vlak nog relatief is.                                                          *)
(*2. De klep die op dit moment al open staat (ActiveStep) wordt uitgesloten van de keuze - zo wisselt de    *)
(*vloer altijd naar een ander vlak, en blijft ook daar de meting vers.                                      *)
(*3. De klep met de hoogste verhouding (die niet de actieve is) wordt de nieuwe WantedStep.                 *)
(*4. Is het ruim (bijna) leeg, of FindEmpty actief, of slagzij te groot (Clino) - dan wordt niet op druk    *)
(*gekozen maar gewoon de volgende klep in de rij gepakt (normale ronde, om te controleren of echt alles leeg*)
(*is).                                                                                                      *)
(*                                                                                                          *)
(*  KOPPELING MET DE KLEPAANSTURING (PulseOrder-blok)                                                       *)
(*----------------------------------------------------------------------------------------------------------*)
(*WantedStep is alleen een 'wens'. Het blok PulseOrder (in Main) zet zijn interne stap-teller elke scan     *)
(*gelijk aan WantedStep zolang SmartBottomOn aan staat, en geeft die stap een scan later terug als          *)
(*ActiveStep. Zolang smart-modus aan staat werken de handbedieningen (links/rechts stappen) dus niet: die   *)
(*worden meteen weer overschreven door WantedStep.                                                          *)
(*                                                                                                          *)
(*==========================================================================================================*)
(*  VARIABELEN                                                                                              *)
(*==========================================================================================================*)
(*                                                                                                          *)
(*  InOut.Control.SmartBottomOn : Hoofdschakelaar: smart-klepkeuze op basis van druk aan/uit.               *)
(*  InOut.Control.FindEmpty : Kalibratiestand: alle EmptyPressBothSides opnieuw inmeten (ruim moet leeg     *)
(*                            zijn).                                                                        *)
(*  InOut.Control.Empty : Uitgang: TRUE zodra alle vlakken onder ~110% van hun leeg-referentie zitten.      *)
(*  InOut.ActualPressValve[] : Actuele (gemiddelde) blowerdruk per klep, voor weergave op het HMI.          *)
(*  EmptyPressBothSides[] : Referentie-tegendruk per vlak bij ECHT leeg (retentief/Save, blijft bewaard).   *)
(*  ActualPressBothSides[] : Laatst gemeten (gemiddelde) tegendruk per vlak, gebruikt voor de vergelijking. *)
(*  HalfNumberOfValves : Aantal klepPAREN (PS+SB samen) = NumberOfValves / 2.                               *)
(*  ActiveStep : Klep die op dit moment daadwerkelijk open staat (komt terug uit PulseOrder).               *)
(*  PrevActiveStep : ActiveStep van de vorige scan, om een stapwissel te herkennen.                         *)
(*  WantedStep : Klep die SmartBottom als eerstvolgende wil openen (invoer voor PulseOrder).                *)
(*  NextStep : Puls vanuit PulseOrder: tijd voor deze stap is verstreken, tijd om te kiezen.                *)
(*  HighestValue : Hoogste gevonden druk-verhouding (Actual/Empty, in %) tijdens het zoeken.                *)
(*  HighestStep : Klepnummer dat bij HighestValue hoort - wordt de nieuwe WantedStep.                       *)
(*  acutalValue : Hulpvariabele: verhouding van de klep die net bekeken wordt in de zoeklus (typo in naam). *)
(*  cnt : Teller/index voor de for-lussen over de kleppen.                                                  *)
(*  tmpSmartActive : Kopie van SmartBottomOn, gebruikt om een inschakel-flank (re) te herkennen.            *)
(*  tmpFindEmpty : Kopie van FindEmpty, gebruikt om een inschakel-flank (re) te herkennen.                  *)
(*  Activate_Pulse : TRUE als de vloer daadwerkelijk mag beluchten (uit Main-logica).                       *)
(*  OneStepIsActive : Hulpbit: pas TRUE als dezelfde klep al even (TON_OnlyOneActive) actief is.            *)
(*  TON_OnlyOneActive : Wachttijd na een stapwissel voor de drukmeting start (laat inschakel-piek           *)
(*                      uitdempen).                                                                         *)
(*  PressureTotal : Optelling van drukmetingen tijdens deze stap, voor het gemiddelde.                      *)
(*  cntMeasurements : Aantal metingen meegenomen in PressureTotal (voor het gemiddelde).                    *)
(*  Blower.Press_Bottom : Live tegendruk-signaal van de blower (bron van elke meting).                      *)
(*  Clino.X_PS_Off / X_SB_Off : Slagzij-veiligheid PS/SB: bij te grote slagzij geen smart-keuze, gewone     *)
(*                              ronde.                                                                      *)
(*  temp : Hulpvariabele: 110%-grens per klep bij de allEmpty-controle.                                     *)
(*  allEmpty : Hulpbit: wordt InOut.Control.Empty - TRUE als alle vlakken onder de 110%-grens zitten.       *)
(*                                                                                                          *)
(*==========================================================================================================*)


(*==========================================================================================================*)
(*  SMARTBOTTOM - PURPOSE, LOGIC AND VARIABLES                                                              *)
(*==========================================================================================================*)
(*                                                                                                          *)
(*  PURPOSE OF THIS PROGRAM                                                                                 *)
(*----------------------------------------------------------------------------------------------------------*)
(*The hold bottom of the ship is shaped like a hopper: sloped panels run down to the centre, where the      *)
(*suction pipe sits. Those sloped panels contain cloths (aeration panels/valves) that can be aerated from   *)
(*below.                                                                                                    *)
(*                                                                                                          *)
(*Where cement is still lying on a cloth, it creates resistance: high back-pressure on the blower. Where a  *)
(*cloth is already bare (little/no cement left), the air passes through easily: low back-pressure. There,   *)
(*aeration is no longer needed.                                                                             *)
(*                                                                                                          *)
(*Because the panels are not all the same size, 'empty' does not give the same back-pressure everywhere.    *)
(*That is why each panel gets its own empty reference measured (Find Empty Press): every panel is aerated   *)
(*for a while while the hold is already empty, and that pressure is stored as the 100% point.               *)
(*                                                                                                          *)
(*SmartBottom then always selects the panel with the highest back-pressure RELATIVE TO its own empty        *)
(*reference (i.e. proportionally the most cement left), instead of simply cycling through all valves in     *)
(*order. This avoids wasting time on corners/panels that are already empty, so the last bit of cement (the  *)
(*slowest, most costly part of discharging) is cleared faster.                                              *)
(*                                                                                                          *)
(*  HOW THE VALVE SELECTION WORKS (every time NextStep fires)                                               *)
(*----------------------------------------------------------------------------------------------------------*)
(*1. For every valve, the ratio ActualPress/EmptyPress is calculated (as a percentage). The higher this     *)
(*ratio, the more that panel is still relatively full.                                                      *)
(*2. The valve that is currently open (ActiveStep) is excluded from the selection - this way the floor      *)
(*always switches to a different panel, keeping its measurement fresh too.                                  *)
(*3. The valve with the highest ratio (that is not the active one) becomes the new WantedStep.              *)
(*4. If the hold is (nearly) empty, or FindEmpty is active, or the list angle is too large (Clino) - then   *)
(*the choice is not based on pressure but simply the next valve in line is taken (normal round, to check    *)
(*everything is really empty).                                                                              *)
(*                                                                                                          *)
(*  LINK WITH THE VALVE SEQUENCER (PulseOrder block)                                                        *)
(*----------------------------------------------------------------------------------------------------------*)
(*WantedStep is only a 'request'. The PulseOrder block (in Main) copies its internal step counter to        *)
(*WantedStep every scan as long as SmartBottomOn is on, and returns that step one scan later as ActiveStep. *)
(*As long as smart mode is on, the manual jog controls (step left/right) therefore do not work: they get    *)
(*overwritten by WantedStep immediately.                                                                    *)
(*                                                                                                          *)
(*==========================================================================================================*)
(*  VARIABLES                                                                                               *)
(*==========================================================================================================*)
(*                                                                                                          *)
(*  InOut.Control.SmartBottomOn : Main switch: pressure-based smart valve selection on/off.                 *)
(*  InOut.Control.FindEmpty : Calibration mode: re-measure all EmptyPressBothSides (hold must be empty).    *)
(*  InOut.Control.Empty : Output: TRUE once all panels are below ~110% of their empty reference.            *)
(*  InOut.ActualPressValve[] : Current (averaged) blower pressure per valve, shown on the HMI.              *)
(*  EmptyPressBothSides[] : Reference back-pressure per panel when truly empty (retentive/Save, kept).      *)
(*  ActualPressBothSides[] : Last measured (averaged) pressure per panel, used for the comparison.          *)
(*  HalfNumberOfValves : Number of valve PAIRS (PS+SB together) = NumberOfValves / 2.                       *)
(*  ActiveStep : Valve that is actually open right now (fed back from PulseOrder).                          *)
(*  PrevActiveStep : ActiveStep of the previous scan, used to detect a step change.                         *)
(*  WantedStep : Valve SmartBottom wants to open next (input to PulseOrder).                                *)
(*  NextStep : Pulse from PulseOrder: time for this step has elapsed, time to pick a new one.               *)
(*  HighestValue : Highest pressure ratio found (Actual/Empty, in %) during the search.                     *)
(*  HighestStep : Valve number belonging to HighestValue - becomes the new WantedStep.                      *)
(*  acutalValue : Helper variable: ratio of the valve currently being checked in the search loop (typo in   *)
(*                name).                                                                                    *)
(*  cnt : Counter/index for the for-loops over the valves.                                                  *)
(*  tmpSmartActive : Copy of SmartBottomOn, used to detect a rising edge (re).                              *)
(*  tmpFindEmpty : Copy of FindEmpty, used to detect a rising edge (re).                                    *)
(*  Activate_Pulse : TRUE when the floor is actually allowed to aerate (from Main logic).                   *)
(*  OneStepIsActive : Helper bit: only TRUE once the same valve has been active for a while                 *)
(*                    (TON_OnlyOneActive).                                                                  *)
(*  TON_OnlyOneActive : Settling time after a step change before the pressure measurement starts (lets the  *)
(*                      switch-on spike die down).                                                          *)
(*  PressureTotal : Running sum of pressure readings during this step, used for the average.                *)
(*  cntMeasurements : Number of readings included in PressureTotal (for the average).                       *)
(*  Blower.Press_Bottom : Live back-pressure signal from the blower (source of every reading).              *)
(*  Clino.X_PS_Off / X_SB_Off : List-angle safety PS/SB: too much list disables smart selection, normal     *)
(*                              round instead.                                                              *)
(*  temp : Helper variable: 110% threshold per panel for the allEmpty check.                                *)
(*  allEmpty : Helper bit: becomes InOut.Control.Empty - TRUE once all panels are below the 110% threshold. *)
(*                                                                                                          *)
(*==========================================================================================================*)


</STSource>
		</FBProgram>
		<FBProgram name="SmartBottom">
			<STSource>(*     Smart bottom control												*)
(*																*)
(* Als er een bodem klep open staat, word gelijk de tegendruk opgeslagen in een array						*)
(* en iedere keer als de tijd verlopen is, word er gezocht in die lijst naar de hoofste verschil tussen actueel en leeg druk 	*)
(* en word die klep open gezet													*)
(*																*)
(* AANPASSING t.o.v. het origineel - reden:											*)
(* Klep 1 kreeg voorheen NIET dezelfde uitsluiting (cnt&lt;&gt;ActiveStep) als alle andere kleppen in de lus. Daardoor kon	*)
(* klep 1, als hij nog actief EN nog steeds de hoogste was, zichzelf gewoon weer kiezen. Dat werd opgevangen door een	*)
(* noodgreep verderop (HighestStep:=2 zodra HighestStep=WantedStep), maar die sprong altijd blind naar klep 2 - ook	*)
(* als daar allang geen cement meer lag. Gevolg: als klep 1 het langst vol bleef (precies het "laatste restje" waar	*)
(* de doorzet het zwaarst op leunt), ging de vloer om-en-om tussen klep 1 en klep 2, waarbij de helft van de tijd	*)
(* verspild werd aan klep 2, ongeacht of daar nog iets te doen viel.								*)
(* Nu doorloopt klep 1 dezelfde lus en dezelfde uitsluiting als alle andere kleppen, dus de lus zelf vindt altijd de	*)
(* ECHTE eerstvolgende beste klep i.p.v. een vast nummer. HighestValue/HighestStep worden bovendien bij elke		*)
(* zoekactie vers op 0 gezet i.p.v. alleen bij het inschakelen, zodat er nooit een oude uitkomst "hangen" blijft als	*)
(* bv. een klep nog niet is ingemeten (EmptyPress=0).										*)

(* bedieningen op ebool zetten *)
tmpSmartActive:=InOut.Control.SmartBottomOn;
tmpFindEmpty:=InOut.Control.FindEmpty;

if re(tmpSmartActive) or re(tmpFindEmpty)   then (*or re(tmpActivate_Pulse)*)
	(*If they put it on, set them all on Max. pressure*)
	HighestValue:=0;
	for cnt:=1 to HalfNumberOfValves do
		InOut.ActualPressValve[cnt]:=999;
		ActualPressBothSides[cnt]:=999;
	end_for;
end_if;

if re(tmpFindEmpty) then
(*If they put it on, Reset all empty pressures*)
	for cnt:=1 to HalfNumberOfValves do
		EmptyPressBothSides[cnt]:=0;
	end_for;
end_if;

(*______________________________________________________________________________________________________________________________*)
(* Als smart cleaning aan gezet word,
(* of als er overgeschakeld moet worden van klep 										*)
(* Dan zoeken in de Array welke klep nog het grootste verschil heeft tussen de huidige druk en de empty druk 			*)

if re(tmpSmartActive) or NextStep then

	(* Zoekactie ELKE keer vers beginnen: HighestValue/HighestStep niet laten "hangen" van de vorige ronde.		*)
	(* 0 = "nog geen geldige kandidaat gevonden" - elke echte drukverhouding (Actual/Empty*100) ligt hierboven.		*)
	HighestValue:=0;
	HighestStep:=0;

	(* Eén en dezelfde lus voor ALLE kleppen, dus ook klep 1 - kijk hoeveel procent de druk boven de empty druk zit,	*)
	(* en sluit de klep die nu al open staat uit (cnt&lt;&gt;ActiveStep). Die uitsluiting zorgt dat de vloer altijd naar	*)
	(* een ANDER vlak wisselt (en dus ook daar de druk weer eens ververst wordt), maar de klep die net "aan de kant"	*)
	(* gezet is blijft gewoon meedoen in de ranglijst en kan de eerstvolgende keer weer gekozen worden als hij dan	*)
	(* nog steeds het volst is - in plaats van dat er blind naar een vast nummer gesprongen wordt.				*)
	for cnt:=1 to HalfNumberOfValves do
		if (int_to_real(EmptyPressBothSides[cnt])/100.0)&gt;0.0 then
			(*Kijken hoeveel procent de druk boven de empty druk zit*)
			acutalValue:=real_to_int((int_to_Real(ActualPressBothSides[cnt]))/(int_to_real(EmptyPressBothSides[cnt])/100.0));

			if acutalValue&gt;HighestValue and cnt&lt;&gt;ActiveStep then
				HighestValue:=acutalValue;
				HighestStep:=cnt;
			end_if;
		end_if;
	end_for;

	(* Geen enkele geldige kandidaat gevonden (bv. nog niks ingemeten via Find Empty, of maar 1 klep beschikbaar)	*)
	(* -&gt; zelfde noodgreep als de else hieronder: gewoon de volgende klep in de rij pakken i.p.v. blijven hangen.	*)
	if HighestStep=0 then
		HighestStep:=ActiveStep+1;
		if HighestStep&gt;HalfNumberOfValves then
			HighestStep:=1;
		end_if;
	end_if;

	if (not InOut.Control.Empty) and (not tmpFindEmpty) and (not(Clino.X_PS_Off or Clino.X_SB_Off)) then
		WantedStep:=HighestStep; (* open the step with this highest pressure 						*)
	else
		WantedStep:=ActiveStep+1; (* holds empty? start normal cycle again, to look they are really empty? 		*)
		if WantedStep&gt;HalfNumberOfValves then
			WantedStep:=1;
		end_if;
	end_if;

end_if;

(*_______________________________________________________________________________________________________________________________*)
if ActiveStep&gt;0 and ActiveStep&lt;(HalfNumberOfValves+1) then

	OneStepIsActive:=True;

	if PrevActiveStep&lt;&gt;ActiveStep then  (* 1 keer, als de nieuwe stap actie word 						*)
		PressureTotal:=int_to_dint(InOut.ActualPressValve[ActiveStep]);
		cntMeasurements:=1;

		OneStepIsActive:=False; (* start some time, because I only want look at the pressure if One Step is active	*)
	end_if;

	(*if Clino.X_PS_Off or Clino.X_SB_Off then
		OneStepIsActive:=False;
	end_if;*)

	TON_OnlyOneActive (IN := OneStepIsActive,PT := TimeDelayAll+MonitorTime/2);

(* save the backpressure for each step *)
	if Activate_Pulse and TON_OnlyOneActive.q then (* alleen kijken als er maar rij klep(pen) actief is			*)

		(* gemiddelde druk op 1 vloerdeel uitrekenen *)
		PressureTotal:=PressureTotal+int_to_dint(Blower.Press_Bottom);
		cntMeasurements:=cntMeasurements+1;

		(* huidige blowerdruk opslaan, en op het hmi laten zien bij de kleppen *)
		InOut.ActualPressValve[ActiveStep]:=Dint_to_int(PressureTotal/cntMeasurements);

		(* Dukken opslaan van een leeg hold *)
		if tmpFindEmpty then
			EmptyPressBothSides[ActiveStep]:=Dint_to_int(PressureTotal/cntMeasurements);
		else
			ActualPressBothSides[ActiveStep]:=InOut.ActualPressValve[ActiveStep];
		end_if;

	end_if;
end_if;

(*_______________________________________________________________________________________________________________________________*)
(* Kijken of alle matten leeg zijn.*)
allEmpty:=true;
for cnt:=1 to HalfNumberOfValves do


temp:=real_to_int((int_to_real(EmptyPressBothSides[cnt])/100.0)*110.0);

	if ActualPressBothSides[cnt]&gt;temp then
		allEmpty:=false;
	end_if;

end_for;


InOut.Control.Empty:=allEmpty;


PrevActiveStep:=ActiveStep;

</STSource>
		</FBProgram>
