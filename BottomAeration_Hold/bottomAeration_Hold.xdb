		</FBProgram>
		<FBProgram name="Valves">
			<STSource>(* Set Shared parameters *)
TimeDelayOnlyOutput	:= T#500ms;
TimeDelayAll		:= T#5000ms;
MonitorTime		:= t#10s;

(*------------------------------------------------------------------------------------------------------------------------------*)
(* Set valve parameters which set these valves apart from other valves *)
ValvePS12.Parameters.Delayed_ReturnOutput	:= TimeDelayOnlyOutput; 	(* slowdown output Not feedback *)
ValvePS12.Parameters.Delayed_Return		:= TimeDelayAll; 		(* slowdown valve &amp; feedback *)
ValvePS12.Parameters.Clino_Enable		:= TRUE;
ValvePS12.Parameters.Clino_Signal		:= ClinoPSLow;
ValvePS12.Parameters.MonitorTime  		:= MonitorTime;
(* Call Valve function *)
ValvePS12 (Enable := NumberOfValves &gt;= 24,
           In := Inputs.PS12,
           InOut := InOut._PS12,
           Valve_Command := BottomPulseOrder.Step12,
           General := General,
           System := SystemValveIn,
           Out =&gt; Outputs.PS12);						(* Output signals *)

(*------------------------------------------------------------------------------------------------------------------------------*)
(* Set valve parameters which set these valves apart from other valves *)
ValveSB12.Parameters.Delayed_ReturnOutput	:= TimeDelayOnlyOutput; 	(* slowdown output Not feedback *)
ValveSB12.Parameters.Delayed_Return		:= TimeDelayAll; 		(* slowdown valve &amp; feedback *)
ValveSB12.Parameters.Clino_Enable		:= TRUE;
ValveSB12.Parameters.Clino_Signal		:= ClinoSBLow;
ValveSB12.Parameters.MonitorTime     		:= MonitorTime;
(* Call Valve function *)
ValveSB12 (Enable := NumberOfValves &gt;= 23,
           In := Inputs.SB12,
           InOut := InOut._SB12,
           Valve_Command := BottomPulseOrder.Step12,
           General := General,
           System := SystemValveIn,
           Out =&gt; Outputs.SB12);						(* Output signals *)

