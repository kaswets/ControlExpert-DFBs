					<textBox width="11" height="1">Gutter Valves
    <objPosition posX="0" posY="44"></objPosition>
					</textBox>
					<textBox width="11" height="1">Command Valve1 (inner gutter)
    <objPosition posX="0" posY="74"></objPosition>
					</textBox>
					<textBox width="11" height="1">de druk van Blower  langer als xsec onder bepaald drukl, start het wandelen van de vloer beluchting<objPosition posX="0" posY="0"></objPosition>
					</textBox>
					<textBox width="11" height="1">Reset control when changing from manual mode
    <objPosition posX="0" posY="1"></objPosition>
					</textBox>
					<textBox width="11" height="1">Pulseorder indication
    <objPosition posX="0" posY="71"></objPosition>
					</textBox>
					<textBox width="11" height="1">For indication only
    <objPosition posX="0" posY="28"></objPosition>
					</textBox>
					<textBox width="11" height="1">Bottom aeration valves. Switch between valves.
    <objPosition posX="0" posY="4"></objPosition>
					</textBox>
					<textBox width="11" height="1">Command Valve2 (Outer gutter)
    <objPosition posX="0" posY="78"></objPosition>
					</textBox>
					<textBox width="11" height="1">show Blower pressure on HMI
    <objPosition posX="0" posY="82"></objPosition>
					</textBox>
					<textBox width="11" height="1">Clino SB / PS
    <objPosition posX="0" posY="32"></objPosition>
					</textBox>
				</networkLD>
