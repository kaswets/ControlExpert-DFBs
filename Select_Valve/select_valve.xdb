		<FBProgram name="Info">
			<STSource>(*								info								*)
(*													        		*)
(* om de klep in bedrijf te stellen, is er een inputje Test gemaakt op het functieblok. Als dit inputje Hoog is, kan in 	*)
(* Manual de klep heen en weer gepulst worden dmv de manual toetsen in het scherm.						*)
(*																*)
(* Dus eigenlijk eerst de klep mechanisch in de midden zetten(?) met de hand, door de klep te verdraaien(?) 			*)
(* 																*)
(* Dan in het scherm de klep een commando geven. En iemand bij de klep de draai richting controleren 				*)
(*																*)
(* Belangrijk... Het command in het scherm is het commaand waar de cement heen moet!!!! Dus de klep moet zo bewegen dat de 	*)
(* cement die kant op gaat. Dus of de klep links of rechtsom, voor of achter, SB of PS heeft er allemaal niets mee te maken.	*)
(* Dus kies je op het scherm PS, moet de klep naar die kant bewegen dat de cement, als de klep in positie is gekomen, naar 	*)
(* PS gaat!!															*)
(* Aan de buitenkant van het functieblok kan je zien hoe lang de klep er over gedaan heeft van de ene naar de andere kant 	*)
(* Longway.															*)
(*																*)
(* of naar de midden, of van de midden naar een kant.										*)
(* Shortway															*)

</STSource>
		</FBProgram>
		<FBProgram name="extra">
			<STSource>
(* Only if there is a outside TXT use the Intern Alarms *)
InternAlarm:=false;

if MainTxt&lt;&gt;'' then
	InternAlarm:=true;
end_if;
</STSource>
		</FBProgram>
		<FBProgram name="NewManual">
			<STSource>wSystem:=Int_To_word(System);

BitCheck_SystemIn (WrdIn := wSystem,
                   ValueOut =&gt; SystemIn_Out,
                   Bit0 =&gt; SystemInB0,
                   Bit1 =&gt; SystemInB1,
                   Bit2 =&gt; SystemInB2,
                   Bit3 =&gt; SystemInB3,
                   Bit4 =&gt; SystemInB4,
                   Bit5 =&gt; SystemInB5,
                   Bit6 =&gt; SystemInB6,
                   Bit7 =&gt; SystemInB7,
                   Bit8 =&gt; SystemInB8,
                   Bit9 =&gt; SystemInB9,
                   Bit10 =&gt; SystemInB10,
                   Bit11 =&gt; SystemInB11,
                   Bit12 =&gt; SystemInB12,
                   Bit13 =&gt; SystemInB13,
                   Bit14 =&gt; SystemInB14,
                   Bit15 =&gt; SystemInB15,
                   NumberOffBits =&gt; SystemNBBits);


BitCheck_GeneralMan (WrdIn := General.Manual.wrd,
                   ValueOut =&gt; GeneralManual_Out,
                   Bit0 =&gt; GeneralManualB0,
                   Bit1 =&gt; GeneralManualB1,
                   Bit2 =&gt; GeneralManualB2,
                   Bit3 =&gt; GeneralManualB3,
                   Bit4 =&gt; GeneralManualB4,
                   Bit5 =&gt; GeneralManualB5,
                   Bit6 =&gt; GeneralManualB6,
                   Bit7 =&gt; GeneralManualB7,
                   Bit8 =&gt; GeneralManualB8,
                   Bit9 =&gt; GeneralManualB9,
                   Bit10 =&gt; GeneralManualB10,
                   Bit11 =&gt; GeneralManualB11,
                   Bit12 =&gt; GeneralManualB12,
                   Bit13 =&gt; GeneralManualB13,
                   Bit14 =&gt; GeneralManualB14,
                   Bit15 =&gt; GeneralManualB15,
                   NumberOffBits =&gt; GeneralManualNBBits);



ManualGroep:=SystemIn_Out &amp; 2#0000000000000111; 			(* totaal zijn er 3 manual groepen  *)
GeneralGroep:=GeneralManual_Out &amp; 2#0000000011111111; 			(* manual knoppen uit het scherm *)



ManualActive:=False;

if wSystem&lt;7 then							(* 4de bit is AND , Dus moeten Manual1 en Manual 2 hoog staan! *)
	(* als er 1 bitje gelijk is , dan staat de klep in manual *)
	(* dus b0 OF b1*)
	if (ManualGroep &amp; GeneralGroep)&lt;&gt;0 then
		ManualActive:=true;
	end_if;
else
	(* als beide bitjes hoog staan, dan staat de klep in manual *)
	(* dus b0 EN b1 *)
	if ManualGroep = GeneralGroep then
		ManualActive:=true;
	end_if;
end_if;


</STSource>
		</FBProgram>
		<FBProgram name="prg_Selectvalve">
			<LDSource nbColumns="20">
				<networkLD>
					<typeLine>
						<emptyLine nbRows="1"></emptyLine>
					</typeLine>
					<typeLine>
						<HLink nbCells="2"></HLink>
						<contact typeContact="openContact" contactVariableName="General.Alarm_Reset"></contact>
						<shortCircuit>
							<VLink></VLink>
							<HLink nbCells="8"></HLink>
						</shortCircuit>
						<HLink nbCells="5"></HLink>
						<operateBlock width="4">
							<statement>Outputs.Alarms.Wrd:=0;</statement>
						</operateBlock>
					</typeLine>
					<typeLine>
						<emptyCell nbCells="11"></emptyCell>
						<shortCircuit>
							<VLink></VLink>
							<HLink nbCells="5"></HLink>
						</shortCircuit>
						<operateBlock width="4">
							<statement>ManualOld:=0;</statement>
						</operateBlock>
					</typeLine>
					<typeLine>
						<emptyCell nbCells="16"></emptyCell>
						<operateBlock width="4">
							<statement>Valve_CommandOld:=0;</statement>
						</operateBlock>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="1"></emptyLine>
					</typeLine>
					<typeLine>
						<HLink nbCells="16"></HLink>
						<operateBlock width="4">
							<statement>ManInputCommand:=InOut.Manual And 16#0003;</statement>
						</operateBlock>
					</typeLine>
					<typeLine>
						<HLink nbCells="1"></HLink>
						<contact typeContact="closedContact" contactVariableName="ManualActive"></contact>
						<HLink nbCells="2"></HLink>
						<contact typeContact="openContact" contactVariableName="Valve_Command&lt;&gt;Valve_CommandOld"></contact>
						<shortCircuit>
							<VLink></VLink>
							<HLink nbCells="3"></HLink>
						</shortCircuit>
						<HLink nbCells="2"></HLink>
						<contact typeContact="openContact" contactVariableName="Valve_Command=1"></contact>
						<HLink nbCells="2"></HLink>
						<contact typeContact="openContact" contactVariableName="Valve_CommandOld=2"></contact>
						<shortCircuit>
							<VLink></VLink>
							<HLink nbCells="3"></HLink>
						</shortCircuit>
						<emptyCell nbCells="3"></emptyCell>
					</typeLine>
					<typeLine>
						<emptyCell nbCells="8"></emptyCell>
						<HLink nbCells="2"></HLink>
						<contact typeContact="openContact" contactVariableName="Valve_Command=2"></contact>
						<HLink nbCells="2"></HLink>
						<contact typeContact="openContact" contactVariableName="Valve_CommandOld=1"></contact>
						<shortCircuit>
							<VLink></VLink>
							<HLink nbCells="3"></HLink>
						</shortCircuit>
						<emptyCell nbCells="3"></emptyCell>
					</typeLine>
					<typeLine>
						<HLink nbCells="1"></HLink>
						<contact typeContact="openContact" contactVariableName="ManualActive"></contact>
						<HLink nbCells="2"></HLink>
						<contact typeContact="openContact" contactVariableName="ManInputCommand&lt;&gt;ManualOld"></contact>
						<HLink nbCells="2"></HLink>
						<shortCircuit>
							<VLink></VLink>
							<contact typeContact="closedContact" contactVariableName="testPush"></contact>
						</shortCircuit>
						<HLink nbCells="2"></HLink>
						<contact typeContact="openContact" contactVariableName="ManInputCommand=1"></contact>
						<HLink nbCells="2"></HLink>
						<contact typeContact="openContact" contactVariableName="ManualOld=2"></contact>
						<shortCircuit>
							<VLink></VLink>
							<HLink nbCells="3"></HLink>
						</shortCircuit>
						<coil typeCoil="setCoil" coilVariableName="LongWay"></coil>
						<HLink nbCells="2"></HLink>
					</typeLine>
					<typeLine>
						<emptyCell nbCells="7"></emptyCell>
						<VLink></VLink>
						<HLink nbCells="2"></HLink>
						<contact typeContact="openContact" contactVariableName="ManInputCommand=2"></contact>
						<HLink nbCells="2"></HLink>
						<contact typeContact="openContact" contactVariableName="ManualOld=1"></contact>
						<HLink nbCells="3"></HLink>
						<emptyCell nbCells="3"></emptyCell>
					</typeLine>
					<typeLine>
						<emptyCell nbCells="7"></emptyCell>
						<VLink></VLink>
						<HLink nbCells="2"></HLink>
						<contact typeContact="openContact" contactVariableName="ManInputCommand=1"></contact>
						<shortCircuit>
							<VLink></VLink>
							<HLink nbCells="2"></HLink>
						</shortCircuit>
						<contact typeContact="openContact" contactVariableName="ManualOld=3"></contact>
						<shortCircuit>
							<VLink></VLink>
							<HLink nbCells="3"></HLink>
						</shortCircuit>
						<coil typeCoil="setCoil" coilVariableName="ShortWay"></coil>
						<HLink nbCells="2"></HLink>
					</typeLine>
					<typeLine>
						<emptyCell nbCells="7"></emptyCell>
						<VLink></VLink>
						<HLink nbCells="2"></HLink>
						<contact typeContact="openContact" contactVariableName="ManInputCommand=2"></contact>
						<HLink nbCells="2"></HLink>
						<VLink></VLink>
						<HLink nbCells="1"></HLink>
						<contact typeContact="openContact" contactVariableName="ManualOld=1"></contact>
						<shortCircuit>
							<VLink></VLink>
							<HLink nbCells="1"></HLink>
						</shortCircuit>
						<emptyCell nbCells="3"></emptyCell>
					</typeLine>
					<typeLine>
						<emptyCell nbCells="8"></emptyCell>
						<HLink nbCells="2"></HLink>
						<contact typeContact="openContact" contactVariableName="ManInputCommand=3"></contact>
						<HLink nbCells="4"></HLink>
						<contact typeContact="openContact" contactVariableName="ManualOld=2"></contact>
						<shortCircuit>
							<VLink></VLink>
							<HLink nbCells="1"></HLink>
						</shortCircuit>
						<emptyCell nbCells="3"></emptyCell>
					</typeLine>
					<typeLine>
						<HLink nbCells="1"></HLink>
						<contact typeContact="closedContact" contactVariableName="ManualActive"></contact>
						<HLink nbCells="2"></HLink>
						<contact typeContact="openContact" contactVariableName="Valve_Command&lt;&gt;Valve_CommandOld"></contact>
						<shortCircuit>
							<VLink></VLink>
							<HLink nbCells="3"></HLink>
						</shortCircuit>
						<HLink nbCells="2"></HLink>
						<contact typeContact="openContact" contactVariableName="Valve_Command=1"></contact>
						<shortCircuit>
							<VLink></VLink>
							<HLink nbCells="2"></HLink>
						</shortCircuit>
						<contact typeContact="openContact" contactVariableName="Valve_CommandOld=3"></contact>
						<shortCircuit>
							<VLink></VLink>
							<HLink nbCells="3"></HLink>
						</shortCircuit>
						<emptyCell nbCells="3"></emptyCell>
					</typeLine>
					<typeLine>
						<emptyCell nbCells="7"></emptyCell>
						<VLink></VLink>
						<HLink nbCells="2"></HLink>
						<contact typeContact="openContact" contactVariableName="Valve_Command=2"></contact>
						<HLink nbCells="2"></HLink>
						<VLink></VLink>
						<HLink nbCells="1"></HLink>
						<contact typeContact="openContact" contactVariableName="Valve_CommandOld=1"></contact>
						<shortCircuit>
							<VLink></VLink>
							<HLink nbCells="1"></HLink>
						</shortCircuit>
						<emptyCell nbCells="3"></emptyCell>
					</typeLine>
					<typeLine>
						<emptyCell nbCells="8"></emptyCell>
						<HLink nbCells="2"></HLink>
						<contact typeContact="openContact" contactVariableName="Valve_Command=3"></contact>
						<HLink nbCells="4"></HLink>
						<contact typeContact="openContact" contactVariableName="Valve_CommandOld=2"></contact>
						<HLink nbCells="1"></HLink>
						<emptyCell nbCells="3"></emptyCell>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="1"></emptyLine>
					</typeLine>
					<typeLine>
						<HLink nbCells="16"></HLink>
						<operateBlock width="4">
							<statement>MaxControlTime:=Parameters.MonitorTime;</statement>
						</operateBlock>
					</typeLine>
					<typeLine>
						<HLink nbCells="2"></HLink>
						<contact typeContact="openContact" contactVariableName="shortWay"></contact>
						<HLink nbCells="1"></HLink>
						<contact typeContact="closedContact" contactVariableName="Test"></contact>
						<HLink nbCells="11"></HLink>
						<operateBlock width="4">
							<statement>MaxControlTime:=(Parameters.MonitorTime/2);</statement>
						</operateBlock>
					</typeLine>
					<typeLine>
						<HLink nbCells="2"></HLink>
						<contact typeContact="openContact" contactVariableName="Test"></contact>
						<HLink nbCells="13"></HLink>
						<operateBlock width="4">
							<statement>MaxControlTime:=t#200ms;</statement>
						</operateBlock>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="1"></emptyLine>
					</typeLine>
					<typeLine>
						<HLink nbCells="5"></HLink>
						<contact typeContact="PContact" contactVariableName="Outputs.Output_Left"></contact>
						<shortCircuit>
							<VLink></VLink>
							<HLink nbCells="1"></HLink>
						</shortCircuit>
