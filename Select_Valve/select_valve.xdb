					<textBox width="6" height="1">Bitje hoog zetten zodra motor gestart wordt<objPosition posX="0" posY="138"></objPosition>
					</textBox>
					<textBox width="6" height="1">Motor is gestart, maar na een seconde is er nog geen schakelaar weg gevallen<objPosition posX="0" posY="142"></objPosition>
					</textBox>
					<textBox width="4" height="1">Dit Alarm is alleen te resetten als de klep met de hand in 1 van de eindschakelaars gezet is
    <objPosition posX="0" posY="112"></objPosition>
					</textBox>
					<textBox width="4" height="1">Motor Aansturen
    <objPosition posX="0" posY="98"></objPosition>
					</textBox>
					<textBox width="15" height="1">Bitjes zetten als de klep in een positie is gekomen
    <objPosition posX="0" posY="67"></objPosition>
					</textBox>
					<textBox width="4" height="1">Commando waar de klep heen moet
    <objPosition posX="0" posY="83"></objPosition>
					</textBox>
					<textBox width="4" height="1">Huidige stand overnemen als hij in Manual gezet word
    <objPosition posX="0" posY="38"></objPosition>
					</textBox>
					<textBox width="4" height="1">Als de klep in manual gezet word Huidig stand naar de manual knoppen kopieren<objPosition posX="0" posY="37"></objPosition>
					</textBox>
					<textBox width="8" height="1">Bitje zetten voor de lengte van de beweging. Dus lang is van kant tot kant, kort is van kant to midden, of van midden tot kant. Dit voor tijd metingen, en eventueel voor tijd bewaking klep<objPosition posX="0" posY="4"></objPosition>
					</textBox>
					<textBox width="11" height="1">Reset alarms
    <objPosition posX="0" posY="0"></objPosition>
					</textBox>
					<textBox width="6" height="1">Zodra de motor gestart is, moet er een eindschakelaar weg vallen,<objPosition posX="0" posY="130"></objPosition>
					</textBox>
					<textBox width="4" height="1">Als via Manual de klep bediend word, maar hij staat niet in een positie, het commando negeren
    <objPosition posX="0" posY="52"></objPosition>
					</textBox>
					<textBox width="4" height="1">Duurt telang voordat de klep in position is
    <objPosition posX="16" posY="112"></objPosition>
					</textBox>
					<textBox width="11" height="1">Set buzzer when an alarm comes up. the buzzer can be reset by pressing reset
    <objPosition posX="0" posY="176"></objPosition>
					</textBox>
					<textBox width="4" height="1">Klep draait verkeerde kant op?
    <objPosition posX="16" posY="126"></objPosition>
					</textBox>
					<textBox width="4" height="1">Zodra een command komt, gaat de monitor tijd lopen
    <objPosition posX="0" posY="56"></objPosition>
					</textBox>
					<textBox width="4" height="1">Bitje hoog setten , als de klep in een positie staat
    <objPosition posX="0" posY="30"></objPosition>
					</textBox>
					<textBox width="4" height="1">verkeerde eindschakelaar komt binnen, motor draait verkeerd<objPosition posX="0" posY="126"></objPosition>
					</textBox>
				</networkLD>
			</LDSource>
		</FBProgram>
		<FBProgram name="Alarms" activationCondition="InternAlarm" logicCondition="standard">
			<STSource>


TestStr0 := CONCAT_STR(MainTxt, ' - Failure');
TestStr1 := CONCAT_STR(MainTxt, ' - Wrong Direction');
TestStr2 := CONCAT_STR(MainTxt, ' - Not moving');
TestStr3 := CONCAT_STR(MainTxt, ' - Lost limitswitch Left');
TestStr4 := CONCAT_STR(MainTxt, ' - Lost limitswitch Right');
TestStr5 := CONCAT_STR(MainTxt, ' - Lost limitswitch Middle');
TestStr6 := CONCAT_STR(MainTxt, ' - bit 6');
TestStr7 := CONCAT_STR(MainTxt, ' - bit 7');
TestStr8 := CONCAT_STR(MainTxt, ' - bit 8');
TestStr9 := CONCAT_STR(MainTxt, ' - bit 9');
TestStr10 := CONCAT_STR(MainTxt, ' - bit 10');
TestStr11 := CONCAT_STR(MainTxt, ' - bit 11');
TestStr12 := CONCAT_STR(MainTxt, ' - bit 12');
TestStr13 := CONCAT_STR(MainTxt, ' - bit 13');
TestStr14 := CONCAT_STR(MainTxt, ' - Warning 1');
TestStr15 := CONCAT_STR(MainTxt, ' - Warning 2');

TON_Run (IN := %s12, PT := t#1000ms);

if Ton_Run.q then
	(* Bit 0 - Failure *)
	IF Outputs.Alarms.Alarm_bit0 AND ErrId_0 = 0 THEN
	    UREGDFB(AREA:=AREA_NR, CLAS:=16#0062, SLEN:=0, CTRL:=OP_CTRL,
	            UTXT:=TestStr0, RSEL:=1, PIN:=0, VALPIN:=0,
	            ESTS=&gt;Status_0, ERID=&gt;ErrId_0, STAT=&gt;%SW76);
	ELSIF NOT Outputs.Alarms.Alarm_bit0 AND ErrId_0 &lt;&gt; 0 THEN
	    %SW77 := DEREG(ErrId_0);
	    IF %SW77 = 0 THEN ErrId_0 := 0; END_IF;
	END_IF;

	(* Bit 1 - Wrong direction *)
	IF Outputs.Alarms.Alarm_bit1 AND ErrId_1 = 0 THEN
	    UREGDFB(AREA:=AREA_NR, CLAS:=16#0062, SLEN:=0, CTRL:=OP_CTRL,
	            UTXT:=TestStr1, RSEL:=1, PIN:=0, VALPIN:=0,
	            ESTS=&gt;Status_1, ERID=&gt;ErrId_1, STAT=&gt;%SW76);
	ELSIF NOT Outputs.Alarms.Alarm_bit1 AND ErrId_1 &lt;&gt; 0 THEN
	    %SW77 := DEREG(ErrId_1);
	    IF %SW77 = 0 THEN ErrId_1 := 0;  END_IF;
	END_IF;

	(* Bit 2 - Not moving *)
	IF Outputs.Alarms.Alarm_bit2 AND ErrId_2 = 0 THEN
	    UREGDFB(AREA:=AREA_NR, CLAS:=16#0062, SLEN:=0, CTRL:=OP_CTRL,
	            UTXT:=TestStr2, RSEL:=1, PIN:=0, VALPIN:=0,
	            ESTS=&gt;Status_2, ERID=&gt;ErrId_2, STAT=&gt;%SW76);
	ELSIF NOT Outputs.Alarms.Alarm_bit2 AND ErrId_2 &lt;&gt; 0 THEN
	    %SW77 := DEREG(ErrId_2);
	    IF %SW77 = 0 THEN ErrId_2 := 0; END_IF;
	END_IF;

	(* Bit 3 - Lost Left Switch *)
	IF Outputs.Alarms.Alarm_bit3 AND ErrId_3 = 0 THEN
	    UREGDFB(AREA:=AREA_NR, CLAS:=16#0062, SLEN:=0, CTRL:=OP_CTRL,
	            UTXT:=TestStr3, RSEL:=1, PIN:=0, VALPIN:=0,
	            ESTS=&gt;Status_3, ERID=&gt;ErrId_3, STAT=&gt;%SW76);
	ELSIF NOT Outputs.Alarms.Alarm_bit3 AND ErrId_3 &lt;&gt; 0 THEN
	    %SW77 := DEREG(ErrId_3);
	    IF %SW77 = 0 THEN ErrId_3 := 0; END_IF;
	END_IF;

	(* Bit 4 - Lost Right Switch *)
	IF Outputs.Alarms.Alarm_bit4 AND ErrId_4 = 0 THEN
	    UREGDFB(AREA:=AREA_NR, CLAS:=16#0062, SLEN:=0, CTRL:=OP_CTRL,
	            UTXT:=TestStr4, RSEL:=1, PIN:=0, VALPIN:=0,
	            ESTS=&gt;Status_4, ERID=&gt;ErrId_4, STAT=&gt;%SW76);
	ELSIF NOT Outputs.Alarms.Alarm_bit4 AND ErrId_4 &lt;&gt; 0 THEN
	    %SW77 := DEREG(ErrId_4);
	    IF %SW77 = 0 THEN ErrId_4 := 0;  END_IF;
	END_IF;

	(* Bit 5 - Lost Middle Switch  *)
	IF Outputs.Alarms.Alarm_bit5 AND ErrId_5 = 0 THEN
	    UREGDFB(AREA:=AREA_NR, CLAS:=16#0062, SLEN:=0, CTRL:=OP_CTRL,
	            UTXT:=TestStr5, RSEL:=1, PIN:=0, VALPIN:=0,
	            ESTS=&gt;Status_5, ERID=&gt;ErrId_5, STAT=&gt;%SW76);
	ELSIF NOT Outputs.Alarms.Alarm_bit5 AND ErrId_5 &lt;&gt; 0 THEN
	    %SW77 := DEREG(ErrId_5);
	    IF %SW77 = 0 THEN ErrId_5 := 0;  END_IF;
	END_IF;

	(* Bit 6 - res *)
	IF Outputs.Alarms.Alarm_bit6 AND ErrId_6 = 0 THEN
	    UREGDFB(AREA:=AREA_NR, CLAS:=16#0062, SLEN:=0, CTRL:=OP_CTRL,
	            UTXT:=TestStr6, RSEL:=1, PIN:=0, VALPIN:=0,
	            ESTS=&gt;Status_6, ERID=&gt;ErrId_6, STAT=&gt;%SW76);
	ELSIF NOT Outputs.Alarms.Alarm_bit0 AND ErrId_6 &lt;&gt; 0 THEN
	    %SW77 := DEREG(ErrId_6);
	    IF %SW77 = 0 THEN ErrId_6 := 0;  END_IF;
	END_IF;

	(* Bit 7 - res *)
	IF Outputs.Alarms.Alarm_bit7 AND ErrId_7 = 0 THEN
	    UREGDFB(AREA:=AREA_NR, CLAS:=16#0062, SLEN:=0, CTRL:=OP_CTRL,
	            UTXT:=TestStr7, RSEL:=1, PIN:=0, VALPIN:=0,
	            ESTS=&gt;Status_7, ERID=&gt;ErrId_7, STAT=&gt;%SW76);
	ELSIF NOT Outputs.Alarms.Alarm_bit7 AND ErrId_7 &lt;&gt; 0 THEN
	    %SW77 := DEREG(ErrId_7);
	    IF %SW77 = 0 THEN ErrId_7 := 0;  END_IF;
	END_IF;

	(* Bit 8 - res *)
	IF Outputs.Alarms.Alarm_bit8 AND ErrId_8 = 0 THEN
	    UREGDFB(AREA:=AREA_NR, CLAS:=16#0062, SLEN:=0, CTRL:=OP_CTRL,
	            UTXT:=TestStr8, RSEL:=1, PIN:=0, VALPIN:=0,
	            ESTS=&gt;Status_8, ERID=&gt;ErrId_8, STAT=&gt;%SW76);
	ELSIF NOT Outputs.Alarms.Alarm_bit8 AND ErrId_8 &lt;&gt; 0 THEN
	    %SW77 := DEREG(ErrId_8);
	    IF %SW77 = 0 THEN ErrId_8 := 0; END_IF;
	END_IF;

	(* Bit 9 - res *)
	IF Outputs.Alarms.Alarm_bit9 AND ErrId_9 = 0 THEN
	    UREGDFB(AREA:=AREA_NR, CLAS:=16#0062, SLEN:=0, CTRL:=OP_CTRL,
	            UTXT:=TestStr9, RSEL:=1, PIN:=0, VALPIN:=0,
	            ESTS=&gt;Status_9, ERID=&gt;ErrId_9, STAT=&gt;%SW76);
	ELSIF NOT Outputs.Alarms.Alarm_bit9 AND ErrId_9 &lt;&gt; 0 THEN
	    %SW77 := DEREG(ErrId_9);
	    IF %SW77 = 0 THEN ErrId_9 := 0;  END_IF;
	END_IF;

	(* Bit 10 - res *)
	IF Outputs.Alarms.Alarm_bit10 AND ErrId_10 = 0 THEN
	    UREGDFB(AREA:=AREA_NR, CLAS:=16#0062, SLEN:=0, CTRL:=OP_CTRL,
	            UTXT:=TestStr10, RSEL:=1, PIN:=0, VALPIN:=0,
	            ESTS=&gt;Status_10, ERID=&gt;ErrId_10, STAT=&gt;%SW76);
	ELSIF NOT Outputs.Alarms.Alarm_bit10 AND ErrId_10 &lt;&gt; 0 THEN
	    %SW77 := DEREG(ErrId_10);
	    IF %SW77 = 0 THEN ErrId_10 := 0;  END_IF;
	END_IF;

	(* Bit 11 - res *)
	IF Outputs.Alarms.Alarm_bit11 AND ErrId_11 = 0 THEN
	    UREGDFB(AREA:=AREA_NR, CLAS:=16#0062, SLEN:=0, CTRL:=OP_CTRL,
	            UTXT:=TestStr11, RSEL:=1, PIN:=0, VALPIN:=0,
	            ESTS=&gt;Status_11, ERID=&gt;ErrId_11, STAT=&gt;%SW76);
	ELSIF NOT Outputs.Alarms.Alarm_bit11 AND ErrId_11 &lt;&gt; 0 THEN
	    %SW77 := DEREG(ErrId_11);
	    IF %SW77 = 0 THEN ErrId_11 := 0;  END_IF;
	END_IF;

	(* Bit 12 - res *)
	IF Outputs.Alarms.Alarm_bit12 AND ErrId_12 = 0 THEN
	    UREGDFB(AREA:=AREA_NR, CLAS:=16#0062, SLEN:=0, CTRL:=OP_CTRL,
	            UTXT:=TestStr12, RSEL:=1, PIN:=0, VALPIN:=0,
	            ESTS=&gt;Status_12, ERID=&gt;ErrId_12, STAT=&gt;%SW76);
	ELSIF NOT Outputs.Alarms.Alarm_bit12 AND ErrId_12 &lt;&gt; 0 THEN
	    %SW77 := DEREG(ErrId_12);
	    IF %SW77 = 0 THEN ErrId_12 := 0;  END_IF;
	END_IF;

	(* Bit 13 - Spare *)
	IF Outputs.Alarms.Alarm_bit13 AND ErrId_13 = 0 THEN
	    UREGDFB(AREA:=AREA_NR, CLAS:=16#0062, SLEN:=0, CTRL:=OP_CTRL,
	            UTXT:=TestStr13, RSEL:=1, PIN:=0, VALPIN:=0,
	            ESTS=&gt;Status_13, ERID=&gt;ErrId_13, STAT=&gt;%SW76);
	ELSIF NOT Outputs.Alarms.Alarm_bit13 AND ErrId_13 &lt;&gt; 0 THEN
	    %SW77 := DEREG(ErrId_13);
	    IF %SW77 = 0 THEN ErrId_13 := 0;  END_IF;
	END_IF;

	(* Bit 14 - WARNING *)
	IF Outputs.Alarms.Alarm_bit14 AND ErrId_14 = 0 THEN
	    UREGDFB(AREA:=12, CLAS:=16#0062, SLEN:=0, CTRL:=0,
	            UTXT:=TestStr14, RSEL:=1, PIN:=0, VALPIN:=0,
	            ESTS=&gt;Status_14, ERID=&gt;ErrId_14, STAT=&gt;%SW76);
	ELSIF NOT Outputs.Alarms.Alarm_bit14 AND ErrId_14 &lt;&gt; 0 THEN
	    %SW77 := DEREG(ErrId_14);
	    IF %SW77 = 0 THEN ErrId_14 := 0;  END_IF;
	END_IF;

	(* Bit 15 - Warning *)
	IF Outputs.Alarms.Alarm_bit15 AND ErrId_15 = 0 THEN
	    UREGDFB(AREA:=12, CLAS:=16#0062, SLEN:=0, CTRL:=0,
	            UTXT:=TestStr15, RSEL:=1, PIN:=0, VALPIN:=0,
	            ESTS=&gt;Status_15, ERID=&gt;ErrId_15, STAT=&gt;%SW76);
	ELSIF NOT Outputs.Alarms.Alarm_bit15 AND ErrId_15 &lt;&gt; 0 THEN
	    %SW77 := DEREG(ErrId_15);
	    IF %SW77 = 0 THEN ErrId_15 := 0;  END_IF;
	END_IF;
End_if;
</STSource>
