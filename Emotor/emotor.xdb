		<FBProgram name="info">
			<STSource>(*														
(*	Dit is het eerste programma met de nieuwe alarmen.							*)
(*														*)
(*	Vroegur!: kwam er uit elke functie blok een alarmword, met daar in 16 bitjes voor de alarmen		*)
(*														*)
(*	dan op een andere plek in het programma werden deze bitjes aan Alrm_dia functie's gekoppeld om 		*)
(*	de alarm teksten op de HMIs te krijgen.									*)
(*														*)
(*	Dit omdat een Alrm_dia niet in een eigen function blok mocht, en omdat de alarm teskst via de 		*)
(*	Comments mee gegeven moest worden.									*)
(*														*)
(*	Later ondekte ik de UREGDFB diag function block , die kan dus ipv een Alarm tekst van uit de 		*)
(*	Comments ook met een String variabele werken.								*)
(*														*)
(*	Later ontdekte ik, als je bij de properties van een function Block  het vinkje Diag aan zet		*)
(*	je WEL diagnostic functies in je eigen function blok kan zetten.					*)
(*														*)
(*	Dit scheelt zoveel werk. Want nu kan je de Alarmen in de functieblokken zelf stoppen. 			*)


(*														*)
(*  	This is the first program with the new alarms.								*)
(*														*)
(*  	Previously: each function block returned an alarm word,							*)
(*  	containing 16 bits for the alarms.									*)
(*														*)
(*  	These bits were then linked to Alrm_dia functions elsewhere						*)
(*  	in the program, in order to display the alarm texts on the HMIs.					*)
(*														*)
(*  	This was necessary because an Alrm_dia was not allowed inside						*)
(*  	a function block, and because the alarm text had to be passed						*)
(*  	via the Comments field.											*)
(*														*)
(*  	Later I discovered the UREGDFB diagnostic function block, which						*)
(*  	can work with a String variable instead of an alarm text						*)
(*  	from the Comments field.										*)
(*														*)
(*  	Later I discovered that if you enable the Diag checkbox in the						*)
(*  	properties of a function block, you CAN place diagnostic						*)
(*  	functions inside your own function block.								*)
(*														*)
(*  	This saves a lot of work, because now you can put the alarms						*)
(*  	directly inside the function blocks themselves.								*)
</STSource>
		</FBProgram>
		<FBProgram name="ExtraForAlarms">
			<STSource>
(* Only if there is a outside TXT use the Intern Alarms *)
InternAlarm:=false;

if MainTxt&lt;&gt;'' then
	InternAlarm:=true;
end_if;
</STSource>
		</FBProgram>
		<FBProgram name="OneButtunStartStop">
			<STSource>
tmpStartstop:=InOut.Data.PulsOnOff;

if re(tmpStartStop) then

boolPulsOnOff:=BoolPulsOnOff xor 1;

	if startRow[0]=EmotNr or eMotorInWait then
		InOut.Data.Stop:=true;
		InOut.Data.PulsOnOff:=false;
	end_if;
end_if;
</STSource>
		</FBProgram>
		<FBProgram name="ShiftStartArrayUp">
			<STSource>(* 
zodra op start gedrukt word, het motor nummer onderaan in de wacht lijst zetten...
en daarna worden de nummers omhoog geschoven, de motor op plek 0 word gestart

wel eerst even kijken of de motor al niet in de lijst staat....

*)


abort:=false;

tmpStart:=InOut.Data.Start or ( InOut.Data.PulsOnOff and not (inputs.running or starting));

if re(tmpStart) then


	for T:=30 to 1 by -1 do   (* motor staat al in de lijst, dus exit*)
		if startRow[T]=EmotNr then
			abort:=true;;
		end_if;
	end_for;

	if abort=false then
		startRow[30]:=EmotNr;

		for T:=30 to 1 by -1 do
			if startRow[T-1]=0 then
				startRow[T-1]:=startRow[T];
				startRow[T]:=0;
			end_if;
		end_for;
	end_if;
end_If;
</STSource>
		</FBProgram>
		<FBProgram name="EmotIsInList">
			<STSource>
(*Kijken of deze motor in de wacht rij staat*)


eMotorInWait:=False;

for T:=30 to 1 by -1 do
	if startRow[T]=EmotNr then
		eMotorInWait:=true;
	end_if;
end_for;
</STSource>
		</FBProgram>
		<FBProgram name="AbortEmot">
			<STSource>
(* they press stop while the motor was starting, reset some bits *)

if startRow[0]=EmotNr and (InOut.Data.Stop or InOut.Data.Alarm) then
	starting:=false;
	General.NextStartDelayTime:=0;
end_if;

(* this motor is waiting for start, or is busy with starting  , 
and they press stop, or there is a alarm
, so delete this motor from the startlist, and move the other waiting motors up *)

if (eMotorInWait=true or startRow[0]=EmotNr) and (InOut.Data.Stop or InOut.Data.Alarm) then
	for List:=0 to 30 by 1 do
		 if startRow[List]=EmotNr then
		 	
		         for List2:=List to 29 by 1 do
				startRow[List2]:=startRow[List2+1];
			end_for;
		end_if;
	end_for;
end_if;
</STSource>
		</FBProgram>
