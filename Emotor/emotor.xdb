						<contact typeContact="openContact" contactVariableName="InOut.Data.PulsOnOff"></contact>
						<HLink nbCells="16"></HLink>
						<coil typeCoil="resetCoil" coilVariableName="InOut.Data.PulsOnOff"></coil>
						<HLink nbCells="1"></HLink>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="1"></emptyLine>
					</typeLine>
					<textBox width="11" height="1">FireSwitch<objPosition posX="0" posY="105"></objPosition>
					</textBox>
					<textBox width="11" height="1">Hold other motor to start for x sec
    <objPosition posX="0" posY="44"></objPosition>
					</textBox>
					<textBox width="11" height="1">Statusses
    <objPosition posX="0" posY="131"></objPosition>
					</textBox>
					<textBox width="11" height="1">Start Pulse from HMI control
    <objPosition posX="0" posY="11"></objPosition>
					</textBox>
					<textBox width="11" height="1">Set buzzer when an alarm comes up. the buzzer can be reset by pressing reset
don't set buzzer by bit 12,13,14 &amp;15 (are warnings)<objPosition posX="0" posY="159"></objPosition>
					</textBox>
					<textBox width="11" height="1">Reset tmp Starting bit Started when running<objPosition posX="0" posY="108"></objPosition>
					</textBox>
					<textBox width="11" height="1">Reset tmp Stopping bit when stopped<objPosition posX="0" posY="111"></objPosition>
					</textBox>
					<textBox width="5" height="1">Start/Stop pulsen aan sturen
    <objPosition posX="0" posY="27"></objPosition>
					</textBox>
					<textBox width="11" height="1">General Alarm
    <objPosition posX="0" posY="48"></objPosition>
					</textBox>
					<textBox width="11" height="1">Not stopped in time<objPosition posX="0" posY="73"></objPosition>
					</textBox>
					<textBox width="11" height="1">Reset alarms
    <objPosition posX="0" posY="3"></objPosition>
					</textBox>
					<textBox width="7" height="1">op start gedrukt, terwijl een andere motor aan het starten is, dus even wachten
    <objPosition posX="0" posY="12"></objPosition>
					</textBox>
					<textBox width="4" height="1">Groen/Green = Running
    <objPosition posX="16" posY="136"></objPosition>
					</textBox>
					<textBox width="5" height="1">1 Output aan zetten zolang de motor draaien moet
    <objPosition posX="0" posY="37"></objPosition>
					</textBox>
					<textBox width="11" height="1">Main Switch<objPosition posX="0" posY="90"></objPosition>
					</textBox>
					<textBox width="11" height="1">Lost run, while plc don't give stop command<objPosition posX="0" posY="97"></objPosition>
					</textBox>
					<textBox width="11" height="1">Reset start/stop command from HMI
    <objPosition posX="0" posY="165"></objPosition>
					</textBox>
					<textBox width="4" height="1">Grijs /grey = off
    <objPosition posX="16" posY="132"></objPosition>
					</textBox>
					<textBox width="11" height="1">Not started in time
    <objPosition posX="0" posY="54"></objPosition>
					</textBox>
					<textBox width="4" height="1">donker blauw/Dark blue  = wait on PMS
    <objPosition posX="16" posY="144"></objPosition>
					</textBox>
					<textBox width="11" height="1">Echte outputjes aansturen
    <objPosition posX="0" posY="22"></objPosition>
					</textBox>
					<textBox width="4" height="1">Licht blauw/Light blue  =  Motor is starting
    <objPosition posX="16" posY="151"></objPosition>
					</textBox>
					<textBox width="11" height="1">Warning active
    <objPosition posX="0" posY="117"></objPosition>
					</textBox>
					<textBox width="11" height="1">Filter out  bits 14 &amp; 15, because they are warnings<objPosition posX="0" posY="155"></objPosition>
					</textBox>
					<textBox width="11" height="1">Start request fout, of stoppen
    <objPosition posX="0" posY="80"></objPosition>
					</textBox>
					<textBox width="11" height="1">Running Hours
    <objPosition posX="0" posY="120"></objPosition>
					</textBox>
					<textBox width="11" height="1">Init
    <objPosition posX="0" posY="6"></objPosition>
					</textBox>
					<textBox width="4" height="1">Geel/yellow  Wait for other motors
    <objPosition posX="16" posY="140"></objPosition>
					</textBox>
					<textBox width="4" height="1">Oranje/orange = warning
    <objPosition posX="16" posY="148"></objPosition>
					</textBox>
					<textBox width="4" height="1">Rood/Red  =  Alarm
    <objPosition posX="16" posY="158"></objPosition>
					</textBox>
				</networkLD>
			</LDSource>
		</FBProgram>
		<FBProgram name="EmotIsStarted">
			<STSource>

(* Motor Op eerste plaats in de wachtrij is gestart, dus wissen, en de rest van de rij omhoog schuiven*)


if EmotNr=startRow[0] and InOut.Data.Running and General.NextStartDelayTime=0  then


	for T:=1 to 30 by 1 do
		 startRow[T-1]:=startRow[T];
	end_for;
end_if;
</STSource>
		</FBProgram>
		<FBProgram name="Alarms" activationCondition="InternAlarm" logicCondition="standard">
			<STSource>(*	hier word de MainTxt , welke buiten het functieblok ingevuld word, in de ondestaande alarmteksten gezet		*)
(*															*)
(*	Alarm teksten zitten nu dus in het motor starter programma, en hoeven dus niet meer telkens ingetypt te worden	*)
(*	het Alarm woord word nog wel naar buiten gebracht, om eventueel ergens anders iets tegen te kunnen houden bij	*)
(*	een bepaald alarm												*)
(*	Word alleen uitgevoerd als er aan de buitenkant een tekst ingevuld is						*)


TestStr0 := CONCAT_STR(MainTxt, ' - General alarm');
TestStr1 := CONCAT_STR(MainTxt, ' - Failed to start');
TestStr2 := CONCAT_STR(MainTxt, ' - Failed to stop');
TestStr3 := CONCAT_STR(MainTxt, ' - Lost Run');
TestStr4 := CONCAT_STR(MainTxt, ' - Safety switch');
TestStr5 := CONCAT_STR(MainTxt, ' - Main switch');
TestStr6 := CONCAT_STR(MainTxt, ' - Tripped');
TestStr7 := CONCAT_STR(MainTxt, ' - No power available');
TestStr8 := CONCAT_STR(MainTxt, ' - VFD Fault');
TestStr9 := CONCAT_STR(MainTxt, ' - Softst. Fault');
TestStr10 := CONCAT_STR(MainTxt, ' - Safety valve');
TestStr11 := CONCAT_STR(MainTxt, ' - Local Control');
TestStr12 := CONCAT_STR(MainTxt, ' - Fire Switch');
TestStr13 := CONCAT_STR(MainTxt, ' - Low Pressure');
TestStr14 := CONCAT_STR(MainTxt, ' - Warning1');
TestStr15 := CONCAT_STR(MainTxt, ' - Warning2');

TON_Run (IN := %s12, PT := t#1000ms);

if Ton_Run.q then

	(* Testbitje, als hij knippert, word dit stuk code doorlopen *)
	testBit:=testBit xor 1;

	(* Bit 0 - General alarm *)
	IF Outputs.Alarms.Alarm_bit0 AND ErrId_0 = 0 THEN
	    UREGDFB(AREA:=AREA_NR, CLAS:=16#0062, SLEN:=0, CTRL:=OP_CTRL,
	            UTXT:=TestStr0, RSEL:=1, PIN:=0, VALPIN:=0,
	            ESTS=&gt;Status_0, ERID=&gt;ErrId_0, STAT=&gt;%SW76);
	ELSIF NOT Outputs.Alarms.Alarm_bit0 AND ErrId_0 &lt;&gt; 0 THEN
	    %SW77 := DEREG(ErrId_0);
	    IF %SW77 = 0 THEN ErrId_0 := 0; END_IF;
	END_IF;

	(* Bit 1 - Failed to start *)
	IF Outputs.Alarms.Alarm_bit1 AND ErrId_1 = 0 THEN
	    UREGDFB(AREA:=AREA_NR, CLAS:=16#0062, SLEN:=0, CTRL:=OP_CTRL,
	            UTXT:=TestStr1, RSEL:=1, PIN:=0, VALPIN:=0,
	            ESTS=&gt;Status_1, ERID=&gt;ErrId_1, STAT=&gt;%SW76);
	ELSIF NOT Outputs.Alarms.Alarm_bit1 AND ErrId_1 &lt;&gt; 0 THEN
	    %SW77 := DEREG(ErrId_1);
	    IF %SW77 = 0 THEN ErrId_1 := 0; END_IF;
	END_IF;

	(* Bit 2 - Failed to stop *)
	IF Outputs.Alarms.Alarm_bit2 AND ErrId_2 = 0 THEN
	    UREGDFB(AREA:=AREA_NR, CLAS:=16#0062, SLEN:=0, CTRL:=OP_CTRL,
	            UTXT:=TestStr2, RSEL:=1, PIN:=0, VALPIN:=0,
	            ESTS=&gt;Status_2, ERID=&gt;ErrId_2, STAT=&gt;%SW76);
	ELSIF NOT Outputs.Alarms.Alarm_bit2 AND ErrId_2 &lt;&gt; 0 THEN
	    %SW77 := DEREG(ErrId_2);
	    IF %SW77 = 0 THEN ErrId_2 := 0; END_IF;
	END_IF;

	(* Bit 3 - Shutoff without stop *)
	IF Outputs.Alarms.Alarm_bit3 AND ErrId_3 = 0 THEN
	    UREGDFB(AREA:=AREA_NR, CLAS:=16#0062, SLEN:=0, CTRL:=OP_CTRL,
	            UTXT:=TestStr3, RSEL:=1, PIN:=0, VALPIN:=0,
	            ESTS=&gt;Status_3, ERID=&gt;ErrId_3, STAT=&gt;%SW76);
	ELSIF NOT Outputs.Alarms.Alarm_bit3 AND ErrId_3 &lt;&gt; 0 THEN
	    %SW77 := DEREG(ErrId_3);
	    IF %SW77 = 0 THEN ErrId_3 := 0; END_IF;
	END_IF;

	(* Bit 4 - Safety switch *)
	IF Outputs.Alarms.Alarm_bit4 AND ErrId_4 = 0 THEN
	    UREGDFB(AREA:=AREA_NR, CLAS:=16#0062, SLEN:=0, CTRL:=OP_CTRL,
	            UTXT:=TestStr4, RSEL:=1, PIN:=0, VALPIN:=0,
	            ESTS=&gt;Status_4, ERID=&gt;ErrId_4, STAT=&gt;%SW76);
	ELSIF NOT Outputs.Alarms.Alarm_bit4 AND ErrId_4 &lt;&gt; 0 THEN
	    %SW77 := DEREG(ErrId_4);
	    IF %SW77 = 0 THEN ErrId_4 := 0; END_IF;
	END_IF;

	(* Bit 5 - Main switch *)
	IF Outputs.Alarms.Alarm_bit5 AND ErrId_5 = 0 THEN
	    UREGDFB(AREA:=AREA_NR, CLAS:=16#0062, SLEN:=0, CTRL:=OP_CTRL,
	            UTXT:=TestStr5, RSEL:=1, PIN:=0, VALPIN:=0,
	            ESTS=&gt;Status_5, ERID=&gt;ErrId_5, STAT=&gt;%SW76);
	ELSIF NOT Outputs.Alarms.Alarm_bit5 AND ErrId_5 &lt;&gt; 0 THEN
	    %SW77 := DEREG(ErrId_5);
	    IF %SW77 = 0 THEN ErrId_5 := 0;  END_IF;
	END_IF;

	(* Bit 6 - Tripped *)
	IF Outputs.Alarms.Alarm_bit6 AND ErrId_6 = 0 THEN
	    UREGDFB(AREA:=AREA_NR, CLAS:=16#0062, SLEN:=0, CTRL:=OP_CTRL,
	            UTXT:=TestStr6, RSEL:=1, PIN:=0, VALPIN:=0,
	            ESTS=&gt;Status_6, ERID=&gt;ErrId_6, STAT=&gt;%SW76);
	ELSIF NOT Outputs.Alarms.Alarm_bit6 AND ErrId_6 &lt;&gt; 0 THEN
	    %SW77 := DEREG(ErrId_6);
	    IF %SW77 = 0 THEN ErrId_6 := 0; END_IF;
	END_IF;

	(* Bit 7 - No power available *)
	IF Outputs.Alarms.Alarm_bit7 AND ErrId_7 = 0 THEN
	    UREGDFB(AREA:=AREA_NR, CLAS:=16#0062, SLEN:=0, CTRL:=OP_CTRL,
	            UTXT:=TestStr7, RSEL:=1, PIN:=0, VALPIN:=0,
	            ESTS=&gt;Status_7, ERID=&gt;ErrId_7, STAT=&gt;%SW76);
	ELSIF NOT Outputs.Alarms.Alarm_bit7 AND ErrId_7 &lt;&gt; 0 THEN
	    %SW77 := DEREG(ErrId_7);
	    IF %SW77 = 0 THEN ErrId_7 := 0; END_IF;
	END_IF;

	(* Bit 8 - VFD Fault *)
	IF Outputs.Alarms.Alarm_bit8 AND ErrId_8 = 0 THEN
	    UREGDFB(AREA:=AREA_NR, CLAS:=16#0062, SLEN:=0, CTRL:=OP_CTRL,
	            UTXT:=TestStr8, RSEL:=1, PIN:=0, VALPIN:=0,
	            ESTS=&gt;Status_8, ERID=&gt;ErrId_8, STAT=&gt;%SW76);
	ELSIF NOT Outputs.Alarms.Alarm_bit8 AND ErrId_8 &lt;&gt; 0 THEN
	    %SW77 := DEREG(ErrId_8);
	    IF %SW77 = 0 THEN ErrId_8 := 0; END_IF;
	END_IF;

	(* Bit 9 - Softstarter Fault *)
	IF Outputs.Alarms.Alarm_bit9 AND ErrId_9 = 0 THEN
	    UREGDFB(AREA:=AREA_NR, CLAS:=16#0062, SLEN:=0, CTRL:=OP_CTRL,
	            UTXT:=TestStr9, RSEL:=1, PIN:=0, VALPIN:=0,
	            ESTS=&gt;Status_9, ERID=&gt;ErrId_9, STAT=&gt;%SW76);
	ELSIF NOT Outputs.Alarms.Alarm_bit9 AND ErrId_9 &lt;&gt; 0 THEN
	    %SW77 := DEREG(ErrId_9);
	    IF %SW77 = 0 THEN ErrId_9 := 0; END_IF;
	END_IF;

	(* Bit 10 - Safety valve *)
	IF Outputs.Alarms.Alarm_bit10 AND ErrId_10 = 0 THEN
	    UREGDFB(AREA:=AREA_NR, CLAS:=16#0062, SLEN:=0, CTRL:=OP_CTRL,
	            UTXT:=TestStr10, RSEL:=1, PIN:=0, VALPIN:=0,
	            ESTS=&gt;Status_10, ERID=&gt;ErrId_10, STAT=&gt;%SW76);
	ELSIF NOT Outputs.Alarms.Alarm_bit10 AND ErrId_10 &lt;&gt; 0 THEN
	    %SW77 := DEREG(ErrId_10);
	    IF %SW77 = 0 THEN ErrId_10 := 0; END_IF;
	END_IF;

	(* Bit 11 - Local Control *)
	IF Outputs.Alarms.Alarm_bit11 AND ErrId_11 = 0 THEN
	    UREGDFB(AREA:=AREA_NR, CLAS:=16#0062, SLEN:=0, CTRL:=OP_CTRL,
	            UTXT:=TestStr11, RSEL:=1, PIN:=0, VALPIN:=0,
	            ESTS=&gt;Status_11, ERID=&gt;ErrId_11, STAT=&gt;%SW76);
	ELSIF NOT Outputs.Alarms.Alarm_bit11 AND ErrId_11 &lt;&gt; 0 THEN
	    %SW77 := DEREG(ErrId_11);
	    IF %SW77 = 0 THEN ErrId_11 := 0; END_IF;
	END_IF;

	(* Bit 12 - Fire Switch *)
	IF Outputs.Alarms.Alarm_bit12 AND ErrId_12 = 0 THEN
	    UREGDFB(AREA:=AREA_NR, CLAS:=16#0062, SLEN:=0, CTRL:=OP_CTRL,
	            UTXT:=TestStr12, RSEL:=1, PIN:=0, VALPIN:=0,
	            ESTS=&gt;Status_12, ERID=&gt;ErrId_12, STAT=&gt;%SW76);
	ELSIF NOT Outputs.Alarms.Alarm_bit12 AND ErrId_12 &lt;&gt; 0 THEN
	    %SW77 := DEREG(ErrId_12);
	    IF %SW77 = 0 THEN ErrId_12 := 0;  END_IF;
	END_IF;

	(* Bit 13 - Spare *)
	IF Outputs.Alarms.Alarm_bit13 AND ErrId_13 = 0 THEN
	    UREGDFB(AREA:=AREA_NR, CLAS:=16#0062, SLEN:=0, CTRL:=OP_CTRL,
	            UTXT:=TestStr13, RSEL:=1, PIN:=0, VALPIN:=0,
	            ESTS=&gt;Status_13, ERID=&gt;ErrId_13, STAT=&gt;%SW76);
	ELSIF NOT Outputs.Alarms.Alarm_bit13 AND ErrId_13 &lt;&gt; 0 THEN
	    %SW77 := DEREG(ErrId_13);
	    IF %SW77 = 0 THEN ErrId_13 := 0;  END_IF;
	END_IF;

	(* Bit 14 - Local control - WARNING *)
	IF Outputs.Alarms.Alarm_bit14 AND ErrId_14 = 0 THEN
	    UREGDFB(AREA:=12, CLAS:=16#0062, SLEN:=0, CTRL:=0,
	            UTXT:=TestStr14, RSEL:=1, PIN:=0, VALPIN:=0,
	            ESTS=&gt;Status_14, ERID=&gt;ErrId_14, STAT=&gt;%SW76);
	ELSIF NOT Outputs.Alarms.Alarm_bit14 AND ErrId_14 &lt;&gt; 0 THEN
	    %SW77 := DEREG(ErrId_14);
	    IF %SW77 = 0 THEN ErrId_14 := 0; END_IF;
	END_IF;

	(* Bit 15 - Warning *)
	IF Outputs.Alarms.Alarm_bit15 AND ErrId_15 = 0 THEN
	    UREGDFB(AREA:=12, CLAS:=16#0062, SLEN:=0, CTRL:=0,
	            UTXT:=TestStr15, RSEL:=1, PIN:=0, VALPIN:=0,
	            ESTS=&gt;Status_15, ERID=&gt;ErrId_15, STAT=&gt;%SW76);
	ELSIF NOT Outputs.Alarms.Alarm_bit15 AND ErrId_15 &lt;&gt; 0 THEN
	    %SW77 := DEREG(ErrId_15);
	    IF %SW77 = 0 THEN ErrId_15 := 0; END_IF;
	END_IF;
end_if;
</STSource>
		</FBProgram>
	</FBSource>
