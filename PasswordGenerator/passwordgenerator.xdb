	<FBSource nameOfFBType="Random" version="0.02" dateTime="dt#2020-05-07-15:33:42">
		<comment>Generates a nearly random number between 1-10</comment>
		<attribute name="TypeCodeCheckSumString" value="AA43"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="6404"></attribute>
		<attribute name="TypeDataDicSubfieldsCount" value="2"></attribute>
		<inOutParameters>
			<variables name="random" typeName="UDINT">
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
		</inOutParameters>
		<FBProgram name="prg">
			<STSource>random := mod((7 * random), 11);
</STSource>
		</FBProgram>
