<FBExchangeFile>
	<fileHeader company="Schneider Automation" product="Control Expert V14.1 - 191122A" dateTime="date_and_time#2026-5-15-22:31:36" content="Function Block source file" DTDVersion="41"></fileHeader>
	<contentHeader name="Project" version="0.0.1728" dateTime="date_and_time#2026-5-15-23:19:52"></contentHeader>
	<FBSource nameOfFBType="PasswordGenerator" version="1.82" dateTime="dt#2025-08-15-15:16:23">
		<comment>Password voor Van Aalst</comment>
		<attribute name="TypeCodeCheckSumString" value="6A10"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="8757"></attribute>
		<attribute name="TypeDataDicSubfieldsCount" value="22"></attribute>
		<inputParameters>
			<variables name="Maal" typeName="INT">
				<attribute name="PositionPin" value="2"></attribute>
			</variables>
			<variables name="Aantal" typeName="INT">
				<attribute name="PositionPin" value="3"></attribute>
			</variables>
			<variables name="Vanaf" typeName="INT">
				<attribute name="PositionPin" value="4"></attribute>
			</variables>
			<variables name="PassWordNormal" typeName="STRING">
				<attribute name="PositionPin" value="5"></attribute>
			</variables>
			<variables name="ResetTime" typeName="TIME">
				<attribute name="PositionPin" value="7"></attribute>
			</variables>
			<variables name="ResetSpecialPW" typeName="BOOL">
				<attribute name="PositionPin" value="9"></attribute>
			</variables>
			<variables name="PassWordExtra" typeName="STRING">
				<attribute name="PositionPin" value="6"></attribute>
			</variables>
		</inputParameters>
		<inOutParameters>
			<variables name="hmi" typeName="SystemPassWord">
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
			<variables name="general" typeName="General">
				<attribute name="PositionPin" value="8"></attribute>
			</variables>
		</inOutParameters>
		<outputParameters>
			<variables name="SysPWOkay" typeName="BOOL">
				<attribute name="PositionPin" value="10"></attribute>
			</variables>
			<variables name="OprPWOkay" typeName="BOOL">
				<attribute name="PositionPin" value="11"></attribute>
			</variables>
			<variables name="OprPW2Okay" typeName="BOOL">
				<attribute name="PositionPin" value="12"></attribute>
			</variables>
			<variables name="ActSysPW" typeName="STRING">
				<attribute name="PositionPin" value="9"></attribute>
			</variables>
		</outputParameters>
		<privateLocalVariables>
			<variables name="getal1" typeName="UDINT"></variables>
			<variables name="dintPasswordTmp" typeName="DINT"></variables>
			<variables name="str_Passwordtmp" typeName="STRING"></variables>
			<variables name="lengte" typeName="INT"></variables>
			<variables name="strRandtmp" typeName="STRING"></variables>
			<variables name="strActRandom" typeName="STRING"></variables>
			<variables name="aantalKarakters" typeName="INT"></variables>
			<variables name="VanafKarakter" typeName="INT"></variables>
			<variables name="dintActRandom" typeName="DINT"></variables>
			<variables name="TON_ResetOprPW" typeName="TON"></variables>
			<variables name="TimeReset" typeName="BOOL"></variables>
			<variables name="Random_getal1" typeName="Random"></variables>
			<variables name="Random_getal2" typeName="Random"></variables>
			<variables name="Getal2" typeName="UDINT"></variables>
			<variables name="Random_getal3" typeName="Random"></variables>
			<variables name="Getal3" typeName="UDINT"></variables>
			<variables name="tmp1" typeName="DINT"></variables>
			<variables name="fout" typeName="EBOOL"></variables>
			<variables name="tussen1" typeName="UDINT"></variables>
			<variables name="tussen2" typeName="DWORD"></variables>
			<variables name="tussen3" typeName="DWORD"></variables>
			<variables name="tussen4" typeName="DWORD"></variables>
			<variables name="tussen5" typeName="DWORD"></variables>
			<variables name="tussen6" typeName="DWORD"></variables>
			<variables name="tussen7" typeName="UDINT"></variables>
			<variables name="Random_getal4" typeName="Random"></variables>
			<variables name="Getal4" typeName="UDINT"></variables>
			<variables name="Random_Getal5" typeName="Random"></variables>
			<variables name="Random_Getal6" typeName="Random"></variables>
			<variables name="Getal5" typeName="UDINT"></variables>
			<variables name="Getal6" typeName="UDINT"></variables>
			<variables name="InManualMode" typeName="EBOOL"></variables>
			<variables name="tmpResetSpecialPW" typeName="EBOOL"></variables>
		</privateLocalVariables>
		<FBProgram name="PasswordProgram">
			<STSource>


TON_ResetOprPW (IN := (((OprPWOkay or SysPWOkay) and not general.ScreenIsTouched) and not OprPW2Okay) ,PT := ResetTime,Q =&gt; TimeReset);

InManualMode:=General.W1B2;
tmpResetSpecialPW:=ResetSpecialPW;

if hmi.Reset or %s13 or TimeReset or general.ScreenIsChanged or (OprPW2Okay and (fe(InManualMode) or re(tmpResetSpecialPW))) then
	hmi.HmiID:=0;
	ActSysPW:='';
	hmi.HmiPassWord:='';

	OprPWOkay:=False;
	hmi.OperatorPWOkay:=False;

	SysPWOkay:=False;
	hmi.SystemPWOkay:=False;

	OprPW2Okay:=False;
	hmi.Operator2PWOkay:=False;

	hmi.Reset:=false;
end_if;


if hmi.HmiID=0 then
	hmi.HmiId:=dintActRandom;
end_if;



(* nieuwe password bepalen *)
dintPasswordTmp:=hmi.HmiID*int_to_dint(Maal);

(* String van het getal maken *)
str_Passwordtmp := DINT_TO_STRING (IN := dintPasswordTmp);

(* het goede stuk uit de string knippen *)
lengte:=len_int(str_Passwordtmp);
ActSysPW := MID_INT (IN := str_Passwordtmp,N := aantal,P := (lengte+1)-vanaf);


if ActSysPW=hmi.HmiPassWord then
	SysPWOkay:=true;
	hmi.SystemPWOkay:=true;
else
	SysPWOkay:=false;
	hmi.SystemPWOkay:=False;
end_if;


if PassWordNormal=hmi.HmiPassWord then
	OprPWOkay:=true;
	hmi.OperatorPWOkay:=true;
end_if;



if PassWordExtra=hmi.HmiPassWord then
	OprPW2Okay:=true;
	OprPWOkay:=true;
	hmi.Operator2PWOkay:=true;
(*	general.ManualMode:=true; *)
end_if;
</STSource>
		</FBProgram>
		<FBProgram name="RandomGenerator">
			<STSource>if %s13 then
	getal1:=5;
	getal2:=2;
	getal3:=7;
	getal4:=1;
	getal5:=8;
	getal6:=3;
end_if;


(* moeilijk verhaaltje om een random getal te genereren 					*)
(* Dit getal word zichtbaar gemaakt op het scherm als het PASSWORD ID				*)

again:

Random_getal1 (random := Getal1);
Random_getal2 (random := Getal2);
Random_getal3 (random := Getal3);
Random_getal4 (random := Getal4);
Random_Getal5 (random := Getal5);
Random_Getal6 (random := Getal6);

(* %sw18 is een continue teller in de PLC, deze begint te tellen zodra de PLC  aan is		*)
(* %sw50 zijn de seconde uit de klok   ss00							*)
(* %sw51 uren/minuten uit de klok  uumm								*)




tussen1:=Getal1+(Getal2*10)+(Getal3*100)+(Getal4*1000)+(Getal5*10000)+(Getal6*10000);
tussen2:=Udint_to_Dword(tussen1*2);
tussen3:=int_To_Dword(%sw50);
tussen4:=int_To_Dword(%sw51);
tussen5:=tussen2 xor tussen3 Xor tussen4;
tussen6:=int_to_Dword(%sw18);
tussen7:=Dword_To_Udint(tussen6 xor tussen5);
tmp1:=uDint_to_Dint(in := (tussen7*(getal1*getal2*getal5)));

fout:=%s18;

if fout then
	%s18:=0;
	jmp again;
end_if;


(*getal omzetten naar een string *)
strRandtmp := DINT_TO_STRING (IN := tmp1);

(* het goede stuk uit de string knippen*)


lengte:=len_int(strRandtmp);

aantalKarakters:=6;
VanafKarakter:=lengte-3;

strActRandom := MID_INT (IN := strRandtmp,N := aantalKarakters,P := (lengte+1)-VanafKarakter); 

dintActRandom:=String_To_Dint(strActRandom);
</STSource>
		</FBProgram>
	</FBSource>
